<?xml version="1.0" encoding="utf-8"?>
<Layers:LayerBase x:Class="VideoOS.UI.Common.WPF.Timeline.Control.TimelineArea.Layers.Controls.ControlsLayer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Layers="clr-namespace:VideoOS.UI.Common.WPF.Timeline.Control.TimelineArea.Layers" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls;assembly=VideoOS.Platform" xmlns:resources="clr-namespace:VideoOS.UI.Common.WPF.Timeline.Control.TimelineArea.resources" xmlns:resources2="clr-namespace:VideoOS.UI.Common.WPF.Timeline.Control.ControlsAreaUpper.Controls.resources" xmlns:converters="clr-namespace:VideoOS.UI.Common.WPF.Utils.Converters" Loaded="LayerBase_Loaded" xmlns:controls1="clr-namespace:VideoOS.UI.Common.WPF.Timeline.Control.TimelineArea.Layers.Controls">
  <Grid>
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Rectangle Name="_playheadLine" Width="2" SnapsToDevicePixels="True" UseLayoutRounding="True" Fill="{controls:VideoOSInternalDynamicResource TimelinePlayheadBackgroundBrush}" Margin="{Binding PlayheadLineMargin}" MouseRightButtonDown="_marker_MouseRightButtonDown" />
    <Grid ToolTip="{x:Static resources:Strings.SelectTimeContextMenuItemText}" Effect="{controls:VideoOSDynamicResource DropShadowEffect}">
      <Border Name="_playheadTextArea" CornerRadius="3" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{controls:VideoOSInternalDynamicResource TimelinePlayheadBackgroundBrush}" Height="{Binding PlayheadTextAreaHeight}" Visibility="{Binding PlayheadTextAreaVisibility}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="{Binding PlaybackControlsVisibility}">
            <controls:VideoOSButtonTransparentExtraSmall VerticalAlignment="Center" ToolTip="{x:Static resources2:Strings.TooltipNavigatePreviousButton}" IsEnabled="{Binding NavigationControlsEnabled}" IconSource="{controls:VideoOSIconBuiltInSource Frame_Previous, RtlIcon=Frame_Next}" Click="_navigatePreviousButton_Click" />
            <controls:VideoOSButtonTransparentExtraSmall VerticalAlignment="Center" ToolTip="{Binding PlaybackBackwardPauseState, Converter={converters:BoolConverter TrueValue={x:Static resources2:Strings.TooltipPlaybackPauseButton}, FalseValue={x:Static resources2:Strings.TooltipPlaybackBackwardButton}}}" Visibility="{Binding ShowPlaybackPlayPauseControls, Converter={StaticResource BooleanToVisibilityConverter}}" Click="_playbackBackwardButton_Click">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type controls:VideoOSButtonTransparentBase}">
                  <Setter Property="controls:VideoOSButtonBase.IconSource" Value="{controls:VideoOSIconBuiltInSource Play_Backward, RtlIcon=Play_Forward}" />
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding PlaybackBackwardPauseState}">
                      <Setter Property="controls:VideoOSButtonBase.IconSource" Value="{controls:VideoOSIconBuiltInSource Pause}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </controls:VideoOSButtonTransparentExtraSmall>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Cursor="Hand" Background="#00FFFFFF" AutomationProperties.AutomationId="_dateTimeTextBlock" MouseLeftButtonDown="_dateOrTimeTextBlock_MouseLeftButtonDown" MouseLeftButtonUp="_dateOrTimeTextBlock_MouseLeftButtonUp" MouseRightButtonDown="_dateOrTimeTextBlock_MouseRightButtonDown">
            <controls:VideoOSIcon Width="12" Height="12" VerticalAlignment="Center" Margin="4,0,0,0" IconSource="{controls:VideoOSIconBuiltInSource Time_Date_Select}" />
            <controls:VideoOSTextBlockInteractiveSmall Margin="6,0,4,0" VerticalAlignment="Center" AutomationProperties.AutomationId="_dateTimeTextBlockCurrentDateTime" Appearance="HighEmphasis" FontWeight="Bold" IsHitTestVisible="False" Text="{Binding DateTimeText}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,4,0" Visibility="{Binding PlaybackControlsVisibility}">
            <controls:VideoOSButtonTransparentExtraSmall VerticalAlignment="Center" ToolTip="{Binding PlaybackForwardPauseState, Converter={converters:BoolConverter TrueValue={x:Static resources2:Strings.TooltipPlaybackPauseButton}, FalseValue={x:Static resources2:Strings.TooltipPlaybackForwardButton}}}" Visibility="{Binding ShowPlaybackPlayPauseControls, Converter={StaticResource BooleanToVisibilityConverter}}" Click="_playbackForwardButton_Click">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type controls:VideoOSButtonTransparentBase}">
                  <Setter Property="controls:VideoOSButtonBase.IconSource" Value="{controls:VideoOSIconBuiltInSource Play_Forward, RtlIcon=Play_Backward}" />
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding PlaybackForwardPauseState}">
                      <Setter Property="controls:VideoOSButtonBase.IconSource" Value="{controls:VideoOSIconBuiltInSource Pause}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </controls:VideoOSButtonTransparentExtraSmall>
            <controls:VideoOSButtonTransparentExtraSmall VerticalAlignment="Center" ToolTip="{x:Static resources2:Strings.TooltipNavigateNextButton}" IsEnabled="{Binding NavigationControlsEnabled}" IconSource="{controls:VideoOSIconBuiltInSource Frame_Next, RtlIcon=Frame_Previous}" Click="_navigateNextButton_Click" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Layers:LayerBase>