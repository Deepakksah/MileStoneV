<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="VideoOS.Installer.ServerPagesSetupPlugin.ConfirmationDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:VideoOS.Installer.ServerPagesSetupPlugin" xmlns:resx="clr-namespace:VideoOS.Installer.ServerPagesSetupPlugin.Properties" xmlns:draw="clr-namespace:System.Drawing;assembly=System.Drawing" xmlns:conv="clr-namespace:VideoOS.Installer.ServerPagesSetupPlugin" Height="160" Width="425" Title="{x:Static resx:Resources.PrivacySettingsConfirmationTitle}" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" AutomationProperties.AutomationId="confirmationDialog">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../ResourceDictionary.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:IconToImageSourceConverter x:Key="iconConverter" />
      <Style x:Key="ButtonResizableToText" TargetType="{x:Type Button}">
        <Setter Property="MinWidth" Value="85" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="5" />
      <RowDefinition Height="31*" />
      <RowDefinition Height="6*" />
      <RowDefinition Height="40" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="20" />
      <ColumnDefinition Width="40" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Static resx:Resources.PrivacySettingsConfirmationQuestion}" TextWrapping="Wrap" Style="{StaticResource ControlTextBlockStyle}" VerticalAlignment="Center" Margin="20,0,0,0" />
    <Image Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding Source={x:Static draw:SystemIcons.Question}, Converter={StaticResource iconConverter}, Mode=OneWay}" />
    <Button Grid.Row="3" Grid.Column="2" Content="{x:Static resx:Resources.PrivacySettingsConfirmationAccept}" IsDefault="True" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,120,20" Padding="20, 0, 20, 0" Height="20" Style="{StaticResource ButtonResizableToText}" FontFamily="Tahoma" AutomationProperties.AutomationId="buttonAccept" Click="ButtonOK_Click" />
    <Button Grid.Row="3" Grid.Column="2" Content="{x:Static resx:Resources.PrivacySettingsConfirmationCancel}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,20" Width="85" Height="20" FontFamily="Tahoma" AutomationProperties.AutomationId="buttonCancel" Click="ButtonCancel_Click" />
  </Grid>
</Window>