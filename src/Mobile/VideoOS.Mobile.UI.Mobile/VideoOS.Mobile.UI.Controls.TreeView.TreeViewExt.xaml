<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.Mobile.UI.Controls.TreeView.TreeViewExt" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:VideoOS.Mobile.UI.Controls.TreeView" xmlns:behaviors="clr-namespace:VideoOS.Mobile.UI.Behaviors" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" x:Name="TreeViewRoot">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="TreeViewItemStyle" TargetType="{x:Type TreeViewItem}">
        <Setter Property="TreeViewItem.IsExpanded" Value="False" />
        <Setter Property="TreeViewItem.IsSelected" Value="{Binding IsInitiallySelected, Mode=OneTime}" />
        <Setter Property="KeyboardNavigation.AcceptsReturn" Value="True" />
        <Setter Property="behaviors:VirtualToggleButton.IsVirtualToggleButton" Value="true" />
        <Setter Property="behaviors:VirtualToggleButton.IsChecked" Value="{Binding IsChecked}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <TreeView ItemContainerStyle="{StaticResource TreeViewItemStyle}" ItemsSource="{Binding Path=ItemsSource, ElementName=TreeViewRoot}">
    <ItemsControl.ItemTemplate>
      <HierarchicalDataTemplate ItemsSource="{Binding Children, Mode=OneTime}">
        <StackPanel Name="ItemContainer" Orientation="Horizontal">
          <CheckBox Name="ItemCheck" Focusable="False" VerticalAlignment="Center" IsChecked="{Binding IsChecked}">
            <behaviors1:Interaction.Triggers xmlns:behaviors1="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors">
              <behaviors1:EventTrigger xmlns:behaviors1="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors" behaviors1:EventTrigger.EventName="Checked">
                <behaviors1:InvokeCommandAction behaviors1:InvokeCommandAction.Command="{Binding Path=CheckedItemsChanged, ElementName=TreeViewRoot}" />
              </behaviors1:EventTrigger>
              <behaviors1:EventTrigger behaviors1:EventTrigger.EventName="Unchecked">
                <behaviors1:InvokeCommandAction behaviors1:InvokeCommandAction.Command="{Binding Path=CheckedItemsChanged, ElementName=TreeViewRoot}" />
              </behaviors1:EventTrigger>
            </behaviors1:Interaction.Triggers>
          </CheckBox>
          <ContentPresenter Name="ItemContent" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Left" ContentTemplate="{Binding Path=InnerContentTemplate, ElementName=TreeViewRoot}" />
        </StackPanel>
      </HierarchicalDataTemplate>
    </ItemsControl.ItemTemplate>
  </TreeView>
</UserControl>