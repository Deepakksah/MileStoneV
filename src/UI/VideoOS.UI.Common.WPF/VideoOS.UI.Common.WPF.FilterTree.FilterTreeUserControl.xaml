<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.UI.Common.WPF.FilterTree.FilterTreeUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:self="clr-namespace:VideoOS.UI.Common.WPF.FilterTree" xmlns:commonConverters="clr-namespace:VideoOS.UI.Common.WPF.Utils.Converters" Loaded="UserControl_Loaded">
  <FrameworkElement.Resources>
    <commonConverters:ImageToImageSourceConverter x:Key="ImageToImageSourceConverter" />
    <commonConverters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" NullVisibility="Collapsed" NotNullVisibility="Visible" />
  </FrameworkElement.Resources>
  <TreeView Name="_filterTreeView" Background="{DynamicResource ScBackground1}" Foreground="{DynamicResource ScBodyText}" BorderThickness="0" ItemsSource="{Binding RootItems}" SelectedItemChanged="_filterTreeView_SelectedItemChanged">
    <ItemsControl.ItemTemplate>
      <HierarchicalDataTemplate DataType="{x:Type self:FilterTreeItem}" ItemsSource="{Binding Children}">
        <StackPanel Orientation="Horizontal">
          <Image Width="16" Height="16" Source="{Binding Image, Converter={StaticResource ImageToImageSourceConverter}}" Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}" />
          <TextBlock Margin="5,0" Foreground="{DynamicResource ScBodyText}" Text="{Binding Title}" />
        </StackPanel>
      </HierarchicalDataTemplate>
    </ItemsControl.ItemTemplate>
  </TreeView>
</UserControl>