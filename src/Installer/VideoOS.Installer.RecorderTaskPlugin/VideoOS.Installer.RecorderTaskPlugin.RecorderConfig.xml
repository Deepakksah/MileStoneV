			</thread_pools>
			<disk_usage_monitor>
				<check_interval_in_seconds>10</check_interval_in_seconds>
				<force_archive_limit_in_mb>5120</force_archive_limit_in_mb>
				<force_delete_limit_in_mb>1024</force_delete_limit_in_mb>
