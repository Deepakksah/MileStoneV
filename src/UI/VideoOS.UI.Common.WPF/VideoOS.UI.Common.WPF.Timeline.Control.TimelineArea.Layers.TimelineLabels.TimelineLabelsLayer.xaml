<?xml version="1.0" encoding="utf-8"?>
<Layers:LayerBase x:Class="VideoOS.UI.Common.WPF.Timeline.Control.TimelineArea.Layers.TimelineLabels.TimelineLabelsLayer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Layers="clr-namespace:VideoOS.UI.Common.WPF.Timeline.Control.TimelineArea.Layers" xmlns:res="clr-namespace:VideoOS.UI.Common.WPF.Timeline.Control.TimelineArea.resources" xmlns:converters="clr-namespace:VideoOS.UI.Common.WPF.Utils.Converters" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:timelineLabels="clr-namespace:VideoOS.UI.Common.WPF.Timeline.Control.TimelineArea.Layers.TimelineLabels" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls;assembly=VideoOS.Platform" x:Name="_root" Loaded="LayerBase_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <timelineLabels:LabelMaxWidthConverterConverter x:Key="LabelMaxWidthConverterConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Rectangle HorizontalAlignment="Left" Fill="{controls:VideoOSInternalDynamicResource TimelineLabelsBackgroundBrush}" Width="{Binding ActualWidth, ElementName=_root, Converter={StaticResource LabelMaxWidthConverterConverter}}" Margin="{Binding TimelineLabelBackgroundMargin}" />
  <controls:VideoOSTextBlockBodyExtraSmall Appearance="HighEmphasis" IsHitTestVisible="False" Padding="10,0,0,0" HorizontalAlignment="Left" AutomationProperties.AutomationId="UpperTimelineLabelText" Text="{Binding UpperTimelineLabelText}" Margin="{Binding UpperTimelineLabelMargin}" Visibility="{Binding UpperTimelineLabelVisibility}" MaxWidth="{Binding ActualWidth, ElementName=_root, Converter={StaticResource LabelMaxWidthConverterConverter}}" />
  <controls:VideoOSTextBlockBodyExtraSmall Appearance="HighEmphasis" IsHitTestVisible="False" Padding="10,0,0,0" HorizontalAlignment="Left" AutomationProperties.AutomationId="LowerTimelineLabelText" Text="{Binding LowerTimelineLabelText}" Margin="{Binding LowerTimelineLabelMargin}" Visibility="{Binding LowerTimelineLabelVisibility}" MaxWidth="{Binding ActualWidth, ElementName=_root, Converter={StaticResource LabelMaxWidthConverterConverter}}" />
  <controls:VideoOSButtonTransparentExtraSmall Name="LegendButton" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="{x:Static res:Strings.LegendTooltip}" Margin="{Binding LegendMargin}" Visibility="{Binding LegendVisibility}" IsHitTestVisible="{Binding ElementName=Popup, Path=IsOpen, Mode=OneWay, Converter={converters:NegationConverter}}" IconSource="{controls:VideoOSIconBuiltInSource Questionmark}" Click="LegendButton_OnClick" />
  <Popup Name="Popup" Placement="Custom" PopupAnimation="None" StaysOpen="False" HorizontalOffset="-4" AllowsTransparency="True" VerticalOffset="-12" PlacementTarget="{Binding ElementName=LegendButton}">
    <controls:VideoOSPanel IsBorderVisible="True" BackgroundAppearance="Background" Effect="{controls:VideoOSDynamicResource DropShadowEffect}" Margin="{controls:VideoOSDynamicResource DropShadowThickness}">
      <Grid Margin="12,12,12,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:VideoOSTextBlockInteractiveMedium Appearance="HighEmphasis" Grid.Row="0" Text="{x:Static res:Strings.LegendTitle}" Margin="0,0,0,12" />
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Legend}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Grid Width="16" Height="16" VerticalAlignment="Center">
                  <Border Name="Rectangle" CornerRadius="1" Background="{Binding Brush}" />
                  <Image Name="Image" Source="{Binding ImageSource}" />
                </Grid>
                <controls:VideoOSTextBlockLabel Appearance="HighEmphasis" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Name}" />
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                  <Setter TargetName="Image" Property="UIElement.Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Brush}" Value="{x:Null}">
                  <Setter TargetName="Rectangle" Property="UIElement.Visibility" Value="Collapsed" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </controls:VideoOSPanel>
  </Popup>
</Layers:LayerBase>