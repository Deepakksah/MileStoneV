<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.UI.Common.WPF.Timeline.Control.UIControls.SelectTimePopup.SelectTimeUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:TimePicker="clr-namespace:VideoOS.UI.Common.WPF.Utils.TimePicker" xmlns:culture="clr-namespace:VideoOS.UI.Common.WPF.Utils.Culture" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls;assembly=VideoOS.Platform" FontFamily="Segoe UI" xmlns:selecttimepopup="clr-namespace:VideoOS.UI.Common.WPF.Timeline.Control.UIControls.SelectTimePopup">
  <StackPanel Orientation="Vertical">
    <controls:VideoOSTextBlockLabel Name="_headerTextBlock" Margin="5,4,0,4" Width="150" HorizontalAlignment="Left" />
    <Calendar Name="_calendar" DisplayMode="Month" Style="{DynamicResource TimelineCalendarStyle}" Language="{x:Static culture:LanguageUtility.SelectedLanguageName}" SelectedDatesChanged="_calendar_SelectedDatesChanged" />
    <Rectangle VerticalAlignment="Stretch" Height="1" Fill="{controls:VideoOSInternalDynamicResource TimelineDialogSeparatorLineBrush}" />
    <TimePicker:TimePickerTime x:Name="_timePickerTime" Margin="0,5,0,5" Style="{DynamicResource TimelineTimePickerStyle}" />
    <Rectangle VerticalAlignment="Stretch" Height="1" Fill="{controls:VideoOSInternalDynamicResource TimelineDialogSeparatorLineBrush}" />
  </StackPanel>
</UserControl>