<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls" xmlns:commands="clr-namespace:VideoOS.Platform.UI.Commands" xmlns:extensions="clr-namespace:VideoOS.Platform.UI.Extensions">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/VideoOS.Platform;component/UI/Controls/VideoOSBase.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Type controls:VideoOSDropDownBase}" BasedOn="{StaticResource {x:Static controls:VideoOSBaseInternals.StyleKey}}" TargetType="{x:Type controls:VideoOSDropDownBase}">
    <Setter Property="commands:EventsToCommandMapping.Events" Value="MouseDown, KeyDown" />
    <Setter Property="extensions:DependencyObjectAttachedProperties.IsMouseLeftButtonDownAware" Value="True" />
    <Setter Property="commands:EventsToCommandMapping.Command" Value="{Binding UserInteractionCommand, RelativeSource={RelativeSource Self}}" />
  </Style>
</ResourceDictionary>