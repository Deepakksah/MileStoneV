<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="mask">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="methods" type="methodsCollectionType" />
        <xs:element name="grid" type="gridType" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="methodsCollectionType">
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element minOccurs="0" maxOccurs="unbounded" name="solid" type="solidMethodType" />
        <xs:element minOccurs="0" maxOccurs="unbounded" name="blur" type="blurMethodType" />
      </xs:choice>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="solidMethodType">
    <xs:attribute name="id" type="xs:unsignedByte" use="required" />
    <xs:attribute name="motionDetection" type="xs:boolean" use="required" />
    <xs:attribute name="removable" type="xs:boolean" use="required" />
  </xs:complexType>

  <xs:complexType name="blurMethodType">
    <xs:attribute name="id" type="xs:unsignedByte" use="required" />
    <xs:attribute name="motionDetection" type="xs:boolean" use="required" />
    <xs:attribute name="removable" type="xs:boolean" use="required" />
    <xs:attribute name="level" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:unsignedByte">
          <xs:minInclusive value="1" />
          <xs:maxInclusive value="10" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:simpleType name="gridSize" final="restriction" >
    <xs:restriction base="xs:string">
      <xs:enumeration value="8x8" />
      <xs:enumeration value="16x16" />
      <xs:enumeration value="32x32" />
      <xs:enumeration value="64x64" />
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="gridType">
    <xs:sequence>
      <xs:element name="cells" type="cellCollectionType" />
    </xs:sequence>
    <xs:attribute name="size" type="gridSize" use="required" />
  </xs:complexType>

  <xs:complexType name="cellCollectionType">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="cell" type="cellType" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="cellType">
    <xs:attribute name="x" type="xs:unsignedByte" use="required" />
    <xs:attribute name="y" type="xs:unsignedByte" use="required" />
    <xs:attribute name="methodId" type="xs:unsignedByte" use="required" />
  </xs:complexType>

</xs:schema>