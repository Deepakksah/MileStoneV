<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.UI.Common.WPF.VideoText.SlideListControl" x:ClassModifier="internal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resources="clr-namespace:VideoOS.UI.Common.WPF.VideoText.resources" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls;assembly=VideoOS.Platform" xmlns:videotext="clr-namespace:VideoOS.UI.Common.WPF.VideoText">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0" Margin="0,0,0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <controls:VideoOSButtonTextSmall Name="btnAdd" Grid.Column="0" Content="{x:Static resources:Strings.AddNewSlide}" IsEnabled="False" Click="btnAdd_Click" />
      <controls:VideoOSButtonTextSmall Name="btnClear" Grid.Column="2" Content="{x:Static resources:Strings.ClearList}" IsEnabled="False" Click="btnClear_Click" />
    </Grid>
    <controls:VideoOSTable Name="_slidesList" Grid.Row="1" RowAppearance="Compact" SelectionMode="Single" RowSeparator="None" SelectionChanged="_slidesList_SelectionChanged">
      <controls:VideoOSTable.Columns>
        <x:ArrayExtension Type="{x:Type controls:VideoOSTableColumnBase}">
          <controls:VideoOSTableTextColumn x:Name="_textColumn" IsSortable="False" Header="" ItemTextPropertyName="DisplayName" Width="*" />
          <controls:VideoOSTableActionsColumn ItemActionsPropertyName="RowActions" HorizontalAlignment="Right" Width="Auto" />
        </x:ArrayExtension>
      </controls:VideoOSTable.Columns>
    </controls:VideoOSTable>
    <Grid Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <controls:VideoOSButtonTransparentMedium Name="btnUp" Margin="4,4,4,0" Padding="0" Grid.Column="1" RenderTransformOrigin="0.5,0.5" IsEnabled="False" IconSource="{controls:VideoOSIconBuiltInSource Arrow_Up}" Click="btnUp_Click" />
      <controls:VideoOSButtonTransparentMedium Name="btnDown" Margin="0,4,4,0" Padding="0" Grid.Column="2" IsEnabled="False" IconSource="{controls:VideoOSIconBuiltInSource Arrow_Down}" Click="btnDown_Click" />
    </Grid>
  </Grid>
</UserControl>