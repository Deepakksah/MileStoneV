<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.UI.Common.WPF.Timeline.Control.UIControls.SelectTimePopup.TimelineSelectTimeUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:UIControls="clr-namespace:VideoOS.UI.Common.WPF.Timeline.Control.UIControls.SelectTimePopup" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls;assembly=VideoOS.Platform">
  <controls:VideoOSPanel IsBorderVisible="True" BackgroundAppearance="Background" Effect="{controls:VideoOSDynamicResource DropShadowEffect}" Margin="{controls:VideoOSDynamicResource DropShadowThickness}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="auto" />
        <RowDefinition Height="auto" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Orientation="Horizontal">
        <UIControls:SelectTimeUserControl x:Name="_selectTimeUserControl1" />
        <Rectangle Width="1" VerticalAlignment="Stretch" Visibility="{Binding ElementName=_selectTimeUserControl2, Path=Visibility}" Fill="{controls:VideoOSInternalDynamicResource TimelineDialogSeparatorLineBrush}" />
        <UIControls:SelectTimeUserControl x:Name="_selectTimeUserControl2" />
        <Rectangle Width="1" VerticalAlignment="Stretch" Visibility="{Binding ElementName=_selectTimeUserControl3, Path=Visibility}" Fill="{controls:VideoOSInternalDynamicResource TimelineDialogSeparatorLineBrush}" />
        <UIControls:SelectTimeUserControl x:Name="_selectTimeUserControl3" />
      </StackPanel>
      <controls:VideoOSButtonTransparentExtraSmall Name="_closeButton" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" IconSource="{controls:VideoOSIconBuiltInSource Close_12px}" Click="_closeButton_Click" />
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
        <controls:VideoOSButtonPrimarySmall Name="_okButton" Click="OKButton_Click" />
      </StackPanel>
    </Grid>
  </controls:VideoOSPanel>
</UserControl>