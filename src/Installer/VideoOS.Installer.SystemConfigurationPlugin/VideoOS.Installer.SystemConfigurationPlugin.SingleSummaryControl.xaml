<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.Installer.SystemConfigurationPlugin.SingleSummaryControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:VideoOS.Installer.SystemConfigurationPlugin">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../ResourceDictionary.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="18" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Name="Header" Grid.Row="0" FontWeight="Bold" Margin="2,0,0,0" Style="{StaticResource ControlTextBlockStyle}" Text="{Binding Header}" />
    <TextBlock Margin="2,0,0,2" Grid.Row="1" FontStyle="Italic" Style="{StaticResource ControlTextBlockStyle}" TextTrimming="WordEllipsis" Text="{Binding EmptySummaryDescription}" Visibility="{Binding Summary, Converter={StaticResource emptySummaryToVisibilityConverter}}" ToolTip="{Binding EmptySummaryDescription}" />
    <ItemsControl Name="ItemList" Grid.Row="1" AutomationProperties.AutomationId="SingleSummaryControl.SummaryItemControl" ItemsSource="{Binding Summary}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Margin="2,0,0,2" AutomationProperties.AutomationId="SingleSummaryControl.SummaryItem" TextTrimming="WordEllipsis" Style="{StaticResource ControlTextBlockStyle}" Text="{Binding}" ToolTip="{Binding}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>