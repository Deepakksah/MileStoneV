<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/VideoOS.Platform;component/UI/Controls/VideoOSBase.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Type controls:VideoOSInputControlSmall}" BasedOn="{StaticResource {x:Static controls:VideoOSBaseInternals.StyleKey}}" TargetType="{x:Type controls:VideoOSInputControlSmall}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:VideoOSInputControlSmall}">
          <Grid Background="#00FFFFFF">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <controls:VideoOSTextBlockLabel Grid.Row="0" Appearance="LowEmphasis" Text="{TemplateBinding controls:VideoOSInputControlBase.Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
            <ContentPresenter Grid.Row="1" HorizontalAlignment="Stretch" />
            <controls:VideoOSInlineMessageSmall Grid.Row="2" Margin="0,4,0,0" Content="{TemplateBinding controls:VideoOSInputControlBase.Message}" MinLines="{TemplateBinding controls:VideoOSInputControlBase.MessageMinLines}" MaxLines="{TemplateBinding controls:VideoOSInputControlBase.MessageMaxLines}" Appearance="{TemplateBinding MessageAppearance, Converter={x:Static controls:VideoOSInputControlBaseInternals.InlineMessageAppearanceConverter}}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>