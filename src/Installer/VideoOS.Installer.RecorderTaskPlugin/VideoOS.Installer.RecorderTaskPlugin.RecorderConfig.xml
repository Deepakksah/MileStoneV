			<port>5432</port>
			<!-- Max allowed sessions (0 - 50) -->
			<maxsessions>20</maxsessions>
		</alert>
	</driverservices>

	<DriverEventListener>
		<!--
			Specifies the UDP port used by the recorder for receiving event notificatins from the drivers.
			The default value is 65101.
		-->
		<Port>65101</Port>
	</DriverEventListener>

	<framemediadbconsumer>
		<!--
			framerateconstant:
			Type    : System.Double
			Default : 9.0

			The framerateconstant indicates how much the FrameMediaDbConsumer should try to level out
			the bursts that may occur when frames are received for writing. The bursts are leveled out
			by expanding the time that we wait for a frame to arrive before the FrameMediaDbConsumer
			determines that the writing is behind and therefore "catch up".

			When setting the value to a higher number the FrameMediaDbConsumer will wait longer before
			catching up. This will cause the recorded data to write more bursts and discarding less
			frames - but the average over a longer time will be more accurate to the selected recording
			framerate. This number indicates the number of seconds that a frame can be delayed without
			the FrameMediaDbConsumer using the frames timestamp directly to determine when the next frame
			should be written.

			The time that the FrameMediaDbConsumer accept to be behind before catching up is calculated
			like this:
			(Int64)(FramePerSecond * FramerateConstant);

			Where:
			FramePerSecond    : The configured recording frame rate
			FramerateConstant : (This configuration value)
		-->
		<framerateconstant>9.0</framerateconstant>
	</framemediadbconsumer>

	<rules>
		<!-- Accept a delay of up to 2000 ms without correcting timestamp in ExecuteRuleActionsCommands -->
		<maxruleactionexecutioncommanddelay>2000</maxruleactionexecutioncommanddelay>
	</rules>

	<failoverserver>
		<port>11000</port>
		<tokenmaxsize>4096</tokenmaxsize>
		<installedasfailoverserver>false</installedasfailoverserver>
	</failoverserver>

	<SmartSearch>
		<UseSecondaryColumns>false</UseSecondaryColumns>
	</SmartSearch>

	<HardwareCheck>
		<!-- 
			CheckFrequence:
			Type    : int
			Default : 15000

			The CheckFrequence indicates how often a check should be performed on the hardware that's
			connected to the recorder. The default is 15000 ms.
			-->
		<CheckFrequence>15000</CheckFrequence>

	</HardwareCheck>

	<!-- 
		StartupRetrieveSeconds:
		Type    : int (0 - 1024)
		Default : 0
		
		Specifies the amount of time to retrieve video for from cameras when recording server is started.
		A positive value can cause problems if failover is configured.
		
		- o -
		
		FailoverSkipRetrieveSeconds:
		Type    : int (0 - 1024)
		Default : 30
		
		When an ordinary recording server (i.e. not failover or hot standby) comes starts after a failover, there might be a gap in the recordings between when the 
		failover stopped and the recorder started recording. The recorder will attempt filling this gap from the edge storage, if it's available. 
		However, in this version of XProtect, overlapping video is not supported.
		To avoid this situation happening, the recorder will not attempt to retrieve the number of specified seconds after it started up. The retrieval will try to cover
		for each device the period after the specified time elapsed and up to when the first image is received from the device.
		
		- o -
		
		MaxStackSizeKB:
		Type    : int  (256 - 1024)
		Default : 256
		
		Specifies the stack size for threads executing the edge storage jobs.
		
		- o -

		MaxSimultaneousJobs:
		Type    : int (1 - 200)
		Default : 100
		
		Specifies the maximum number of simultaneous edge-storage jobs running.
		
		- o -

		MaxJobsAcrossHardware:
		Type    : int (1 - 100)
		Default : 50
		
		Specifies the maximum number of hardware to simultaneous run edge-storage jobs on.
		
		- o -
		
		PeriodicUpdateSeconds:
		Type    : int (1 - 300)
		Default : 10
		
		Specifies the number of seconds between each update of registered timestamps.
		
		- o -
		
		JobMinSeconds:
		Type    : int (0 - 300)
		Default : 2
		
		Specifies the minimum number of seconds a job must span in order to be registered.
		
		- o -
		
		WriteFinishedJobsXmlMinutes:
		Type    : int (1 - 300)
		Default : 10
		
		Specifies the minimum number of minutes between writing of xml file storing finished jobs. 

- o -
		
		DisableAutomaticRetrievalOnStartup:
		Type    : bool 
		Default : false
		
    Only used when Automatic Retrieval is enabled.
		Specifies if the recorder does a retrieval upon startup, when no failover is configured. 
	-->
	<EdgeStorage
			StartupRetrieveSeconds = "0"
			FailoverSkipRetrieveSeconds = "30"
			MaxStackSizeKB = "256"
			JobMinSeconds="2"
			MaxSimultaneousJobs = "100"
			MaxJobsAcrossHardware = "50"
			PeriodicUpdateSeconds="5"
			WriteFinishedJobsXmlMinutes="10"
      DisableAutomaticRetrievalOnStartup="false"
	/>

	<!--
	SessionLingerSeconds:
	Type    : int (0 - max int)
	Default : 10

	Specifies the number of seconds from a multicast-stop is received until the session is actually stopped.
	-->
	<Multicast
	SessionLingerSeconds="10"
	/>

	<PerformanceCounters>
		<!-- DeviceDiskUsageIncrementIntervalInSeconds sets how often performance counters related to disk usage per device are incremented. 0 = disable -->
		<DeviceDiskUsageIncrementIntervalInSeconds>60</DeviceDiskUsageIncrementIntervalInSeconds>
		<!-- MediaDBDiskUsageIncrementIntervalInSeconds sets how often performance counters related to disk usage for the media database are incremented. 0 = disable -->
		<MediaDBDiskUsageIncrementIntervalInSeconds>60</MediaDBDiskUsageIncrementIntervalInSeconds>
	</PerformanceCounters>
	
	<FileStorage>
		<!--
		storageQuotaMBLimit : 
				Specifies the maximum number of megabytes allowed for storage of files (e.g. for firmware update)
				Type    : System.UInt32
				Range   : 16 - 4096
				Default : 3072 (3GB)
		-->
		<storageQuotaMBLimit>3072</storageQuotaMBLimit>
		<!--
		persistedEntryDurationInSeconds : 
				Specifies the number of seconds to wait before removing an inactive persisted storage entry.
				Type    : System.UInt32
				Range   : 60 - 86400
				Default : 1200 (20 minutes)
		-->
		<persistedEntryDurationInSeconds>1200</persistedEntryDurationInSeconds>
		<!--
		temporaryEntryDurationInSeconds : 
				Specifies the number of seconds to wait before removing an inactive temporary storage entry.
				Type    : System.UInt32
				Range   : 60 - 86400
				Default : 300 (5 minutes)
		-->
		<temporaryEntryDurationInSeconds>300</temporaryEntryDurationInSeconds>
	</FileStorage>
	<FirmwareUpdate>
		<!--
		maximumSimultaneousFirmwareUpdates :
				Value set as maximum worker threads for running firmware update operations.
				Type    : System.Int32
				Default : 10
		-->
		<maximumSimultaneousFirmwareUpdates>10</maximumSimultaneousFirmwareUpdates>
	</FirmwareUpdate>
</recorderconfig>
