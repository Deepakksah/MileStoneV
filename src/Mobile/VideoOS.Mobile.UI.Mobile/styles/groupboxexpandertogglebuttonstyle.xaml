<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="#D5DFE5" />
  <Style x:Key="GroupBoxExpanderToggleButtonStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <StackPanel Orientation="Horizontal">
            <Grid SnapsToDevicePixels="False" Background="#00FFFFFF">
              <Ellipse Name="circle" HorizontalAlignment="Center" VerticalAlignment="Center" Width="17" Height="17" Fill="{DynamicResource ButtonNormalBackgroundFill}" Stroke="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
              <Ellipse Name="shadow" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center" Width="15" Height="15" Fill="{DynamicResource ExpanderShadowFill}" />
              <Path Name="arrow" SnapsToDevicePixels="false" VerticalAlignment="Center" HorizontalAlignment="Center" Stroke="#666" StrokeThickness="2" Data="M1,1 L4,4 L7,1" />
            </Grid>
            <ContentPresenter Margin="3,0,0,0" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="true">
              <Setter TargetName="arrow" Property="Path.Data" Value="M1,4 L4,1 L7,4" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="true">
              <Setter TargetName="circle" Property="Shape.Stroke" Value="#666" />
              <Setter TargetName="arrow" Property="Shape.Stroke" Value="#222" />
              <Setter TargetName="shadow" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>