<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.Installer.SystemConfigurationPlugin.HardwareSelectionAndConfigurationPageControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resx="clr-namespace:VideoOS.Installer.SystemConfigurationPlugin.Properties" xmlns:local="clr-namespace:VideoOS.Installer.SystemConfigurationPlugin">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../ResourceDictionary.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="58, 35, 58, 0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="32" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="28" />
      <RowDefinition Height="250" />
    </Grid.RowDefinitions>
    <TextBlock Name="labelHeadLine" Grid.Row="0" AutomationProperties.AutomationId="HardwareSelection.labelHeadLine" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" TextWrapping="Wrap" Margin="0,0,0,0" Style="{StaticResource HeaderTextBlockStyle}" Text="{Binding Header}" />
    <TextBlock Name="labelInfo" AutomationProperties.AutomationId="HardwareSelection.labelInfo" TextWrapping="Wrap" Grid.Row="2" Style="{StaticResource HeaderInfoTextBlockStyle}" Text="{Binding HeaderInfo}" />
    <Border Grid.Row="4" BorderThickness="1" BorderBrush="#5d5d5d" Background="#FFFFFFFF">
      <Grid Background="#FFFFFFFF">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border BorderThickness="0,0,0,1" BorderBrush="#5d5d5d" Background="#ebebeb">
          <ContentControl VerticalContentAlignment="Center" VerticalAlignment="Center" Content="{Binding}">
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <DataTemplate x:Key="{DataTemplateKey {x:Type local:HardwareSelectionViewModel}}" DataType="{x:Type local:HardwareSelectionViewModel}">
                  <local:HardwareSelectionHeaderControl />
                </DataTemplate>
                <DataTemplate x:Key="{DataTemplateKey {x:Type local:HardwareConfigurationViewModel}}" DataType="{x:Type local:HardwareConfigurationViewModel}">
                  <local:HardwareConfigurationHeaderControl VerticalAlignment="Center" VerticalContentAlignment="Center" />
                </DataTemplate>
              </ResourceDictionary>
            </FrameworkElement.Resources>
          </ContentControl>
        </Border>
        <TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" FontStyle="Italic" Style="{StaticResource ControlTextBlockStyle}" Text="{Binding NoCameraMessage}" Visibility="{Binding HardwareToShow, Converter={StaticResource inverseBoolToVisConverter}}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1" Visibility="{Binding HardwareToShow, Converter={StaticResource boolToVisConverter}}">
          <ItemsControl ItemsSource="{Binding Hardware}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderThickness="0,0,0,1" BorderBrush="#5d5d5d">
                  <local:HardwareSelectionAndConfigurationControl />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>