<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls" xmlns:ui="clr-namespace:VideoOS.Platform.UI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/VideoOS.Platform;component/UI/Controls/TextBlocks/VideoOSTextBlockBase.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Type controls:VideoOSTextBlockH2}" BasedOn="{StaticResource {x:Type controls:VideoOSTextBlockBase}}" TargetType="{x:Type controls:VideoOSTextBlockH2}">
    <Setter Property="FontSize" Value="{x:Static controls:VideoOSTextBlockH2Internals.FontSize}" />
    <Setter Property="FontWeight" Value="{x:Static controls:VideoOSTextBlockH2Internals.FontWeight}" />
    <Setter Property="FontFamily" Value="{x:Static controls:VideoOSTextBlockH2Internals.FontFamily}" />
    <Setter Property="FontStyle" Value="{x:Static controls:VideoOSTextBlockH2Internals.FontStyle}" />
    <Setter Property="FontStretch" Value="{x:Static controls:VideoOSTextBlockH2Internals.FontStretch}" />
    <Setter Property="Foreground">
      <Setter.Value>
        <MultiBinding Converter="{x:Static controls:VideoOSTextBlockH2Internals.TextBrushConverter}">
          <Binding Path="." RelativeSource="{RelativeSource Self}" />
          <Binding Path="Appearance" RelativeSource="{RelativeSource Self}" />
          <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
          <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
        </MultiBinding>
      </Setter.Value>
    </Setter>
    <Setter Property="UIElement.Opacity">
      <Setter.Value>
        <MultiBinding Converter="{x:Static controls:VideoOSTextBlockH2Internals.OpacityConverter}">
          <Binding Path="." RelativeSource="{RelativeSource Self}" />
          <Binding Path="Appearance" RelativeSource="{RelativeSource Self}" />
          <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
          <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
        </MultiBinding>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>