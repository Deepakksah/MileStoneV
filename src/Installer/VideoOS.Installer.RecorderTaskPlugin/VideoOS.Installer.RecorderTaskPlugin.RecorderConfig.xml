				Examples of valid host values are: 
				127.0.0.1
				ServerName
				www.domain.com
			-->
		<host/>
		<port>7563</port>

		<!--
				Specifies which certificate, if any, to use for SSL encryption in the web server.

				enabled:
						Values: True or False
						
						Setting to 'True' means that web server will require SSL communication with all clients using
						the certificate found using the other parameters for this node.
						
						Setting to 'False' means that web server will not try to load certificate and will not require
						nor accept SSL communication with clients.
				
				
				certificateHash: hash value of the certificate to be used by the web server. Certificate needs to be
												be present under MY store on Local Computer.
		-->
		<encryption enabled="false" certificateHash=""/>
		
		<requestThread maxStackSizeKB="512" maxRequestSizeKb ="10240"/>


