<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:columnTemplates="clr-namespace:VideoOS.Platform.UI.Controls.Tables.Internal.ColumnTemplates;assembly=VideoOS.Platform">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <columnTemplates:CellIcon Grid.Column="0" IconSource="{Binding _IconSourcePropertyName_}"/>
        <columnTemplates:CellText Grid.Column="1" Text="{Binding _TextPropertyName_}" Margin="8,0,0,0" />
    </Grid>
</DataTemplate>