<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>VideoOS.Server.Service.TrayController</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <StartupObject>VideoOS.Server.Service.TrayController.Program</StartupObject>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="VideoOS.Server.Service.TrayController.Server.ico" />
    <None Remove="VideoOS.Server.Service.TrayController.ServerTrayIconIndeterminate.ico" />
    <None Remove="VideoOS.Server.Service.TrayController.ServerTrayIconRunning.ico" />
    <None Remove="VideoOS.Server.Service.TrayController.ServerTrayIconStarting.ico" />
    <None Remove="VideoOS.Server.Service.TrayController.ServerTrayIconStopped.ico" />
    <None Remove="VideoOS.Server.Service.TrayController.ServerTrayIconStopping.ico" />
    <EmbeddedResource Include="VideoOS.Server.Service.TrayController.Server.ico" LogicalName="VideoOS.Server.Service.TrayController.Server.ico" />
    <EmbeddedResource Include="VideoOS.Server.Service.TrayController.ServerTrayIconIndeterminate.ico" LogicalName="VideoOS.Server.Service.TrayController.ServerTrayIconIndeterminate.ico" />
    <EmbeddedResource Include="VideoOS.Server.Service.TrayController.ServerTrayIconRunning.ico" LogicalName="VideoOS.Server.Service.TrayController.ServerTrayIconRunning.ico" />
    <EmbeddedResource Include="VideoOS.Server.Service.TrayController.ServerTrayIconStarting.ico" LogicalName="VideoOS.Server.Service.TrayController.ServerTrayIconStarting.ico" />
    <EmbeddedResource Include="VideoOS.Server.Service.TrayController.ServerTrayIconStopped.ico" LogicalName="VideoOS.Server.Service.TrayController.ServerTrayIconStopped.ico" />
    <EmbeddedResource Include="VideoOS.Server.Service.TrayController.ServerTrayIconStopping.ico" LogicalName="VideoOS.Server.Service.TrayController.ServerTrayIconStopping.ico" />
  </ItemGroup>
  <ItemGroup>
    
    
    
    <Reference Include="Server.UACParts">
      <HintPath>..\..\..\MSI_Restored\ManagerServer\Server.UACParts.exe</HintPath>
    </Reference>
    
    <Reference Include="System.Core" />
    
    
    <Reference Include="System.Configuration" />
    
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>..\..\..\MSI_Restored\ManagerServer\Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
    </Reference>
    
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="VideoOS.Server.Service\VideoOS.Server.Service.csproj" />
    <ProjectReference Include="VideoOS.Server\VideoOS.Server.csproj" />
  </ItemGroup>
</Project>