<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls" xmlns:converters="clr-namespace:VideoOS.Platform.UI.Converters" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:ui="clr-namespace:VideoOS.Platform.UI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/VideoOS.Platform;component/UI/Controls/VideoOSBase.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Type controls:VideoOSMessageBarSmall}" BasedOn="{StaticResource {x:Static controls:VideoOSBaseInternals.StyleKey}}" TargetType="{x:Type controls:VideoOSMessageBarSmall}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:VideoOSMessageBarSmall}">
          <Grid MinHeight="24" SnapsToDevicePixels="True">
            <Panel.Background>
              <MultiBinding Converter="{x:Static controls:VideoOSMessageBarBaseInternals.BackgroundConverter}">
                <Binding Path="." RelativeSource="{RelativeSource Self}" />
                <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="Appearance" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
              </MultiBinding>
            </Panel.Background>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="12" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <controls:VideoOSActionListHorizontalSmall x:Name="PART_ActionList" Actions="{TemplateBinding controls:VideoOSMessageBarBase.Actions}" Spacing="4" VerticalAlignment="Top" HorizontalContentAlignment="Left" />
            <Rectangle Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
              <Shape.Fill>
                <MultiBinding Converter="{x:Static controls:VideoOSMessageBarBaseInternals.BarBackgroundConverter}">
                  <Binding Path="." RelativeSource="{RelativeSource Self}" />
                  <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Path="Appearance" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
                </MultiBinding>
              </Shape.Fill>
            </Rectangle>
            <controls:VideoOSInlineMessageSmall x:Name="PART_InlineMessage" VerticalAlignment="Top" Margin="0,4,0,0" Grid.Row="0" Grid.Column="2" Content="{TemplateBinding ContentControl.Content}" LinkText="{TemplateBinding controls:VideoOSMessageBarBase.LinkText}" Appearance="{TemplateBinding Appearance, Converter={x:Static controls:VideoOSMessageBarBaseInternals.InlineMessageAppearanceConverter}}" AttenuateMessageText="{TemplateBinding Appearance, Converter={converters:EnumToBoolConverter MatchValue={x:Static controls:Appearances.Error}, MatchedResult=True, NotMatchedResult=False}}" MaxLines="{TemplateBinding IsExpanded, Converter={converters:BoolToIntegerConverter FalseResult={x:Static controls:VideoOSMessageBarBaseInternals.MaxLinesInUnexpandedState}, TrueResult={x:Static system:Int32.MaxValue}}}" />
            <StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="5" Grid.RowSpan="3" Margin="0,4,0,2">
              <controls:VideoOSButtonTransparentExtraSmall Visibility="{TemplateBinding controls:VideoOSMessageBarBase.CloseButtonVisibility}" Command="{Binding CloseCommand, RelativeSource={RelativeSource TemplatedParent}}" IconSource="{controls:VideoOSIconBuiltInSource Close_12px}" />
              <controls:VideoOSButtonTransparentExtraSmall x:Name="PART_ExpansionButton" Margin="0,3,0,0" Command="{Binding ToggleExpansionCommand, RelativeSource={RelativeSource TemplatedParent}}" IconSource="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Converter={converters:BoolToVideoOSIconBuiltInSourceConverter TrueResult=Chevron_Up_12px, FalseResult=Chevron_Down_12px}}" />
            </StackPanel>
            <Rectangle Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="7" Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
              <Shape.Fill>
                <MultiBinding Converter="{converters:BoolToResourceConverter TrueResult={x:Static controls:VideoOSResourceKeysInternal.VideoOSMessageBarDividerIdleBrush}, FalseResult={x:Static controls:VideoOSResourceKeysInternal.VideoOSMessageBarDividerDisabledBrush}}">
                  <Binding Path="." RelativeSource="{RelativeSource Self}" />
                  <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
                </MultiBinding>
              </Shape.Fill>
            </Rectangle>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>