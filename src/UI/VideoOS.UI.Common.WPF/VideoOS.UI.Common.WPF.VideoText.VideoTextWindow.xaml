<?xml version="1.0" encoding="utf-8"?>
<controls:VideoOSDialog x:Class="VideoOS.UI.Common.WPF.VideoText.VideoTextWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VideoOS.UI.Common.WPF.VideoText" xmlns:resources="clr-namespace:VideoOS.UI.Common.WPF.VideoText.resources" xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options" xmlns:my="clr-namespace:VideoOS.UI.Common.WPF.VideoText" xmlns:converters="clr-namespace:VideoOS.UI.Common.WPF.Utils.Converters" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls;assembly=VideoOS.Platform" Title="{x:Static resources:Strings.VideoTextsTitle}" SizeToContent="Height" Width="700" ResizeMode="NoResize">
  <UIElement.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Help" Executed="CommandBinding_Executed" />
  </UIElement.CommandBindings>
  <controls:VideoOSDialog.DialogActions>
    <x:ArrayExtension Type="{x:Type controls:VideoOSDialogActionBase}">
      <controls:VideoOSDialogActionButtonSecondary Placement="Right" Text="{x:Static resources:Strings.CancelButton}" AutomationId="CancelButton" Click="Button_Cancel" />
      <controls:VideoOSDialogActionButtonPrimary Placement="Right" Text="{x:Static resources:Strings.SaveButton}" AutomationId="SaveButton" Click="Button_OK" />
      <controls:VideoOSDialogActionButtonText Placement="Left" x:Name="_buttonHelp" Text="{x:Static resources:Strings.HelpButton}" AutomationId="HelpButton" Click="Button_Help" />
    </x:ArrayExtension>
  </controls:VideoOSDialog.DialogActions>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="DropdownSmallColorItemTemplate" DataType="SlideColor">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" Fill="{Binding SolidColorBrush}" />
          <controls:VideoOSTextBlockBodySmall IsAutoToolTipEnabled="False" FontSize="12" VerticalAlignment="Center" Text="{Binding ColorName}" ToolTip="{Binding ColorName}" Foreground="{controls:VideoOSDropDownBorderlessContentForeground}" />
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="20" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="24" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <controls:VideoOSTextBlockH1 Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" TextWrapping="Wrap" Margin="0,0,0,24" Text="{x:Static resources:Strings.VideoTextsTitle}" />
    <controls:VideoOSTextBlockBodyMedium Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" TextWrapping="Wrap" Margin="0,0,0,18" Text="{x:Static resources:Strings.VideoTextsInstruction}" />
    <Grid Name="_previewContentHolder" Row="3" Column="2" Margin="0,0,0,15" Width="{x:Static local:PreviewGenerator.PreviewWidth}" Height="{x:Static local:PreviewGenerator.PreviewHeight}" />
    <controls:VideoOSTextBlockLabel Grid.Row="4" Grid.Column="2" Margin="0,2,0,3" VerticalAlignment="Top" Text="{x:Static resources:Strings.FontFamily}" />
    <Grid Row="5" Column="2" VerticalAlignment="Top" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <controls:VideoOSDropDownSmall Name="_cbFontFamily" Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center" SelectedItem="{Binding Slide.FontFamily, Mode=TwoWay}" IsEnabled="{Binding SlidesAreReadOnly, Converter={converters:NegationConverter}}" ItemsSource="{Binding Source={x:Static Fonts.SystemFontFamilies}}">
        <controls:VideoOSDropDownBase.ContentTemplate>
          <DataTemplate DataType="FontFamily">
            <controls:VideoOSTextBlockBodySmall IsAutoToolTipEnabled="False" FontSize="12" VerticalAlignment="Center" Text="{Binding Source}" ToolTip="{Binding Source}" FontFamily="{Binding .}" Foreground="{controls:VideoOSDropDownBorderlessContentForeground}" />
          </DataTemplate>
        </controls:VideoOSDropDownBase.ContentTemplate>
      </controls:VideoOSDropDownSmall>
      <controls:VideoOSButtonTertiarySmall Name="_fontUp" Grid.Column="1" Padding="0" Margin="0,0,8,0" VerticalContentAlignment="Center" Command="{Binding FontUpCommand}" IconSource="{controls:VideoOSIconBuiltInSource Text_Size_Larger}" />
      <controls:VideoOSButtonTertiarySmall Name="_fontDown" Grid.Column="2" Padding="0" VerticalContentAlignment="Center" Command="{Binding FontDownCommand}" IconSource="{controls:VideoOSIconBuiltInSource Text_Size_Smaller}" />
    </Grid>
    <Grid Row="6" Column="2" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <controls:VideoOSTextBlockLabel Grid.Row="0" Grid.Column="0" Margin="0,0,0,4" VerticalAlignment="Center" Text="{x:Static resources:Strings.ForegroundColor}" />
      <controls:VideoOSDropDownSmall Name="_cbForeground" Grid.Column="0" Margin="0,0,8,0" Grid.Row="1" ContentTemplate="{StaticResource DropdownSmallColorItemTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" IsEnabled="{Binding SlidesAreReadOnly, Converter={converters:NegationConverter}}" SelectedItem="{Binding Slide.ForegroundBrush, Mode=TwoWay}" ItemsSource="{Binding Path=Slide.DefinedBrushes}" />
      <controls:VideoOSTextBlockLabel Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" VerticalAlignment="Center" Text="{x:Static resources:Strings.BackgroundColor}" />
      <controls:VideoOSDropDownSmall Name="_cbBackground" Grid.Column="1" Grid.Row="1" ContentTemplate="{StaticResource DropdownSmallColorItemTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" IsEnabled="{Binding SlidesAreReadOnly, Converter={converters:NegationConverter}}" SelectedItem="{Binding Slide.BackgroundBrush, Mode=TwoWay}" ItemsSource="{Binding Path=Slide.DefinedBrushes}" />
    </Grid>
    <controls:VideoOSTextBlockLabel Grid.Row="7" VerticalAlignment="Center" Grid.Column="2" Margin="0,0,0,4" Text="{x:Static resources:Strings.Duration}" />
    <controls:VideoOSDropDownSmall Name="_cbTime" Grid.Row="8" Grid.Column="2" MinWidth="50" VerticalContentAlignment="Center" IsEnabled="{Binding SlidesAreReadOnly, Converter={converters:NegationConverter}}" SelectedItem="{Binding Slide.Duration, Mode=TwoWay}" ItemsSource="{Binding Path=Slide.DefinedDurations}">
      <controls:VideoOSDropDownBase.ContentTemplate>
        <DataTemplate DataType="FontFamily">
          <controls:VideoOSTextBlockBodySmall FontSize="12" IsAutoToolTipEnabled="False" VerticalAlignment="Center" Text="{Binding .}" Foreground="{controls:VideoOSDropDownBorderlessContentForeground}" />
        </DataTemplate>
      </controls:VideoOSDropDownBase.ContentTemplate>
    </controls:VideoOSDropDownSmall>
    <my:SlideListControl x:Name="_preSlides" VerticalAlignment="Top" Grid.Row="2" Grid.RowSpan="2" Height="204" Type="PreSlide" SlideListName="{x:Static resources:Strings.PreSlidesTitle}" Slides="{Binding PreSlides}" SelectedSlide="{Binding Slide}" SlidesAreReadOnly="{Binding SlidesAreReadOnly}" />
    <my:SlideListControl x:Name="_postSlides" Grid.Row="4" Height="204" VerticalAlignment="Top" Margin="0,0,0,0" Grid.RowSpan="7" Type="PostSlide" SlideListName="{x:Static resources:Strings.PostSlidesTitle}" SelectedSlide="{Binding Slide}" Slides="{Binding PostSlides}" SlidesAreReadOnly="{Binding SlidesAreReadOnly}" />
  </Grid>
</controls:VideoOSDialog>