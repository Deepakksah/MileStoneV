<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.Installer.SystemConfigurationPlugin.WebClientAddressControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resx="clr-namespace:VideoOS.Installer.SystemConfigurationPlugin.Properties" xmlns:local="clr-namespace:VideoOS.Installer.SystemConfigurationPlugin">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../ResourceDictionary.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="0,0,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="5" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="5" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" TextWrapping="Wrap" Style="{StaticResource ControlTextBlockStyle}" Text="{Binding WebClientHeader}" />
    <TextBlock Grid.Row="2" AutomationProperties.AutomationId="FinishPageControl.WebClientLabel" Style="{StaticResource ControlTextBlockStyle}" Text="{Binding WebClientLabel}" />
    <TextBox Grid.Row="3" IsReadOnly="True" Background="#00FFFFFF" BorderThickness="0" Foreground="#009CDE" AutomationProperties.AutomationId="FinishPageControl.WebClientAddress" Style="{StaticResource ControlTextBoxStyle}" Text="{Binding WebClientAddress}" />
    <TextBlock Grid.Row="5" AutomationProperties.AutomationId="FinishPageControl.MobileClientLabel" Style="{StaticResource ControlTextBlockStyle}" Text="{Binding MobileClientLabel}" />
    <TextBox Grid.Row="6" IsReadOnly="True" Background="#00FFFFFF" BorderThickness="0" AutomationProperties.AutomationId="FinishPageControl.MobileClientAddress" Style="{StaticResource ControlTextBoxStyle}" Text="{Binding MobileClientAddress}" />
  </Grid>
</UserControl>