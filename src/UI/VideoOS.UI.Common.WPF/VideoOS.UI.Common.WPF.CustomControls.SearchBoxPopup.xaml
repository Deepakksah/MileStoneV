<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.UI.Common.WPF.CustomControls.SearchBoxPopup" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:customControls="clr-namespace:VideoOS.UI.Common.WPF.CustomControls" xmlns:mvvmHelpers="clr-namespace:VideoOS.UI.Common.WPF.Utils.MvvmHelpers" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" Width="200" HorizontalAlignment="Left" Focusable="False">
  <Control.Template>
    <ControlTemplate TargetType="{x:Type UserControl}">
      <ContentPresenter />
    </ControlTemplate>
  </Control.Template>
  <FrameworkElement.Resources>
    <ResourceDictionary />
  </FrameworkElement.Resources>
  <customControls:SearchBox x:Name="_searchTextBox" KeyboardNavigation.DirectionalNavigation="Once" Padding="5,2,0,2" MillisecondsDelay="0" TabIndex="0" Width="200" VerticalContentAlignment="Center" Background="{Binding Path=SearchBoxBackground, RelativeSource={RelativeSource AncestorType=customControls:SearchBoxPopup}}" BorderBrush="{Binding Path=SearchBoxBorderBrush, RelativeSource={RelativeSource AncestorType=customControls:SearchBoxPopup}}" Foreground="{Binding Path=SearchBoxForeground, RelativeSource={RelativeSource AncestorType=customControls:SearchBoxPopup}}" DataContext="{Binding Path=DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" SearchText="{Binding Path=SearchText, Mode=TwoWay}" WatermarkText="{Binding Path=WatermarkText}">
    <UIElement.InputBindings>
      <KeyBinding Key="Enter" Command="{Binding CommandEnterPressed}" />
      <KeyBinding Key="Down" Command="{Binding CommandDownPressed}" />
      <KeyBinding Key="Up" Command="{Binding CommandUpPressed}" />
    </UIElement.InputBindings>
    <Control.Template>
      <ControlTemplate TargetType="{x:Type customControls:SearchBox}">
        <Border Name="Bd" Background="{TemplateBinding Control.Background}" BorderThickness="3" CornerRadius="2" Opacity="0.3" SnapsToDevicePixels="true">
          <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WatermarkStates">
              <VisualState x:Name="WatermarkVisible">
                <Storyboard>
                  <DoubleAnimation Duration="0:0:0.2" Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" To="0.3" />
                  <DoubleAnimation Duration="0:0:0.2" Storyboard.TargetName="PART_WaterMark" Storyboard.TargetProperty="Opacity" To="1" />
                </Storyboard>
              </VisualState>
              <VisualState x:Name="ClearButtonVisible">
                <Storyboard>
                  <DoubleAnimation Duration="0:0:0.2" Storyboard.TargetName="PART_WaterMark" Storyboard.TargetProperty="Opacity" To="0" />
                  <DoubleAnimation Duration="0:0:0.2" Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" To="0.8" />
                  <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_ClearButton" Storyboard.TargetProperty="Visibility">
                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                  </ObjectAnimationUsingKeyFrames>
                  <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SearchIcon" Storyboard.TargetProperty="Visibility">
                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Hidden}" />
                  </ObjectAnimationUsingKeyFrames>
                </Storyboard>
              </VisualState>
              <VisualState x:Name="WatermarkHidden">
                <Storyboard>
                  <DoubleAnimation Duration="0:0:0.2" Storyboard.TargetName="PART_WaterMark" Storyboard.TargetProperty="Opacity" To="0" />
                  <DoubleAnimation Duration="0:0:0.2" Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" To="0.8" />
                </Storyboard>
              </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="CommonStates">
              <VisualState x:Name="Normal" />
              <VisualState x:Name="Disabled" />
              <VisualState x:Name="ReadOnly" />
              <VisualState x:Name="MouseOver" />
            </VisualStateGroup>
            <VisualStateGroup x:Name="FocusStates">
              <VisualState x:Name="Unfocused" />
              <VisualState x:Name="Focused" />
            </VisualStateGroup>
            <VisualStateGroup x:Name="ValidationStates">
              <VisualState x:Name="Valid" />
              <VisualState x:Name="InvalidFocused" />
              <VisualState x:Name="InvalidUnfocused" />
            </VisualStateGroup>
          </VisualStateManager.VisualStateGroups>
          <Grid>
            <ScrollViewer Name="PART_ContentHost" FontSize="12" Margin="0,0,16,0" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" Template="{Binding Path=ScrollViewerTemplate, RelativeSource={RelativeSource AncestorType=customControls:SearchBoxPopup}}" />
            <Grid Margin="{TemplateBinding Control.Padding}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Name="PART_WaterMark" FontStyle="Italic" IsHitTestVisible="False" Text="{TemplateBinding customControls:SearchBox.WatermarkText}" />
              <Button Name="PART_ClearButton" Grid.Column="1" Width="16" Height="16" MinWidth="0" Background="#00FFFFFF" Focusable="False" Padding="3" BorderThickness="0" Visibility="Hidden" Command="{Binding ClosePopupCommand}" CommandParameter="{Binding ElementName=MasterControl}">
                <Control.Template>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}">
                      <Image Source="{Binding Path=ClearButtonImage, RelativeSource={RelativeSource AncestorType=customControls:SearchBoxPopup}}" />
                    </Border>
                  </ControlTemplate>
                </Control.Template>
              </Button>
              <Image Name="SearchIcon" Grid.Column="1" IsHitTestVisible="False" Source="{Binding Path=SearchIconImage, RelativeSource={RelativeSource AncestorType=customControls:SearchBoxPopup}}" />
            </Grid>
            <Popup Name="CustomPopup" Margin="0,-1,0,0" PopupAnimation="Fade" StaysOpen="False" IsOpen="{Binding Path=IsPopupOpen, Mode=TwoWay}">
              <Grid>
                <ListView Name="ListView1" HorizontalAlignment="Left" VerticalAlignment="Top" KeyboardNavigation.DirectionalNavigation="Cycle" Width="{Binding Path=Width, ElementName=_searchTextBox}" DataContext="{Binding ElementName=_searchTextBox, Path=DataContext}" SelectedItem="{Binding Path=SelectedItem, Mode=TwoWay}" ItemsSource="{Binding Path=SearchResult, Mode=TwoWay}" Style="{Binding Path=ListViewStyle, RelativeSource={RelativeSource AncestorType=customControls:SearchBoxPopup}}">
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="{x:Type ListViewItem}">
                            <Border Name="SelectionBorder" Background="#00FFFFFF" Padding="2" SnapsToDevicePixels="true">
                              <Grid>
                                <StackPanel Margin="0, 4, 0, 4">
                                  <TextBlock Name="HeaderTextBlock" FontSize="9pt" Text="{Binding Name}" />
                                  <TextBlock Name="SubtextTextBlock" FontSize="7pt" Opacity="0.5" Text="{Binding Path}" />
                                </StackPanel>
                              </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                              <MultiTrigger>
                                <MultiTrigger.Conditions>
                                  <Condition Property="ListBoxItem.IsSelected" Value="True" />
                                  <Condition Property="UIElement.IsFocused" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SelectionBorder" Property="Border.Background" Value="{Binding Path=ListViewItemSelectedUnfocusedBackgroundBrush, RelativeSource={RelativeSource AncestorType=customControls:SearchBoxPopup}}" />
                              </MultiTrigger>
                              <MultiTrigger>
                                <MultiTrigger.Conditions>
                                  <Condition Property="UIElement.IsMouseOver" Value="True" />
                                  <Condition Property="ListBoxItem.IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SelectionBorder" Property="Border.Background" Value="{Binding Path=ListViewItemHoverBackgroundBrush, RelativeSource={RelativeSource AncestorType=customControls:SearchBoxPopup}}" />
                              </MultiTrigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                      <EventSetter Event="GotFocus" Handler="EventSetter_OnGotFocusHandler" />
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                </ListView>
              </Grid>
            </Popup>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsEnabled" Value="false">
            <Setter TargetName="PART_ContentHost" Property="UIElement.Opacity" Value="0.3" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Control.Template>
    <behaviors:Interaction.Behaviors xmlns:behaviors="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors">
      <mvvmHelpers:SelectTextOnFocus />
    </behaviors:Interaction.Behaviors>
  </customControls:SearchBox>
</UserControl>