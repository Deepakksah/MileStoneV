    <Controls:PlaybackSpeedControl x:Name="_playbackSpeedControl" SelectedSpeedChanged="_playbackSpeedControl_SelectedSpeedChanged" Grid.Column="2" VerticalAlignment="Center" />
  </Grid>
</UserControl>