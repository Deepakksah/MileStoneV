<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.UI.Common.WPF.Utils.TimePicker.TimePickerBase" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VideoOS.UI.Common.WPF.Utils.TimePicker" Height="28" Width="125" MinHeight="20" MinWidth="120" Background="#00FFFFFF" DataContext="{Binding RelativeSource={RelativeSource Self}}" IsVisibleChanged="UserControl_IsVisibleChanged">
  <FrameworkElement.Style>
    <Style TargetType="{x:Type local:TimePickerBase}">
      <Setter Property="local:TimePickerBase.PickerBackgroundBrush" Value="{DynamicResource ControlBackgroundBrush}" />
      <Setter Property="local:TimePickerBase.PickerBorderBrush" Value="{DynamicResource ScGray}" />
      <Setter Property="local:TimePickerBase.PickerArrowBrush" Value="{DynamicResource ScGrayBrush}" />
      <Setter Property="local:TimePickerBase.PickerArrowMouseOverBrush" Value="{DynamicResource TextBrush}" />
      <Setter Property="local:TimePickerBase.PickerTextBrush" Value="{DynamicResource TextBrush}" />
      <Setter Property="local:TimePickerBase.PickerCaretBrush" Value="{DynamicResource TextBrush}" />
      <Setter Property="local:TimePickerBase.PickerTextSelectionBrush" Value="{DynamicResource ScSelectedBrush}" />
      <Style.Triggers>
        <Trigger Property="UIElement.IsFocused" Value="True">
          <Setter Property="local:TimePickerBase.PickerBorderBrush" Value="{DynamicResource ScLightGray}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </FrameworkElement.Style>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="IncreaseDecreaseButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RepeatButton}">
              <Canvas Width="14" Height="14" IsHitTestVisible="True" Background="#00FFFFFF">
                <Path Name="arrowPath" Data="M0,12 L7,2 L14,12" IsHitTestVisible="False" Fill="{Binding PickerArrowBrush}" />
              </Canvas>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="arrowPath" Property="Shape.Fill" Value="{Binding PickerArrowMouseOverBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Name="_border" BorderThickness="1" CornerRadius="2" BorderBrush="{Binding PickerBorderBrush}" Background="{Binding PickerBackgroundBrush}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid FlowDirection="LeftToRight">
        <Grid.ColumnDefinitions>
          <ColumnDefinition MinWidth="5" Width="*" />
          <ColumnDefinition MinWidth="20" Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition MinWidth="20" Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition MinWidth="20" Width="Auto" />
        </Grid.ColumnDefinitions>
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Style x:Key="{x:Type local:IntTextBox}" TargetType="{x:Type local:IntTextBox}">
              <Setter Property="Foreground" Value="{Binding PickerTextBrush}" />
              <Setter Property="TextBoxBase.CaretBrush" Value="{Binding PickerCaretBrush}" />
              <Setter Property="TextBoxBase.SelectionBrush" Value="{Binding PickerTextSelectionBrush}" />
              <Setter Property="HorizontalContentAlignment" Value="Center" />
              <Setter Property="VerticalContentAlignment" Value="Center" />
              <Setter Property="TextBoxBase.UndoLimit" Value="0" />
              <Setter Property="Background" Value="#00FFFFFF" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="Margin" Value="0,1,0,1" />
              <EventSetter local:IntTextBox.GotFocus="Focused" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type TextBoxBase}">
                    <Border Name="Border" CornerRadius="2" Padding="1" SnapsToDevicePixels="true" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}">
                      <ScrollViewer Name="PART_ContentHost" Margin="0" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Border" Property="UIElement.Opacity" Value="0.3" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <local:IntTextBox x:Name="_hour" PreviewKeyDown="_hour_PreviewKeyDown" TextChanged="_hour_TextChanged" MinValue="0" MaxValue="23" Grid.Column="1" ContextMenu="{x:Null}">10</local:IntTextBox>
        <TextBlock Name="_seperator1" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="2" Foreground="{Binding PickerTextBrush}">:</TextBlock>
        <local:IntTextBox x:Name="_minutes" PreviewKeyDown="_minutes_PreviewKeyDown" TextChanged="_minutes_TextChanged" MinValue="0" MaxValue="59" Grid.Column="3" ContextMenu="{x:Null}">22</local:IntTextBox>
        <TextBlock Name="_seperator2" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="4" Foreground="{Binding PickerTextBrush}">:</TextBlock>
        <local:IntTextBox x:Name="_seconds" PreviewKeyDown="_seconds_PreviewKeyDown" TextChanged="_seconds_TextChanged" MinValue="0" MaxValue="59" Grid.Column="5" ContextMenu="{x:Null}" IsEnabled="{Binding SecondsEnabled}">35</local:IntTextBox>
      </Grid>
      <Grid Column="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition MinWidth="25" Width="Auto" />
          <ColumnDefinition Width="5" />
          <ColumnDefinition Width="14" />
          <ColumnDefinition MinWidth="3" Width="*" />
        </Grid.ColumnDefinitions>
        <local:StringTextBox x:Name="_designator" GotFocus="Focused" PreviewKeyDown="_designator_PreviewKeyDown" TextChanged="_designator_TextChanged" Background="#00FFFFFF" UndoLimit="0" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Grid.Column="0" CaretBrush="{Binding PickerCaretBrush}" SelectionBrush="{Binding PickerTextSelectionBrush}" Foreground="{Binding PickerTextBrush}" ContextMenu="{x:Null}">aa</local:StringTextBox>
        <Grid Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <RepeatButton Name="_increaseButton" Grid.Row="1" KeyboardNavigation.IsTabStop="False" Style="{StaticResource IncreaseDecreaseButton}" Click="Increase" />
          <RepeatButton Name="_decreaseButton" Grid.Row="2" RenderTransformOrigin="0.5,0.5" KeyboardNavigation.IsTabStop="False" Style="{StaticResource IncreaseDecreaseButton}" Click="Decrease" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>