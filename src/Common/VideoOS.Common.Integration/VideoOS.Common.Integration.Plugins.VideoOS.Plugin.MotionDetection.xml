<?xml version="1.0" encoding="utf-8"?>
<definition xmlns="http://VideoOS.net/Surveillance/XmlSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://VideoOS.net/Surveillance/XmlSchema ..\VideoOS.Common.Integration\Definition\Plugin\definition_plugin.xsd">
	<plugin>
		<name>MotionDetection</name>
		<referenceid>F020C881-72BF-4014-8504-2B4A5A658F1A</referenceid>
		<capabilities>
			<capability>
				<name>Enabled</name>
				<referenceid>A74D819D-F336-4208-B15C-109EF18B751F</referenceid>
				<displayname>Enabled</displayname>
				<type>data</type>
				<access>readwrite</access>
				<data>
					<datatype>boolean</datatype>
					<defaultvalue>true</defaultvalue>
				</data>
			</capability>
			<capability>
				<name>MotionPixCountThreshold</name>
				<referenceid>A4B8FAF0-6C58-46cd-ABF2-B7F13428F5C9</referenceid>
				<displayname>Motion Threshold</displayname>
				<type>data</type>
				<access>readwrite</access>
				<data>
					<datatype>int</datatype>
					<minvalue>0</minvalue>
					<maxvalue>10000</maxvalue>
					<resolution>1</resolution>
					<defaultvalue>2000</defaultvalue>
				</data>
			</capability>
			<capability>
				<name>MotionPixThreshold</name>
				<referenceid>43F2A772-5A03-40b3-A776-B57B03BE941D</referenceid>
				<displayname>Sensitivity Threshold</displayname>
				<type>data</type>
				<access>readwrite</access>
				<data>
					<datatype>int</datatype>
					<minvalue>0</minvalue>
					<maxvalue>300</maxvalue>
					<resolution>1</resolution>
					<defaultvalue>100</defaultvalue>
				</data>
			</capability>
			<capability>
				<name>PixelStep</name>
				<referenceid>2473DE2A-1830-467e-B0BD-30AD8D8279A0</referenceid>
				<displayname>Optimize detection (PixelStep)</displayname>
				<type>data</type>
				<access>readwrite</access>
				<data>
					<datatype>int</datatype>
					<minvalue>1</minvalue>
					<maxvalue>3</maxvalue>
					<resolution>1</resolution>
					<defaultvalue>3</defaultvalue>
				</data>
			</capability>
			<capability>
				<name>TimeThresholdMs</name>
				<referenceid>D3EC1946-8C68-4640-9C0B-F0E936F30989</referenceid>
				<displayname>Process image every (msec)</displayname>
				<type>data</type>
				<access>readwrite</access>
				<data>
					<datatype>int</datatype>
					<minvalue>100</minvalue>
					<maxvalue>1000</maxvalue>
					<resolution>1</resolution>
					<defaultvalue>500</defaultvalue>
				</data>
			</capability>
			<capability>
				<name>KeyFramesOnly</name>
				<referenceid>C69F98B0-86E6-4dd4-B269-1209E2E85819</referenceid>
				<displayname>Process keyframes only (MPEG)</displayname>
				<type>data</type>
				<access>readwrite</access>
				<data>
					<datatype>boolean</datatype>
					<defaultvalue>true</defaultvalue>
				</data>
			</capability>
			<capability>
				<name>ManualSensitivity</name>
				<referenceid>F0DC57A6-4EE7-4F72-A0A5-555EB23AE956</referenceid>
				<displayname>Manual sensitivity</displayname>
				<type>data</type>
				<access>readwrite</access>
				<data>
					<datatype>boolean</datatype>
					<defaultvalue>false</defaultvalue>
				</data>
			</capability>
			<capability>
				<name>GenerateSearchData</name>
				<referenceid>1DF5FEB5-29A4-4752-B036-A984EBCD8F2B</referenceid>
				<displayname>Generate smart search data</displayname>
				<type>data</type>
				<access>readwrite</access>
				<data>
					<datatype>boolean</datatype>
					<defaultvalue>false</defaultvalue>
				</data>
			</capability>
			<capability>
				<name>UseRegions</name>
				<referenceid>889B9495-A5C1-4a02-AA0E-2A236B7D4F8D</referenceid>
				<displayname>Use exclude regions</displayname>
				<type>data</type>
				<access>readwrite</access>
				<data>
					<datatype>boolean</datatype>
					<defaultvalue>false</defaultvalue>
				</data>
			</capability>
			<capability>
				<name>RegionSettings</name>
				<referenceid>42495AA3-4EFD-468d-9E08-CBB4C510803C</referenceid>
				<type>data</type>
				<access>readwrite</access>
				<data>
					<datatype>string</datatype>
					<defaultvalue/>
				</data>
				<complextype>true</complextype>
				<hidden>true</hidden>
			</capability>
		</capabilities>
	</plugin>
</definition>
