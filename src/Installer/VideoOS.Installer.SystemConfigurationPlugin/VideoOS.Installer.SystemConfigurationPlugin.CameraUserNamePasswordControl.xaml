<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.Installer.SystemConfigurationPlugin.CameraUserNamePasswordControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:VideoOS.Installer.SystemConfigurationPlugin" xmlns:resx="clr-namespace:VideoOS.Installer.SystemConfigurationPlugin.Properties" AutomationProperties.AutomationId="CameraUserNamePasswordControl">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../ResourceDictionary.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="58, 40">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="21" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Name="labelHeadLine" AutomationProperties.AutomationId="labelHeadLine" Text="{x:Static resx:Resources.UserNamePasswordHeader}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" TextWrapping="Wrap" Margin="0,0,0,0" Style="{StaticResource HeaderTextBlockStyle}" />
    <Grid Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="16" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Name="labelInfo" AutomationProperties.AutomationId="labelInfo" Text="{x:Static resx:Resources.UsernamePasswordInfo}" TextWrapping="Wrap" Grid.Row="0" Style="{StaticResource HeaderInfoTextBlockStyle}" />
      <TextBlock Name="labelTip" AutomationProperties.AutomationId="labelTip" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="2" TextWrapping="Wrap" Text="{x:Static resx:Resources.UserNamePasswordTip}" Style="{StaticResource HeaderInfoTextBlockStyle}" Margin="0,0,0,0" Foreground="#FF808080" />
    </Grid>
    <Grid Row="4" Width="289" HorizontalAlignment="Left" ShowGridLines="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="20" />
        <RowDefinition Height="22" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Orientation="Horizontal">
        <RadioButton Name="httpsRadioButton" Content="{x:Static resx:Resources.HTTPSLabel}" IsChecked="{Binding UseHttps}" />
        <RadioButton Name="httpRadioButton" Content="{x:Static resx:Resources.HTTPLabel}" Margin="10,0,0,0" IsChecked="{Binding UseHttp}" />
      </StackPanel>
      <Grid Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBlock Name="UserNameHeader" Grid.Column="0" Text="{x:Static resx:Resources.UserName}" FontWeight="Bold" Margin="10,0,0,0" Style="{StaticResource ControlTextBlockStyle}" />
        <TextBlock Name="PasswordHeader" Grid.Column="1" Text="{x:Static resx:Resources.Password}" FontWeight="Bold" Margin="10,0,0,0" Style="{StaticResource ControlTextBlockStyle}" />
      </Grid>
      <DataGrid Name="UserNamePasswordGrid" AutomationProperties.AutomationId="UserNamePasswordGrid" Grid.Row="2" BorderThickness="1,1,0,0" BorderBrush="#FF808080" HeadersVisibility="None" SelectionUnit="Cell" ColumnWidth="144" RowHeaderWidth="0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserReorderColumns="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" VerticalGridLinesBrush="#FF808080" HorizontalGridLinesBrush="#FF808080" ItemsSource="{Binding UserInfo}">
        <DataGrid.Columns>
          <DataGridTemplateColumn>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox BorderThickness="0" Height="22" VerticalContentAlignment="Center" Style="{StaticResource ControlTextBoxStyle}" Text="{Binding UpdateSourceTrigger=PropertyChanged, Path=UserName}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
            <DataGridColumn.CellStyle>
              <Style TargetType="{x:Type DataGridCell}">
                <Setter Property="IsTabStop" Value="False" />
              </Style>
            </DataGridColumn.CellStyle>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <PasswordBox BorderThickness="0" Height="22" VerticalContentAlignment="Center" Style="{StaticResource ControlPasswordBoxStyle}" local:PasswordBoxAttachedProperties.EncryptedPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PasswordChanged="PasswordBox_PasswordChanged" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
            <DataGridColumn.CellStyle>
              <Style TargetType="{x:Type DataGridCell}">
                <Setter Property="IsTabStop" Value="False" />
              </Style>
            </DataGridColumn.CellStyle>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </Grid>
</UserControl>