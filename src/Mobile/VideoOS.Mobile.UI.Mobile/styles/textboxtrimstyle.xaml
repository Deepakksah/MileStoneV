<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="TextBoxTrimStyle" TargetType="{x:Type TextBox}">
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="True">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <Border BorderThickness="1" BorderBrush="#FF808080">
                <TextBlock Padding="3,2,2,2" Text="{TemplateBinding TextBox.Text}" TextTrimming="CharacterEllipsis" Margin="1,1,1,1" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>