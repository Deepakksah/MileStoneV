<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.Installer.SystemConfigurationPlugin.ConfigurationSummaryControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:VideoOS.Installer.SystemConfigurationPlugin">
  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ItemsControl AutomationProperties.AutomationId="ConfigurationSummaryControl.ConfigurationSummary" Margin="0,5,0,0" ItemsSource="{Binding SummaryViewModels}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <local:SingleSummaryControl Margin="0,0,0,10" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>