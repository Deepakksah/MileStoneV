<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.UI.Common.WPF.Utils.MessageBox.DefaultMessageBoxContent" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mb="clr-namespace:VideoOS.UI.Common.WPF.Utils.MessageBox" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:resources="clr-namespace:VideoOS.UI.Common.WPF.Resources" xmlns:converters="clr-namespace:VideoOS.UI.Common.WPF.Utils.Converters" xmlns:controls="clr-namespace:VideoOS.UI.Common.WPF.Controls" MinWidth="300" Loaded="DefaultMessageBoxContent_Loaded">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition MinHeight="100" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="26,22,26,26" Orientation="Horizontal">
      <Image Margin="0,9,0,0" VerticalAlignment="Top" Stretch="None" Source="{Binding AttentionImageSource}" />
      <TextBlock Name="_textBlockText" MaxWidth="400" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="_messageText" Text="{Binding Text}" />
      <TextBlock Name="_textBlockInlines" MaxWidth="400" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="_messageTextInLines" Visibility="Collapsed" />
    </StackPanel>
    <Grid Name="_detailsGrid" Row="1" Visibility="Collapsed" Margin="10">
      <TextBox IsReadOnly="True" Height="200" MaxWidth="600" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Text="{Binding DetailsText}" />
    </Grid>
    <Grid Row="2" Margin="10,0,10,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Label Grid.Column="0" VerticalAlignment="Center" AutomationProperties.AutomationId="_detailsLink" SnapsToDevicePixels="True" Visibility="{Binding DetailsText, Converter={converters:EmptyStringConverter ValueIfEmpty=Collapsed, ValueIfNotEmpty=Visible}}">
        <Hyperlink Name="_detailsHyperLink" Click="_detailsLink_OnClick" />
      </Label>
      <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Thickness x:Key="MarginBetweenButtons" Left="6" Right="6" />
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <StackPanel Orientation="Horizontal">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type StackPanel}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Value="Ok" Binding="{Binding Path=ControlButtons}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <Button Name="_okButton1" Content="{x:Static resources:Strings.MessageBoxOKButton}" IsDefault="True" mb:WpfMessageBoxWindow.DialogResult="True" mb:WpfMessageBoxWindow.Result="Ok" SnapsToDevicePixels="True" AutomationProperties.AutomationId="_okButton1" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type StackPanel}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Value="OkCancel" Binding="{Binding ControlButtons}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <Button Name="_okButton2" Margin="{StaticResource MarginBetweenButtons}" Content="{x:Static resources:Strings.MessageBoxOKButton}" IsDefault="True" mb:WpfMessageBoxWindow.DialogResult="True" mb:WpfMessageBoxWindow.Result="Ok" SnapsToDevicePixels="True" AutomationProperties.AutomationId="_okButton2" />
          <Button Name="_cancelButton2" Content="{x:Static resources:Strings.MessageBoxCancelButton}" IsCancel="True" mb:WpfMessageBoxWindow.DialogResult="False" mb:WpfMessageBoxWindow.Result="Cancel" SnapsToDevicePixels="True" AutomationProperties.AutomationId="_cancelButton2" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type StackPanel}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Value="YesNoCancel" Binding="{Binding ControlButtons}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <Button Name="_yesButton1" Content="{x:Static resources:Strings.MessageBoxYesButton}" mb:WpfMessageBoxWindow.DialogResult="True" mb:WpfMessageBoxWindow.Result="Yes" SnapsToDevicePixels="True" AutomationProperties.AutomationId="_yesButton1" />
          <Button Name="_noButton1" Margin="{StaticResource MarginBetweenButtons}" Content="{x:Static resources:Strings.MessageBoxNoButton}" mb:WpfMessageBoxWindow.DialogResult="False" mb:WpfMessageBoxWindow.Result="No" SnapsToDevicePixels="True" AutomationProperties.AutomationId="_noButton1" />
          <Button Name="_cancelButton1" Content="{x:Static resources:Strings.MessageBoxCancelButton}" IsCancel="True" mb:WpfMessageBoxWindow.DialogResult="False" mb:WpfMessageBoxWindow.Result="Cancel" SnapsToDevicePixels="True" AutomationProperties.AutomationId="_cancelButton1" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type StackPanel}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Value="YesNo" Binding="{Binding ControlButtons}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <Button Name="_yesButton2" Margin="{StaticResource MarginBetweenButtons}" Content="{x:Static resources:Strings.MessageBoxYesButton}" mb:WpfMessageBoxWindow.DialogResult="True" mb:WpfMessageBoxWindow.Result="Yes" SnapsToDevicePixels="True" AutomationProperties.AutomationId="_yesButton2" />
          <Button Name="_noButton2" Content="{x:Static resources:Strings.MessageBoxNoButton}" mb:WpfMessageBoxWindow.DialogResult="False" mb:WpfMessageBoxWindow.Result="No" SnapsToDevicePixels="True" AutomationProperties.AutomationId="_noButton2" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type StackPanel}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Value="RemoveCancel" Binding="{Binding ControlButtons}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <controls:VideoOSButtonPrimaryDestructiveMedium x:Name="_removeButton1" Margin="{StaticResource MarginBetweenButtons}" Content="{x:Static resources:Strings.MessageBoxRemoveButton}" mb:WpfMessageBoxWindow.DialogResult="True" mb:WpfMessageBoxWindow.Result="Remove" SnapsToDevicePixels="True" AutomationProperties.AutomationId="_removeButton1" />
          <controls:VideoOSButtonSecondaryMedium x:Name="_cancelButton3" Content="{x:Static resources:Strings.MessageBoxCancelButton}" mb:WpfMessageBoxWindow.DialogResult="False" mb:WpfMessageBoxWindow.Result="Cancel" SnapsToDevicePixels="True" AutomationProperties.AutomationId="_cancelButton3" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>