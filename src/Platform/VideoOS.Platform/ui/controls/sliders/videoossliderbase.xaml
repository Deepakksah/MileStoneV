<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls" xmlns:ui="clr-namespace:VideoOS.Platform.UI" xmlns:extensions="clr-namespace:VideoOS.Platform.UI.Extensions" xmlns:commands="clr-namespace:VideoOS.Platform.UI.Commands" xmlns:converters="clr-namespace:VideoOS.Platform.UI.Converters">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/VideoOS.Platform;component/UI/Controls/VideoOSBase.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Static controls:VideoOSSliderBase+VideoOSSliderBaseInternals.TrackStyleKey}" TargetType="{x:Type Grid}">
    <Setter Property="Margin" Value="{Binding Path=TrackThumbMargin, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:VideoOSSliderBase}}" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
  </Style>
  <Style x:Key="{x:Static controls:VideoOSSliderBase+VideoOSSliderBaseInternals.ExcludedTrackStyleKey}" TargetType="{x:Type Rectangle}">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Height" Value="2" />
    <Setter Property="Margin" Value="{Binding Path=TrackExcludedThumbMargin, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:VideoOSSliderBase}}" />
    <Setter Property="Fill">
      <Setter.Value>
        <MultiBinding Converter="{x:Static controls:VideoOSSliderBaseInternals.TrackFillBrushConverter}">
          <Binding Path="." RelativeSource="{RelativeSource Self}" />
          <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
          <Binding Source="{x:Static controls:TrackAppearances.Default}" />
          <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
        </MultiBinding>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Static controls:VideoOSSliderBase+VideoOSSliderBaseInternals.IncludedTrackStyleKey}" TargetType="{x:Type Rectangle}" BasedOn="{StaticResource {x:Static controls:VideoOSSliderBaseInternals.ExcludedTrackStyleKey}}">
    <Setter Property="Margin" Value="{Binding Path=TrackIncludedThumbMargin, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:VideoOSSliderBase}}" />
    <Setter Property="Fill">
      <Setter.Value>
        <MultiBinding Converter="{x:Static controls:VideoOSSliderBaseInternals.TrackFillBrushConverter}">
          <Binding Path="." RelativeSource="{RelativeSource Self}" />
          <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
          <Binding Path="TrackAppearance" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type controls:VideoOSSliderBase}}" />
          <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
        </MultiBinding>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Static controls:VideoOSSliderBase+VideoOSSliderBaseInternals.ThumbStyleDefaultKey}" TargetType="{x:Type Thumb}">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Canvas.Left" Value="-10" />
    <Setter Property="Canvas.Top" Value="-1" />
    <Setter Property="extensions:DependencyObjectAttachedProperties.IsMouseLeftButtonDownAware" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Ellipse StrokeThickness="1" Width="12" Height="12">
            <UIElement.Effect>
              <MultiBinding Converter="{x:Static controls:VideoOSSliderBaseInternals.ThumbDropShadowEffectConverter}">
                <Binding Path="." RelativeSource="{RelativeSource Self}" />
                <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
              </MultiBinding>
            </UIElement.Effect>
            <UIElement.Opacity>
              <MultiBinding Converter="{converters:BoolToResourceConverter TrueResult={x:Static controls:VideoOSResourceKeysInternal.VideoOSSliderThumbEnabledOpacity}, FalseResult={x:Static controls:VideoOSResourceKeysInternal.VideoOSSliderThumbDisabledOpacity}}">
                <Binding Path="." RelativeSource="{RelativeSource Self}" />
                <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
              </MultiBinding>
            </UIElement.Opacity>
            <Shape.Stroke>
              <MultiBinding Converter="{x:Static controls:VideoOSSliderBaseInternals.ThumbOutlineBrushConverter}">
                <Binding Path="." RelativeSource="{RelativeSource Self}" />
                <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="(extensions:DependencyObjectAttachedProperties.IsMouseLeftButtonDown)" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
              </MultiBinding>
            </Shape.Stroke>
            <Shape.Fill>
              <MultiBinding Converter="{x:Static controls:VideoOSSliderBaseInternals.ThumbFillBrushConverter}">
                <Binding Path="." RelativeSource="{RelativeSource Self}" />
                <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="(extensions:DependencyObjectAttachedProperties.IsMouseLeftButtonDown)" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
              </MultiBinding>
            </Shape.Fill>
          </Ellipse>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Static controls:VideoOSSliderBase+VideoOSSliderBaseInternals.LabelMinimumStyleKey}" TargetType="{x:Type controls:VideoOSTextBlockLabel}">
    <Setter Property="Text" Value="{Binding Path=MinimumLabel, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:VideoOSSliderBase}}}" />
    <Setter Property="Margin" Value="{x:Static controls:VideoOSSliderBaseInternals.LabelMinimumMargin}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="{x:Static controls:VideoOSSliderBase+VideoOSSliderBaseInternals.LabelMaximumStyleKey}" TargetType="{x:Type controls:VideoOSTextBlockLabel}">
    <Setter Property="Text" Value="{Binding Path=MaximumLabel, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:VideoOSSliderBase}}}" />
    <Setter Property="Margin" Value="{x:Static controls:VideoOSSliderBaseInternals.LabelMaximumMargin}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="{x:Static controls:VideoOSSliderBase+VideoOSSliderBaseInternals.DecreaseButtonStyleKey}" TargetType="{x:Type controls:VideoOSButtonTransparentExtraSmall}">
    <Setter Property="AutomationProperties.AutomationId" Value="DecreaseButton" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="controls:VideoOSButtonBase.IconSource" Value="{Binding Path=SmallDecreaseButtonIconSource, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:VideoOSSliderBase}}}" />
    <Setter Property="Visibility" Value="{Binding Path=SmallDecreaseButtonIconSource, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:VideoOSSliderBase}}, Converter={converters:NullToVisibilityConverter NullResult=Collapsed, NotNullResult=Visible}}" />
    <Setter Property="IsEnabled">
      <Setter.Value>
        <MultiBinding Converter="{x:Static controls:VideoOSSliderBaseInternals.SmallChangeButtonIsEnabledConverter}">
          <Binding Path="Minimum" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type controls:VideoOSSliderBase}}" />
          <Binding Path="Value" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type controls:VideoOSSliderBase}}" />
        </MultiBinding>
      </Setter.Value>
    </Setter>
    <Setter Property="FrameworkElement.ToolTip" Value="{Binding Path=SmallDecreaseButtonToolTip, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:VideoOSSliderBase}}}" />
    <Setter Property="commands:EventsToCommandMapping.Events" Value="Click" />
    <Setter Property="commands:EventsToCommandMapping.Command" Value="{Binding Path=DecreaseValueCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:VideoOSSliderBase}}}" />
  </Style>
  <Style x:Key="{x:Static controls:VideoOSSliderBase+VideoOSSliderBaseInternals.IncreaseButtonStyleKey}" TargetType="{x:Type controls:VideoOSButtonTransparentExtraSmall}">
    <Setter Property="AutomationProperties.AutomationId" Value="IncreaseButton" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Margin" Value="2,0,0,0" />
    <Setter Property="controls:VideoOSButtonBase.IconSource" Value="{Binding Path=SmallIncreaseButtonIconSource, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:VideoOSSliderBase}}}" />
    <Setter Property="Visibility" Value="{Binding Path=SmallIncreaseButtonIconSource, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:VideoOSSliderBase}}, Converter={converters:NullToVisibilityConverter NullResult=Collapsed, NotNullResult=Visible}}" />
    <Setter Property="IsEnabled">
      <Setter.Value>
        <MultiBinding Converter="{x:Static controls:VideoOSSliderBaseInternals.SmallChangeButtonIsEnabledConverter}">
          <Binding Path="Maximum" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type controls:VideoOSSliderBase}}" />
          <Binding Path="Value" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type controls:VideoOSSliderBase}}" />
        </MultiBinding>
      </Setter.Value>
    </Setter>
    <Setter Property="FrameworkElement.ToolTip" Value="{Binding Path=SmallIncreaseButtonToolTip, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:VideoOSSliderBase}}}" />
    <Setter Property="commands:EventsToCommandMapping.Events" Value="Click" />
    <Setter Property="commands:EventsToCommandMapping.Command" Value="{Binding Path=IncreaseValueCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:VideoOSSliderBase}}}" />
  </Style>
  <Style x:Key="{x:Type controls:VideoOSSliderBase}" BasedOn="{StaticResource {x:Static controls:VideoOSBaseInternals.StyleKey}}" TargetType="{x:Type controls:VideoOSSliderBase}">
    <Setter Property="IsTabStop" Value="True" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="commands:EventsToCommandMapping.Events" Value="KeyDown" />
    <Setter Property="commands:EventsToCommandMapping.Command" Value="{Binding Path=KeyDownCommand, RelativeSource={RelativeSource Self}}" />
  </Style>
</ResourceDictionary>