<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>VideoOS.Installer.Common</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net472</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="VideoOS.Installer.Common.Icons.error_icon.png" />
    <None Remove="VideoOS.Installer.Common.Icons.exclamation_icon.png" />
    <None Remove="VideoOS.Installer.Common.Icons.question_icon.png" />
    <None Remove="VideoOS.Installer.Common.Icons.warning_icon.png" />
    <EmbeddedResource Include="VideoOS.Installer.Common.Icons.error_icon.png" LogicalName="VideoOS.Installer.Common.Icons.error_icon.png" />
    <EmbeddedResource Include="VideoOS.Installer.Common.Icons.exclamation_icon.png" LogicalName="VideoOS.Installer.Common.Icons.exclamation_icon.png" />
    <EmbeddedResource Include="VideoOS.Installer.Common.Icons.question_icon.png" LogicalName="VideoOS.Installer.Common.Icons.question_icon.png" />
    <EmbeddedResource Include="VideoOS.Installer.Common.Icons.warning_icon.png" LogicalName="VideoOS.Installer.Common.Icons.warning_icon.png" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceModel" />
    
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Management" />
    
    <Reference Include="Microsoft.Extensions.Logging.Abstractions" />
    <Reference Include="Newtonsoft.Json" />
    <Reference Include="System.Net.Http" />
    
    <Reference Include="System.Xml" />
    
    <Reference Include="System.Core" />
    <Reference Include="System.DirectoryServices.AccountManagement" />
    
    <Reference Include="System.Security" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VideoOS.Installer.Logging\VideoOS.Installer.Logging.csproj" />
    <ProjectReference Include="..\..\Common\VideoOS.Common.EnvironmentServices\VideoOS.Common.EnvironmentServices.csproj" />
    <ProjectReference Include="..\..\Common\VideoOS.WebService.Common\VideoOS.WebService.Common.csproj" />
    <ProjectReference Include="..\..\Common\VideoOS.Common\VideoOS.Common.csproj" />
    <ProjectReference Include="..\VideoOS.Installer.Interfaces\VideoOS.Installer.Interfaces.csproj" />
    <ProjectReference Include="..\VideoOS.Installer.UI\VideoOS.Installer.UI.csproj" />
    <ProjectReference Include="..\VideoOS.Installer.Configuration\VideoOS.Installer.Configuration.csproj" />
    <ProjectReference Include="..\VideoOS.Installer.Common.Utilities\VideoOS.Installer.Common.Utilities.csproj" />
