<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VideoOS.Installer.SystemConfigurationPlugin">
  <Style x:Key="ControlTextBlockStyleSmall" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="#FF000000" />
    <Setter Property="FontSize" Value="8pt" />
    <Setter Property="FontFamily" Value="Tahoma" />
  </Style>
  <Style x:Key="ControlTextBlockStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="#FF000000" />
    <Setter Property="FontSize" Value="9pt" />
    <Setter Property="FontFamily" Value="Tahoma" />
  </Style>
  <Style x:Key="ControlTextBoxStyle" TargetType="{x:Type TextBox}">
    <Setter Property="Foreground" Value="#FF000000" />
    <Setter Property="FontSize" Value="9pt" />
    <Setter Property="FontFamily" Value="Tahoma" />
  </Style>
  <Style x:Key="ControlPasswordBoxStyle" TargetType="{x:Type PasswordBox}">
    <Setter Property="Foreground" Value="#FF000000" />
    <Setter Property="FontSize" Value="9pt" />
    <Setter Property="FontFamily" Value="Tahoma" />
  </Style>
  <Style x:Key="HeaderTextBlockStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="#FF000000" />
    <Setter Property="FontSize" Value="16pt" />
    <Setter Property="FontFamily" Value="Arial" />
  </Style>
  <Style x:Key="HeaderInfoTextBlockStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="#FF000000" />
    <Setter Property="FontSize" Value="9pt" />
    <Setter Property="FontFamily" Value="Arial" />
  </Style>
  <Style x:Key="ControlCheckBoxStyle" TargetType="{x:Type CheckBox}">
    <Setter Property="Foreground" Value="#FF000000" />
    <Setter Property="FontSize" Value="9pt" />
    <Setter Property="FontFamily" Value="Tahoma" />
  </Style>
  <Style x:Key="WarningHeadingTextBlockStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="#FF000000" />
    <Setter Property="FontSize" Value="9pt" />
    <Setter Property="FontFamily" Value="Tahoma" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style x:Key="WarningSubheadingTextBlockStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="#FF000000" />
    <Setter Property="FontSize" Value="9pt" />
    <Setter Property="FontFamily" Value="Tahoma" />
    <Setter Property="FontStyle" Value="Italic" />
  </Style>
  <BooleanToVisibilityConverter x:Key="boolToVisConverter" />
  <BitmapImage x:Key="CollapseImg" UriSource="Resources/Collapse_9x9.png" />
  <BitmapImage x:Key="ExpandImg" UriSource="Resources/Expand_9x9.png" />
  <BitmapImage x:Key="ImgRename" UriSource="Resources/icn16x16_light_Rename.png" />
  <BitmapImage x:Key="ImgCommit" UriSource="Resources/Commit_light_16x16.png" />
  <Style x:Key="ToggleSwitch" TargetType="{x:Type ToggleButton}">
    <Setter Property="Foreground" Value="#FF000000" />
    <Setter Property="Background" Value="#FAFAFB" />
    <Setter Property="BorderBrush" Value="#EAEAEB" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Viewbox Stretch="Uniform">
            <Canvas Width="25" Height="14" Left="0" Top="0">
              <Rectangle Canvas.Left="0" Width="25" Height="14" Fill="#FFFFFFFF" Stroke="#FF000000" StrokeThickness="0.5" />
              <Rectangle Name="rectangle" Canvas.Left="2" Canvas.Bottom="2" Canvas.Top="2" Fill="{TemplateBinding Control.Background}" Stroke="{TemplateBinding Control.BorderBrush}" Width="7" Height="10">
                <UIElement.RenderTransform>
                  <TranslateTransform X="0" Y="0" />
                </UIElement.RenderTransform>
              </Rectangle>
            </Canvas>
          </Viewbox>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetProperty="Background.Color" To="#6a8bc1" Duration="0:0:0.2" />
                    <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color" To="#6a8bc1" Duration="0:0:0.2" />
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Rectangle.RenderTransform).(TranslateTransform.X)" Storyboard.TargetName="rectangle">
                      <SplineDoubleKeyFrame KeyTime="0" Value="0" />
                      <SplineDoubleKeyFrame KeyTime="0:0:0.4" KeySpline="0, 1, 0.6, 1" Value="14" />
                    </DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetProperty="Background.Color" To="Gray" Duration="0:0:0.2" />
                    <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color" To="Gray" Duration="0:0:0.2" />
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Rectangle.RenderTransform).(TranslateTransform.X)" Storyboard.TargetName="rectangle">
                      <SplineDoubleKeyFrame KeyTime="0" Value="14" />
                      <SplineDoubleKeyFrame KeyTime="0:0:0.3" KeySpline="0, 0.5, 0.5, 1" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>