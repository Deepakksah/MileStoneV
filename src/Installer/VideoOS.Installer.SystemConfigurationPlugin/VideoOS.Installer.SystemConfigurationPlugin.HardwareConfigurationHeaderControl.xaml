<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.Installer.SystemConfigurationPlugin.HardwareConfigurationHeaderControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resx="clr-namespace:VideoOS.Installer.SystemConfigurationPlugin.Properties" xmlns:local="clr-namespace:VideoOS.Installer.SystemConfigurationPlugin">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../ResourceDictionary.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Row="0" Height="26px" Margin="5,0,0,0">
    <TextBlock Grid.Column="1" Text="{x:Static resx:Resources.HardwareSelectionAddedHardware}" FontWeight="Bold" VerticalAlignment="Center" Style="{StaticResource ControlTextBlockStyle}" />
  </Grid>
</UserControl>