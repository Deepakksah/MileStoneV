<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.ServerConfigurator.CertificateConfigurator.UI.ApplyPopup" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:con="clr-namespace:VideoOS.UI.Common.WPF.Utils.Converters;assembly=VideoOS.UI.Common.WPF" xmlns:ui="clr-namespace:VideoOS.ServerConfigurator.CertificateConfigurator.UI;assembly=VideoOS.ServerConfigurator.CertificateConfigurator.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="StyleDictionary.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="ApplyPopupFunction" Style="{StaticResource PopUpOuterGrid}">
    <Border Style="{StaticResource PopUpInnerGrid}">
      <UIElement.Effect>
        <DropShadowEffect BlurRadius="10" Opacity="0.2" Direction="-75" />
      </UIElement.Effect>
      <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="auto" />
          <RowDefinition Height="auto" />
          <RowDefinition />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,12,0,12">
          <Path DockPanel.Dock="Left" Style="{StaticResource WarningIcon}" VerticalAlignment="Top" Margin="0,0,8,0" Visibility="{Binding IsWarning, Converter={con:BoolToVisibilityConverter TrueValue=Visible, FalseValue=Collapsed}}" />
          <TextBlock DockPanel.Dock="Right" Style="{StaticResource H1}" TextWrapping="Wrap" Text="{Binding Title}" />
        </DockPanel>
        <TextBlock Grid.Row="1" Style="{StaticResource H3}" TextWrapping="Wrap" Text="{Binding Message}" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,25,0,0">
          <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" AutomationProperties.AutomationId="EncryptionPage.OkButton" IsDefault="True" Content="{Binding OkButtonText}" Command="{Binding OkCommand}" />
          <Button Name="btnCancel" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Margin="8,0,0,0" IsCancel="True" Content="{Binding CancelButtonText}" Command="{Binding CancelCommand}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>