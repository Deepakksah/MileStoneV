<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>VideoOS.Utilities.Telemetry</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net472</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="VideoOS.Utilities.Telemetry.TelemetrySettings.json" />
    <EmbeddedResource Include="VideoOS.Utilities.Telemetry.TelemetrySettings.json" LogicalName="VideoOS.Utilities.Telemetry.TelemetrySettings.json" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Xml" />
    <Reference Include="Microsoft.Extensions.Logging.Abstractions" />
    <Reference Include="System.Web.Services" />
    <Reference Include="System.Data" />
    <Reference Include="System.Configuration" />
    <Reference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IdentityModel.Tokens.Jwt" />
    <Reference Include="OpenTelemetry" />
    <Reference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <Reference Include="System.Core" />
    <Reference Include="Microsoft.Extensions.Configuration.Binder" />
    <Reference Include="Microsoft.Extensions.Logging" />
    <Reference Include="Microsoft.Extensions.Configuration" />
    <Reference Include="Microsoft.Extensions.Configuration.Json" />
  </ItemGroup>

  
  <ItemGroup>
    <ProjectReference Include="..\VideoOS.Utilities\VideoOS.Utilities.csproj" />
  </ItemGroup>
</Project>