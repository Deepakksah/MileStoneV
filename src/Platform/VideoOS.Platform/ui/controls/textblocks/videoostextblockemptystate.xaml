<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls" xmlns:ui="clr-namespace:VideoOS.Platform.UI" xmlns:converters="clr-namespace:VideoOS.Platform.UI.Converters">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/VideoOS.Platform;component/UI/Controls/TextBlocks/VideoOSTextBlockBase.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Type controls:VideoOSTextBlockEmptyState}" BasedOn="{StaticResource {x:Type controls:VideoOSTextBlockBase}}" TargetType="{x:Type controls:VideoOSTextBlockEmptyState}">
    <Setter Property="FontSize" Value="{x:Static controls:VideoOSTextBlockEmptyStateInternals.FontSize}" />
    <Setter Property="FontWeight" Value="{x:Static controls:VideoOSTextBlockEmptyStateInternals.FontWeight}" />
    <Setter Property="FontFamily" Value="{x:Static controls:VideoOSTextBlockEmptyStateInternals.FontFamily}" />
    <Setter Property="FontStyle" Value="{x:Static controls:VideoOSTextBlockEmptyStateInternals.FontStyle}" />
    <Setter Property="FontStretch" Value="{x:Static controls:VideoOSTextBlockEmptyStateInternals.FontStretch}" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static controls:VideoOSResourceKeysInternal.VideoOSTextBlockEmptyStateLowEmphasisForegroundIdleBrush}}" />
    <Setter Property="UIElement.Opacity">
      <Setter.Value>
        <MultiBinding Converter="{x:Static controls:VideoOSTextBlockEmptyStateInternals.OpacityConverter}">
          <Binding Path="." RelativeSource="{RelativeSource Self}" />
          <Binding Path="Appearance" RelativeSource="{RelativeSource Self}" />
          <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
          <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
        </MultiBinding>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>