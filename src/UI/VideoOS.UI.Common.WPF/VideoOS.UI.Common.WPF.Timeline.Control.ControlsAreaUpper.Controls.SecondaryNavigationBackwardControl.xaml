<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.UI.Common.WPF.Timeline.Control.ControlsAreaUpper.Controls.SecondaryNavigationBackwardControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resources="clr-namespace:VideoOS.UI.Common.WPF.Timeline.Control.ControlsAreaUpper.Controls.resources" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls;assembly=VideoOS.Platform" xmlns:controls1="clr-namespace:VideoOS.UI.Common.WPF.Timeline.Control.ControlsAreaUpper.Controls">
  <Grid>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <controls:VideoOSButtonTransparentMedium Name="_navigateFirstButton" ToolTip="{x:Static resources:Strings.TooltipNavigateFirstButton}" IsEnabled="{Binding NavigationControlsEnabled}" IconSource="{controls:VideoOSIconBuiltInSource Sequence_First, RtlIcon=Sequence_Last}" Click="_navigateFirstButton_Click" />
      <controls:VideoOSButtonTransparentMedium Name="_navigatePreviousSequenceButton" Margin="8,0,0,0" ToolTip="{x:Static resources:Strings.TooltipNavigatePreviousSequenceButton}" IsEnabled="{Binding NavigationControlsEnabled}" IconSource="{controls:VideoOSIconBuiltInSource Sequence_Previous, RtlIcon=Sequence_Next}" Click="_navigatePreviousSequenceButton_Click" />
    </StackPanel>
  </Grid>
</UserControl>