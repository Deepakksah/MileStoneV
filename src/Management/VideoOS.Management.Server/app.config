  <appSettings>
    <add key="ServerPort" value="8080"/>
    <add key="DisablePermissionAuditLogs" value="false"/>
    <!-- Value expected in LogWriterServiceClientFactoryTests / Config_LogWriterClientBindingOpenTimeoutCanBeConfiguredFromAppSettings -->
    <add key="VideoOS.LogServer.Communication.LogConfiguration.BindingOpenTimeoutSeconds" value="5"/>
    <add key="VideoOS.LogServer.Communication.LogConfiguration.BindingCloseTimeoutSeconds" value="5"/>
    <add key="VideoOS.LogServer.Communication.LogConfiguration.BindingSendTimeoutSeconds" value="10"/>
    <add key="VideoOS.LogServer.Communication.LogConfiguration.BindingReceiveTimeoutSeconds" value="60"/>
    
    <add key="enableGeminiTraceWriter" value="true"/>
    <!-- IDP Settings -->
    <add key="AuthorizationServerUri" value="http://localhost:80/IDP"/>
    <add key="ClientRegistrationId" value=""/>
    <!-- Default directory is under the managements servers logfiles -->
    <add key="GeminiTraceDirectoryName" value=""/>
    <!-- Specifies the time after which a hardware definitions is evicted from the cache if it hasn't been access. 0 (zero) means infinite -->
    <add key="HardwareDefinitionsCache_SlidingExpirationMinutes" value="1440"/>
    <!-- Specifies the retention period for Windows users that have been removed (marked as deleted) as permitted VMS users. Values: [1:2147483647], default: 60 -->
    <add key="IdentityCleanupService_ExpirationDays" value="60"/>
    <add key="EnableServiceChannelEvents_ViewGroup" value="true"/>
    <add key="EnableServiceChannelEvents_View" value="true"/>
    <add key="EnableServiceChannelEvents_ViewItem" value="true"/>
    <add key="ChildSitesForExternalUsers" value="true"/>
    <add key="ClientTokenTimoutMinutes" value="240"/>
    <!--Service channel app settings-->
    <!-- Session timeout in seconds -->
    <add key="VideoOS.SCH.Services.SCHSessionTimeoutSecs" value="120"/>
    <!-- Data storage type; valid values are: 'InMemory', 'SQLServer'. -->
    <add key="VideoOS.SCH.Services.AppDataStorageType" value="InMemory"/>
    <!-- Is message type enforced (same type name = same keys). Valid values: true, false -->
    <add key="VideoOS.SCH.Services.Data.MessageTypeEnforced" value="false"/>
    <!-- Maximum data size in serialised characters to return to a client "in one go" -->
    <add key="VideoOS.SCH.Services.Interfaces.Web.MaxResponseDataSize" value="15000"/>
    <!-- The recommended polling interval between message checks in milliseconds. Valid value: Int32. -->
    <add key="VideoOS.SCH.Services.Interfaces.Web.RecommendedMsgChkIntervalMs" value="1000"/>
    <!-- Is session message indicator used? (a web server in-memory cache over sessions that have messages). Valid values: true, false. -->
    <add key="VideoOS.SCH.Services.SessionMsgIndicatorUsed" value="false"/>
    <!-- Max number of milliseconds to wait for new messages. Valid value: Int32. -->
    <add key="VideoOS.SCH.Services.MaxNoofMillisecsToWaitForMessages" value="0"/>
    <!-- Number of seconds to wait between expired sessions are checked and deleted. Valid value: Int32. -->
    <add key="VideoOS.SCH.Services.BatchJobs.DeleteExpiredSessionsJobIntervalSecs" value="50"/>
    <!-- Number of seconds to wait between stranded session messages are checked and deleted. Valid value: Int32. -->
    <add key="VideoOS.SCH.Services.BatchJobs.DeleteNonSessionMessagesIntervalSecs" value="20"/>
    <!-- Number of seconds between attempts to register Service Channel as a service in XPCO. -->
    <!-- A value of zero will disable the registration job. Valid value: Int32. -->
    <add key="VideoOS.SCH.Services.BatchJobs.ServiceRegistrationIntervalSecs" value="60"/>
    <!-- Number of milliseconds to wait between update of the SessionMsgIndicator cache. Valid value: Int32. -->
    <add key="VideoOS.SCH.Services.BatchJobs.SessionMsgIndicatorUpdateIntervalMs" value="900"/>
    <!-- Windows event log source name for Service Channel server. -->
    <add key="VideoOS.SCH.WinEventLogSourceName" value="ServiceChannelServer"/>
    <!-- This setting decides if messages should be logged. Valid data type: Boolean -->
    <add key="VideoOS.SCH.Services.MessageLogEnabled" value="false"/>
    <!-- The file name of the message log. The name can contain tokens as '~' and '%DATEFORMAT%'. -->
    <!-- Example: "~\Logs\ServiceChannelMessages_%yyMMdd_HH%.log". Valid data type: String -->
    <!-- '~' will be replaced with default product folder like '<CommonAppData>\<Company>\<ProductName>'  -->
    <!-- '%yyMMdd_HH%' will be replaced with formatted GMT date like '091130_14' (30/Nov/2009 14:00) -->
    <add key="VideoOS.SCH.Services.MessageLogFileName" value="~\Logs\ServiceChannelMessages_%yyMMdd_HH%.log"/>
    <!-- Timeout in seconds when calling the server command service. Valid value: Int32. -->
    <add key="VideoOS.SCH.ServerCommandServiceTimeout" value="30"/>
    <!-- Enable strong cryptography and let the OS choose the TLS protocol -->
    <add key="AppContext.SetSwitch:Switch.System.Net.DontEnableSchUseStrongCrypto" value="false"/>
    <add key="AppContext.SetSwitch:Switch.System.Net.DontEnableSystemDefaultTlsVersions" value="false"/>
    <!-- Settings related to RestAPI-->
    <add key="RestAPI.MaxReturnedItems" value="99999"/>
  </appSettings>
  <VideoOS.Diagnostics.Logging>
    <Logger name="ServiceChannelServerLog">
      <Appender type="File" level="debug" filename="~/Logs/ServiceChannelServer.log" archive="~/Logs/Archive" maxsize="10"/>
    </Logger>
  </VideoOS.Diagnostics.Logging>
  <system.runtime.caching>
    <memoryCache>
      <namedCaches>
        <add name="HardwareDefinitionsCache" cacheMemoryLimitMegabytes="200" physicalMemoryLimitPercentage="0" pollingInterval="00:02:00"/>
      </namedCaches>
    </memoryCache>
  </system.runtime.caching>
  <!--IN CASE TRACING IS REQUIRED REMOVE THE COMMENT BELOW IN <system.diagnostics> AND THE COMMENT IN <system.webServer>
    REMOVE THE COMMENT IN CASE TRACE LOGS ARE REQUIRED
  
     NOTE:
     To change the level of logging and tracing change the value/values of "switchValue" for each log depending on the required level:
     1. Off
     2. Critical - "Negative" events: events that indicate an unexpected processing or an error condition.
     3. Error - "Negative" events: events that indicate an unexpected processing or an error condition.
     4. Warning - "Negative" events: events that indicate an unexpected processing or an error condition.
     5. Information - "Positive" events: events that mark successful milestones
     6. Verbose - "Positive" events: events that mark successful milestones.
     7. ActivityTracing - Flow events between processing activities and components.
     8. All
     
     MORE INFORMATION CAN BE FOUND HERE: https://msdn.microsoft.com/en-us/library/ms733025%28v=vs.110%29.aspx -->
  <system.diagnostics>
    <!--
    <sources>
      <source name="System.ServiceModel.MessageLogging" switchValue="Warning,ActivityTracing">
        <listeners>
          <add type="System.Diagnostics.DefaultTraceListener" name="Default">
            <filter type="" />
          </add>
          <add name="ServiceModelMessageLoggingListener">
            <filter type="" />
          </add>
        </listeners>
      </source>
      <source propagateActivity="true" name="System.ServiceModel" switchValue="Warning,ActivityTracing">
        <listeners>
          <add type="System.Diagnostics.DefaultTraceListener" name="Default">
            <filter type="" />
          </add>
          <add name="ServiceModelTraceListener">
            <filter type="" />
          </add>
        </listeners>
      </source>
    </sources>
    <sharedListeners>
      <add initializeData="C:\Temp\Management_Web_Messages.svclog"
        type="System.Diagnostics.XmlWriterTraceListener, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
        name="ServiceModelMessageLoggingListener" traceOutputOptions="Timestamp">
        <filter type="" />
      </add>
      <add initializeData="C:\Temp\Management_Web_Tracelog.svclog"
        type="System.Diagnostics.XmlWriterTraceListener, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
        name="ServiceModelTraceListener" traceOutputOptions="Timestamp">
        <filter type="" />
      </add>
    </sharedListeners>
    -->
    <switches>
      <add name="General" value="2"/>
      <add name="Database" value="2"/>
      <add name="Security" value="2"/>
      <add name="Configuration" value="2"/>
    </switches>
    <trace autoflush="true" indentsize="4"/>
  </system.diagnostics>
  <connectionStrings/>
  <!-- 
    For a description of web.config changes for .NET 4.5 see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.5" />
      </system.Web>
  -->
  <system.web>
    <!--
            Set compilation debug="true" to insert debugging 
            symbols into the compiled page. Because this 
            affects performance, set this value to true only 
            during development.
        -->
    <compilation targetFramework="4.7.2">
      <assemblies/>
    </compilation>
    <trust level="Full"/>
    <authentication mode="None"/>
    <!--
      The <customErrors> section enables configuration 
      of what to do if/when an unhandled error occurs 
      during the execution of a request. Specifically, 
      it enables developers to configure html error pages 
      to be displayed in place of a error stack trace.

      <customErrors mode="RemoteOnly" defaultRedirect="GenericErrorPage.htm">
          <error statusCode="403" redirect="NoAccess.htm" />
          <error statusCode="404" redirect="FileNotFound.htm" />
      </customErrors>
    -->
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID"/>
	<httpRuntime maxRequestLength="100000"/>   <!-- = 100MB -->
  </system.web>
  <!--
    The system.webServer section is required for running ASP.NET AJAX under Internet
    Information Services 7.0. It is not necessary for previous version of IIS.
    -->
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits/>     
      </requestFiltering>
    </security>
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0"/>
      <!--remove name="OPTIONSVerbHandler" /-->
      <!--remove name="TRACEVerbHandler" /-->
		<add name="ExtensionlessUrlHandler-Integrated-4.0-controllers" path="ManagementServer/api/*" verb="GET,PATCH,POST,DELETE,PUT,OPTIONS"
		  type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0"/>
		<add name="ExtensionlessUrlHandler-Integrated-4.0" path="ManagementServer/rest/*" verb="GET,PATCH,POST,DELETE,PUT,OPTIONS"
		  type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0"/>
      <add name="ExtensionlessUrlHandler-Integrated-4.0-well-known" path="ManagementServer/.well-known/*" verb="GET"
		  type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0"/>
    </handlers>
    <httpProtocol>
      <customHeaders>
        <add name="X-Frame-Options" value="SAMEORIGIN"/>
      </customHeaders>
    </httpProtocol>
    <!--security>
      <authentication>
        <anonymousAuthentication enabled="true" />
        <basicAuthentication enabled="true" />
        <windowsAuthentication enabled="true" />
      </authentication>
    </security-->
  </system.webServer>
  <system.serviceModel>
    <serviceHostingEnvironment multipleSiteBindingsEnabled="true" aspNetCompatibilityEnabled="true">
      <serviceActivations>
        <add relativeAddress="ServerServiceOAuth.svc" service="VideoOS.Management.Server.ServerServiceOAuth"
          factory="VideoOS.Management.Server.OAuthServiceHostFactory"/>
        <add relativeAddress="SecurityServiceOAuth.svc" service="VideoOS.Management.Server.SecurityServiceOAuth"
          factory="VideoOS.Management.Server.OAuthServiceHostFactory"/>
        <add relativeAddress="ManagementServerServiceOAuth.svc" service="VideoOS.Management.Server.ManagementServerServiceOAuth"
          factory="VideoOS.Management.Server.OAuthServiceHostFactory"/>     
        <add relativeAddress="ServerCommandServiceOAuth.svc" service="VideoOS.Management.Server.ServerCommandServiceOAuth"
          factory="VideoOS.Management.Server.OAuthServiceHostFactory"/>
        <add relativeAddress="ServiceRegistrationServiceOAuth.svc" service="VideoOS.Management.Server.ServiceRegistrationServiceOAuth"
          factory="VideoOS.Management.Server.OAuthServiceHostFactory"/>
        <add relativeAddress="ServerProxyServiceOAuth.svc" service="VideoOS.Management.Server.ServerProxyServiceOAuth"
          factory="VideoOS.Management.Server.OAuthServiceHostFactory"/>
        <add relativeAddress="ConfigurationApiServiceOAuth.svc" service="VideoOS.Management.Server.ConfigurationApi.ConfigurationApiServiceOAuth"
          factory="VideoOS.Management.Server.OAuthServiceHostFactory"/>
        <add relativeAddress="WebViewerClientServiceOAuth.svc" service="VideoOS.Management.Server.WebViewerClientServiceOAuth"
          factory="VideoOS.Management.Server.OAuthServiceHostFactory"/>
        <add relativeAddress="StateServiceOAuth.svc" service="VideoOS.Management.Server.StateServiceOAuth"
          factory="VideoOS.Management.Server.OAuthServiceHostFactory"/>
        <add relativeAddress="SCHDiagnosticsManagerOAuth.svc" service="VideoOS.Management.Server.SCHDiagnosticsManagerOAuth"
          factory="VideoOS.Management.Server.OAuthServiceHostFactory"/>
        <add relativeAddress="SCHMessageCreatorManagerOAuth.1.svc" service="VideoOS.Management.Server.SCHMessageCreatorManagerOAuth"
          factory="VideoOS.Management.Server.OAuthServiceHostFactory"/>
        <add relativeAddress="SCHMessageWatchManagerOAuth.1.svc" service="VideoOS.Management.Server.SCHMessageWatchManagerOAuth"
          factory="VideoOS.Management.Server.OAuthServiceHostFactory"/>
        <add relativeAddress="SCHOperationInfoManagerOAuth.1.svc" service="VideoOS.Management.Server.SCHOperationInfoManagerOAuth"
          factory="VideoOS.Management.Server.OAuthServiceHostFactory"/>
      </serviceActivations>
    </serviceHostingEnvironment>
    <diagnostics performanceCounters="Default">
      <!-- REMOVE IN CASE TRACING IS REQUIRED
      <messageLogging logEntireMessage="true" logMalformedMessages="true"
        logMessagesAtServiceLevel="true" logMessagesAtTransportLevel="true"/> 
      -->
    </diagnostics>
    <extensions>
      <behaviorExtensions>
        <add name="BasicAuthenticationExtensionElement" type="VideoOS.Management.Server.BasicAuthenticationExtensionElement, VideoOS.Management.Server"/>
        <add name="GeminiServiceBehaviorExtensionElement" type="VideoOS.Management.Server.GeminiServiceBehaviorExtension, VideoOS.Management.Server"/>
      </behaviorExtensions>
    </extensions>
    <behaviors>
      <serviceBehaviors>
        <behavior name="OAuthServiceBehavior">
          <GeminiServiceBehaviorExtensionElement/>
          <dataContractSerializer maxItemsInObjectGraph="2147483647"/>
          <serviceThrottling maxConcurrentCalls="250" maxConcurrentSessions="2000" maxConcurrentInstances="250"/>
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true"/>
          <serviceDebug includeExceptionDetailInFaults="true"/>
          <serviceCredentials useIdentityConfiguration="true"/>
        </behavior>
        <behavior name="GeminiServiceBehavior">
          <GeminiServiceBehaviorExtensionElement/>
          <dataContractSerializer maxItemsInObjectGraph="2147483647"/>
          <serviceThrottling maxConcurrentCalls="250" maxConcurrentSessions="2000" maxConcurrentInstances="250"/>
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true"/>
          <serviceDebug includeExceptionDetailInFaults="true"/>
          <serviceCredentials>
            <windowsAuthentication includeWindowsGroups="true" allowAnonymousLogons="false"/>
          </serviceCredentials>
        </behavior>
      </serviceBehaviors>
      <endpointBehaviors>
        <behavior name="BasicAuthenticationBehavior">
          <BasicAuthenticationExtensionElement/>
        </behavior>
      </endpointBehaviors>
    </behaviors>
    <bindings>
      <basicHttpBinding>
        <binding name="OAuthAuthentication" closeTimeout="00:10:00" openTimeout="00:10:00" receiveTimeout="00:10:00" sendTimeout="00:10:00"
          bypassProxyOnLocal="false" hostNameComparisonMode="StrongWildcard" maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647"
          messageEncoding="Text" textEncoding="utf-8" useDefaultWebProxy="true" allowCookies="false">
          <readerQuotas maxDepth="32" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647"
            maxNameTableCharCount="2147483647"/>
          <security mode="None"/>
        </binding>
        <binding name="OAuthAuthenticationTransport" closeTimeout="00:10:00" openTimeout="00:10:00" receiveTimeout="00:10:00" sendTimeout="00:10:00"
          bypassProxyOnLocal="false" hostNameComparisonMode="StrongWildcard" maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647"
          messageEncoding="Text" textEncoding="utf-8" useDefaultWebProxy="true" allowCookies="false">
          <readerQuotas maxDepth="32" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647"
            maxNameTableCharCount="2147483647"/>
          <security mode="Transport"/>
        </binding>
        <binding name="BasicAuthentication" closeTimeout="00:10:00" openTimeout="00:10:00" receiveTimeout="00:10:00" sendTimeout="00:10:00"
          bypassProxyOnLocal="false" hostNameComparisonMode="StrongWildcard" maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647"
          messageEncoding="Text" textEncoding="utf-8" useDefaultWebProxy="true" allowCookies="false">
          <readerQuotas maxDepth="32" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647"
            maxNameTableCharCount="2147483647"/>
          <security mode="Transport">
            <transport clientCredentialType="None" proxyCredentialType="None" realm=""/>
          </security>
        </binding>
      </basicHttpBinding>
      <wsHttpBinding>
        <binding name="WindowsAuthentication" closeTimeout="00:10:00" openTimeout="00:10:00" receiveTimeout="00:10:00" sendTimeout="00:10:00"
          bypassProxyOnLocal="false" hostNameComparisonMode="StrongWildcard" maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647"
          messageEncoding="Text" textEncoding="utf-8" useDefaultWebProxy="true" allowCookies="false">
          <readerQuotas maxDepth="32" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647"
            maxNameTableCharCount="2147483647"/>
          <reliableSession ordered="true" inactivityTimeout="00:10:00" enabled="false"/>
          <security mode="Message">
            <transport clientCredentialType="Windows" proxyCredentialType="None" realm=""/>
            <message clientCredentialType="Windows" negotiateServiceCredential="true" algorithmSuite="Default"/>
          </security>
        </binding>
      </wsHttpBinding>
    </bindings>
    <services>
      <service name="VideoOS.Management.Server.DataCollectorServiceOAuth" behaviorConfiguration="OAuthServiceBehavior">
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="OAuthAuthentication"
          contract="VideoOS.WebService.Common.DataCollectorService.IDataCollection"/>
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="OAuthAuthenticationTransport"
          contract="VideoOS.WebService.Common.DataCollectorService.IDataCollection"/>
      </service>
      <service name="VideoOS.Management.Server.ServerServiceOAuth" behaviorConfiguration="OAuthServiceBehavior">
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="OAuthAuthentication" contract="VideoOS.Management.Server.IServerService"/>
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="OAuthAuthenticationTransport" contract="VideoOS.Management.Server.IServerService"/>
      </service>
      <service name="VideoOS.Management.Server.ServerService" behaviorConfiguration="GeminiServiceBehavior">
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="BasicAuthentication" contract="VideoOS.Management.Server.IServerService"
          behaviorConfiguration="BasicAuthenticationBehavior"/>
        <endpoint address="" binding="wsHttpBinding" bindingConfiguration="WindowsAuthentication" contract="VideoOS.Management.Server.IServerService"/>
        <endpoint address="urn:videoos:management:server:serverservice" listenUri="" binding="wsHttpBinding" bindingConfiguration="WindowsAuthentication"
          bindingNamespace="urn:videoos:management:server:serverservice" contract="VideoOS.Management.Server.IServerService"/>
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange"/>
      </service>
      <service name="VideoOS.Management.Server.SecurityServiceOAuth" behaviorConfiguration="OAuthServiceBehavior">
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="OAuthAuthentication" contract="VideoOS.Management.Server.ISecurityService"/>
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="OAuthAuthenticationTransport"
