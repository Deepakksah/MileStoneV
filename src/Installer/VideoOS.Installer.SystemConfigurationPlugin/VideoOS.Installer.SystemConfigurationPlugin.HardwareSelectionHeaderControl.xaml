<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.Installer.SystemConfigurationPlugin.HardwareSelectionHeaderControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resx="clr-namespace:VideoOS.Installer.SystemConfigurationPlugin.Properties" xmlns:local="clr-namespace:VideoOS.Installer.SystemConfigurationPlugin">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../ResourceDictionary.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Row="0" Height="26px">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="26px" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <CheckBox Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" IsChecked="{Binding Enabled}" />
    <TextBlock Grid.Column="1" Text="{x:Static resx:Resources.HardwareSelectionDiscoveredHardware}" VerticalAlignment="Center" FontWeight="Bold" Style="{StaticResource ControlTextBlockStyle}" />
  </Grid>
</UserControl>