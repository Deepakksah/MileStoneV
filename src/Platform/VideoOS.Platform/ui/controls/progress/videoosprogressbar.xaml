<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:converters="clr-namespace:VideoOS.Platform.UI.Converters" xmlns:ui="clr-namespace:VideoOS.Platform.UI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/VideoOS.Platform;component/UI/Controls/VideoOSBase.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Type controls:VideoOSProgressBar}" BasedOn="{StaticResource {x:Static controls:VideoOSBaseInternals.StyleKey}}" TargetType="{x:Type controls:VideoOSProgressBar}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:VideoOSProgressBar}">
          <ControlTemplate.Triggers>
            <Trigger Property="ProgressBar.IsIndeterminate" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="_indeterminateBorder" Storyboard.TargetProperty="Tag" From="0.0" To="1.0" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
            </Trigger>
          </ControlTemplate.Triggers>
          <Grid SnapsToDevicePixels="True" MinWidth="20" Height="4" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}">
            <Border Name="PART_Track" CornerRadius="1" Background="{DynamicResource {x:Static controls:VideoOSResourceKeysInternal.VideoOSProgressBarBackgroundBrush}}" />
            <Border Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="1" Background="{DynamicResource {x:Static controls:VideoOSResourceKeysInternal.VideoOSProgressBarForegroundBrush}}" Visibility="{TemplateBinding IsIndeterminate, Converter={converters:BoolToVisibilityConverter FalseResult=Visible, TrueResult=Hidden}}" />
            <Border Name="_indeterminateBorder" HorizontalAlignment="Left" CornerRadius="1" Background="{DynamicResource {x:Static controls:VideoOSResourceKeysInternal.VideoOSProgressBarForegroundBrush}}" Width="{Binding ElementName=PART_Track, Path=ActualWidth, Converter={x:Static controls:VideoOSProgressBarInternals.IndeterminateBorderWidthConverter}}" Visibility="{TemplateBinding IsIndeterminate, Converter={converters:BoolToVisibilityConverter FalseResult=Hidden, TrueResult=Visible}}">
              <FrameworkElement.Tag>
                <system:Double>0</system:Double>
              </FrameworkElement.Tag>
              <FrameworkElement.Margin>
                <MultiBinding Converter="{x:Static controls:VideoOSProgressBarInternals.IndeterminateBorderMarginConverter}">
                  <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                  <Binding ElementName="PART_Track" Path="ActualWidth" />
                </MultiBinding>
              </FrameworkElement.Margin>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>