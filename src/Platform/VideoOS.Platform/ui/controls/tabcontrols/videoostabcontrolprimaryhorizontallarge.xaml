<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:VideoOS.Platform.UI" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls" xmlns:internal="clr-namespace:VideoOS.Platform.UI.Controls.TabControls.Internal" xmlns:primary="clr-namespace:VideoOS.Platform.UI.Controls.TabControls.Internal.Primary" xmlns:converters="clr-namespace:VideoOS.Platform.UI.Converters">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/VideoOS.Platform;component/UI/Controls/VideoOSBase.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <DataTemplate x:Key="FallbackContentTemplate">
    <controls:VideoOSTextBlockBodyMedium TextWrapping="Wrap" Text="{Binding Converter={converters:ToStringConverter}}" />
  </DataTemplate>
  <Style x:Key="{x:Type controls:VideoOSTabControlPrimaryHorizontalLarge}" BasedOn="{StaticResource {x:Static controls:VideoOSBaseInternals.StyleKey}}" TargetType="{x:Type controls:VideoOSTabControlPrimaryHorizontalLarge}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:VideoOSTabControlPrimaryHorizontalLarge}">
          <Grid Background="#00FFFFFF" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <primary:HeaderControl Grid.Row="0" ItemsSource="{TemplateBinding controls:VideoOSTabControlBase.ItemsSource}" ItemSeparatorPlacement="{TemplateBinding controls:VideoOSTabControlBase.ItemSeparatorPlacement}" ItemSizeMode="{TemplateBinding controls:VideoOSTabControlPrimaryHorizontalBase.ItemSizeMode}" SelectedItem="{Binding SelectedItem, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:VideoOSTabControlBase}}}" />
            <ContentControl Grid.Row="1" Focusable="False" Content="{internal:ItemContent}" ContentTemplate="{internal:ItemContentTemplate FallbackTemplate={StaticResource FallbackContentTemplate}}" Margin="{TemplateBinding IsContentBorderVisible, Converter={converters:BoolToThicknessConverter TrueResult=8, FalseResult=0,8,0,0}}" Visibility="{TemplateBinding IsContentVisible, Converter={converters:BoolToVisibilityConverter TrueResult=Visible, FalseResult=Collapsed}}" />
            <Border Grid.Row="1" BorderThickness="1" CornerRadius="0,0,2,2" SnapsToDevicePixels="True" Visibility="{TemplateBinding IsContentBorderVisible, Converter={converters:BoolToVisibilityConverter TrueResult=Visible, FalseResult=Collapsed}}">
              <Border.BorderBrush>
                <MultiBinding Converter="{converters:BoolToResourceConverter TrueResult={x:Static controls:VideoOSResourceKeysInternal.VideoOSTabControlBorderIdleBrush}, FalseResult={x:Static controls:VideoOSResourceKeysInternal.VideoOSTabControlBorderDisabledBrush}}">
                  <Binding Path="." RelativeSource="{RelativeSource Self}" />
                  <Binding Path="IsEnabled" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type controls:VideoOSTabControlBase}}" />
                  <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
                </MultiBinding>
              </Border.BorderBrush>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>