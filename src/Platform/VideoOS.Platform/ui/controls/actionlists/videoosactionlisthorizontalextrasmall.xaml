<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls" xmlns:internal="clr-namespace:VideoOS.Platform.UI.Controls.ActionLists.Internal">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/VideoOS.Platform;component/UI/Controls/ActionLists/VideoOSActionListBase.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Type controls:VideoOSActionListHorizontalExtraSmall}" BasedOn="{StaticResource {x:Type controls:VideoOSActionListBase}}" TargetType="{x:Type controls:VideoOSActionListHorizontalExtraSmall}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:VideoOSActionListHorizontalExtraSmall}">
          <internal:ActionsPresenter x:Name="PART_ActionsPresenter" Actions="{TemplateBinding controls:VideoOSActionListBase.Actions}" Spacing="{TemplateBinding controls:VideoOSActionListBase.Spacing}" ControlSize="ExtraSmall" HorizontalAlignment="Stretch" HorizontalContentAlignment="{TemplateBinding Control.HorizontalContentAlignment}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>