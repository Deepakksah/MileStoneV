<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls" xmlns:ui="clr-namespace:VideoOS.Platform.UI" xmlns:converters="clr-namespace:VideoOS.Platform.UI.Converters" xmlns:extensions="clr-namespace:VideoOS.Platform.UI.Extensions">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/VideoOS.Platform;component/UI/Controls/Containers/VideoOSScrollViewer.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Static controls:VideoOSStyleScrollBar+VideoOSStyleScrollBarInternals.ScrollBarThumbStyleKey}" TargetType="{x:Type Thumb}" BasedOn="{x:Null}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Grid Margin="0,0,0,0">
            <Rectangle Width="8" Height="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RadiusX="4" RadiusY="4" Margin="1,0,1,0" StrokeThickness="0">
              <Shape.Fill>
                <MultiBinding Converter="{x:Static controls:VideoOSStyleScrollBarInternals.ThumbFillConverter}">
                  <Binding Path="." RelativeSource="{RelativeSource Self}" />
                  <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Path="(extensions:DependencyObjectAttachedProperties.IsMouseLeftButtonDown)" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
                </MultiBinding>
              </Shape.Fill>
            </Rectangle>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Static controls:VideoOSStyleScrollBar+VideoOSStyleScrollBarInternals.ScrollBarScrollTrackRepeatButtonStyleKey}" TargetType="{x:Type RepeatButton}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderBrush" Value="#00FFFFFF" />
    <Setter Property="IsTabStop" Value="false" />
    <Setter Property="Focusable" Value="false" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Grid>
            <Rectangle Fill="{TemplateBinding Control.Background}" Stroke="{TemplateBinding Control.BorderBrush}" StrokeThickness="{TemplateBinding Control.BorderThickness}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Static controls:VideoOSStyleScrollBar+VideoOSStyleScrollBarInternals.ScrollBarStyleKey}" TargetType="{x:Type ScrollBar}">
    <Setter Property="Stylus.IsFlicksEnabled" Value="false" />
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static controls:VideoOSResourceKeysInternal.VideoOSScrollBarBorderBrush}}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="extensions:DependencyObjectAttachedProperties.IsMouseLeftButtonDownAware" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Border BorderBrush="{TemplateBinding Control.BorderBrush}" UseLayoutRounding="True">
            <Border.BorderThickness>
              <MultiBinding Converter="{x:Static controls:VideoOSStyleScrollBarInternals.ContentBorderThicknessConverter}">
                <Binding Path="Orientation" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="(controls:VideoOSStyleScrollBar.IsContentBorderVisible)" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="(ScrollViewer.ComputedHorizontalScrollBarVisibility)" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="(ScrollViewer.ComputedVerticalScrollBarVisibility)" RelativeSource="{RelativeSource TemplatedParent}" />
              </MultiBinding>
            </Border.BorderThickness>
            <Grid Name="_gridRoot" Width="{x:Static controls:VideoOSStyleScrollBarInternals.ScrollBarSize}" Margin="0" Background="{TemplateBinding Control.Background}">
              <Track Name="PART_Track" IsDirectionReversed="true" Orientation="Vertical" Margin="0,4">
                <FrameworkElement.Resources>
                  <ResourceDictionary>
                    <system:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">48</system:Double>
                    <system:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">48</system:Double>
                  </ResourceDictionary>
                </FrameworkElement.Resources>
                <Track.Thumb>
                  <Thumb Style="{StaticResource {x:Static controls:VideoOSStyleScrollBarInternals.ScrollBarThumbStyleKey}}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Name="_pageUpButton" Command="ScrollBar.PageDownCommand" Style="{StaticResource {x:Static controls:VideoOSStyleScrollBarInternals.ScrollBarScrollTrackRepeatButtonStyleKey}}" />
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Name="_pageDownButton" Command="ScrollBar.PageUpCommand" Style="{StaticResource {x:Static controls:VideoOSStyleScrollBarInternals.ScrollBarScrollTrackRepeatButtonStyleKey}}" />
                </Track.DecreaseRepeatButton>
              </Track>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="ScrollBar.Orientation" Value="Vertical">
              <Setter TargetName="_gridRoot" Property="HorizontalAlignment" Value="Center" />
            </Trigger>
            <Trigger Property="ScrollBar.Orientation" Value="Horizontal">
              <Setter TargetName="_gridRoot" Property="FrameworkElement.LayoutTransform">
                <Setter.Value>
                  <RotateTransform Angle="-90" />
                </Setter.Value>
              </Setter>
              <Setter TargetName="PART_Track" Property="Track.Orientation" Value="Vertical" />
              <Setter TargetName="_pageDownButton" Property="ButtonBase.Command" Value="ScrollBar.PageLeftCommand" />
              <Setter TargetName="_pageUpButton" Property="ButtonBase.Command" Value="ScrollBar.PageRightCommand" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Static controls:VideoOSStyleScrollBar+VideoOSStyleScrollBarInternals.ScrollViewerStyleKey}" TargetType="{x:Type ScrollViewer}">
    <Setter Property="Template" Value="{StaticResource {x:Static controls:VideoOSScrollViewerInternals.ScrollViewerTemplateKey}}" />
    <Style.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource {x:Static controls:VideoOSStyleScrollBarInternals.ScrollBarStyleKey}}" />
      </ResourceDictionary>
    </Style.Resources>
  </Style>
</ResourceDictionary>