<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls" xmlns:ui="clr-namespace:VideoOS.Platform.UI" xmlns:converters="clr-namespace:VideoOS.Platform.UI.Converters">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/VideoOS.Platform;component/UI/Controls/TextBoxes/VideoOSTextBoxBase.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Type controls:VideoOSTextBoxMedium}" BasedOn="{StaticResource {x:Type controls:VideoOSTextBoxBase}}" TargetType="{x:Type controls:VideoOSTextBoxMedium}">
    <Setter Property="Foreground">
      <Setter.Value>
        <MultiBinding Converter="{x:Static controls:VideoOSTextBoxMediumInternals.TextBrushConverter}">
          <Binding Path="." RelativeSource="{RelativeSource Self}" />
          <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
          <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
        </MultiBinding>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:VideoOSTextBoxMedium}">
          <Border CornerRadius="2" MinHeight="32" BorderThickness="1" SnapsToDevicePixels="True">
            <Border.BorderBrush>
              <MultiBinding Converter="{x:Static controls:VideoOSTextBoxBaseInternals.OutlineBrushConverter}">
                <Binding Path="." RelativeSource="{RelativeSource Self}" />
                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="IsFocused" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="State" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
              </MultiBinding>
            </Border.BorderBrush>
            <Border.Background>
              <MultiBinding Converter="{x:Static controls:VideoOSTextBoxBaseInternals.BackgroundBrushConverter}">
                <Binding Path="." RelativeSource="{RelativeSource Self}" />
                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="IsFocused" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
              </MultiBinding>
            </Border.Background>
            <Grid Margin="{Binding ElementName=PART_ContentHost, Path=ComputedVerticalScrollBarVisibility, Converter={converters:EnumToThicknessConverter MatchValue={x:Static Visibility.Visible}, MatchedResult=12,0,0,0, NotMatchedResult=12,0}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <controls:VideoOSIcon Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" Appearance="LowEmphasis" Visibility="{Binding Mode, RelativeSource={RelativeSource TemplatedParent}, Converter={converters:EnumToVisibilityConverter MatchValue={x:Static controls:Modes.Search}, MatchedResult=Visible, NotMatchedResult=Collapsed}}" IconSource="{controls:VideoOSIconBuiltInSource Search}" />
              <controls:VideoOSScrollViewer x:Name="PART_ContentHost" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" controls:VideoOSStyleScrollBar.IsContentBorderVisible="False">
                <FrameworkElement.Margin>
                  <MultiBinding Converter="{x:Static controls:VideoOSTextBoxBaseInternals.ContentHostMarginConverter}">
                    <Binding Path="TextWrapping" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="AcceptsReturn" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding>
                </FrameworkElement.Margin>
                <FrameworkElement.Tag>
                  <MultiBinding Converter="{converters:BoolToResourceConverter TrueResult={x:Static controls:VideoOSResourceKeysInternal.VideoOSTextBlockOpacityEnabled}, FalseResult={x:Static controls:VideoOSResourceKeysInternal.VideoOSTextBlockOpacityDisabled}}">
                    <Binding Path="." RelativeSource="{RelativeSource Self}" />
                    <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
                  </MultiBinding>
                </FrameworkElement.Tag>
              </controls:VideoOSScrollViewer>
              <controls:VideoOSTextBlockBodyMedium Grid.Column="1" Appearance="LowEmphasis" Cursor="IBeam" Text="{TemplateBinding controls:VideoOSTextBoxBase.PlaceholderText}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Visibility="{TemplateBinding Text, Converter={converters:StringNullOrEmptyToVisibilityConverter NotNullOrEmptyResult=Collapsed, NullOrEmptyResult=Visible}}">
                <FrameworkElement.Margin>
                  <MultiBinding Converter="{x:Static controls:VideoOSTextBoxBaseInternals.PlaceholderTextMarginConverter}">
                    <Binding Path="VerticalContentAlignment" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding ElementName="PART_ContentHost" Path="Margin" />
                  </MultiBinding>
                </FrameworkElement.Margin>
                <TextBlock.TextWrapping>
                  <MultiBinding Converter="{x:Static controls:VideoOSTextBoxBaseInternals.PlaceholderTextTextWrappingConverter}">
                    <Binding Path="TextWrapping" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="AcceptsReturn" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding>
                </TextBlock.TextWrapping>
              </controls:VideoOSTextBlockBodyMedium>
              <controls:VideoOSButtonTransparentSmall Grid.Column="2" VerticalAlignment="Center" Margin="4,0,-4,0" Command="{TemplateBinding controls:VideoOSTextBoxBase.ClearTextCommand}" EnsureFocusIsNotLostWhenActivatedUsingSpaceKey="{TemplateBinding controls:VideoOSTextBoxBase.EnsureFocusIsNotLostWhenActivatedUsingSpaceKey}" IconSource="{controls:VideoOSIconBuiltInSource Search_Clear_Field}">
                <UIElement.Visibility>
                  <MultiBinding Converter="{x:Static controls:VideoOSTextBoxBaseInternals.ClearButtonVisibilityConverter}">
                    <Binding Path="Text" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="Mode" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding>
                </UIElement.Visibility>
              </controls:VideoOSButtonTransparentSmall>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>