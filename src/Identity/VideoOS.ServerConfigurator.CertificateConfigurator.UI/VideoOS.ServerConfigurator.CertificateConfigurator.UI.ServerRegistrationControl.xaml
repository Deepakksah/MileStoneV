<?xml version="1.0" encoding="utf-8"?>
<ctrl:UserControl x:Class="VideoOS.ServerConfigurator.CertificateConfigurator.UI.ServerRegistrationControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mvvm="clr-namespace:VideoOS.UI.Common.WPF.Utils.MvvmHelpers;assembly=VideoOS.UI.Common.WPF" xmlns:con="clr-namespace:VideoOS.UI.Common.WPF.Utils.Converters;assembly=VideoOS.UI.Common.WPF" xmlns:local="clr-namespace:VideoOS.ServerConfigurator.CertificateConfigurator.UI" xmlns:ctrl="clr-namespace:System.Windows.Controls;assembly=PresentationFramework" xmlns:resources="clr-namespace:VideoOS.ServerConfigurator.CertificateConfigurator.UI.Properties" Background="#FFFFFFFF">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="StyleDictionary.xaml" />
        <ResourceDictionary>
          <DataTemplate x:Key="{DataTemplateKey {x:Type local:CertificateGroupViewModel}}" x:Name="EntryTemplate" DataType="{x:Type local:CertificateGroupViewModel}">
            <local:CertificateGroupControl />
          </DataTemplate>
        </ResourceDictionary>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <AdornerDecorator>
    <ctrl:Grid>
      <ctrl:Grid.RowDefinitions>
        <ctrl:RowDefinition Height="auto" />
        <ctrl:RowDefinition Height="auto" />
        <ctrl:RowDefinition Height="auto" />
        <ctrl:RowDefinition Height="*" />
      </ctrl:Grid.RowDefinitions>
      <ctrl:Grid.ColumnDefinitions>
        <ctrl:ColumnDefinition Width="*" />
        <ctrl:ColumnDefinition Width="500" />
        <ctrl:ColumnDefinition Width="*" />
      </ctrl:Grid.ColumnDefinitions>
      <local:StatusMessageBar ctrl:Grid.Row="0" ctrl:Grid.ColumnSpan="3" />
      <ctrl:StackPanel ctrl:Grid.Row="1" ctrl:Grid.Column="1">
        <ctrl:TextBlock Name="RegistrationTitle" x:Uid="RegistrationTitle" Margin="0,24,0,0" Style="{StaticResource Title}" Text="{x:Static resources:Resources.ServerRegistrationControl_RegisteringServers}" />
        <ctrl:TextBlock Name="RegistrationSubtitle" x:Uid="RegistrationSubtitle" Style="{StaticResource Label2}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding RegisterTabText}" />
        <ctrl:TextBlock Margin="0,10,0,0" Style="{StaticResource Label2}" Visibility="{Binding LearnMoreAvailable, Converter={con:BoolToVisibilityConverter FalseValue=Collapsed, TrueValue=Visible}}">
          <Hyperlink x:Uid="RegistrationSubtitleHyperlink" Style="{StaticResource HyperLink}" AutomationProperties.AutomationId="RegistrationPage.RegistrationSubtitleHyperlink" Command="{Binding LearnMoreCommand}">
            <ctrl:TextBlock x:Uid="RegistrationSubtitleHyperlinkText" AutomationProperties.AutomationId="HyperlinkText" Text="{x:Static resources:Resources.ServerRegistrationControl_LearnMore}" />
          </Hyperlink>
        </ctrl:TextBlock>
      </ctrl:StackPanel>
      <ctrl:StackPanel Name="RegistrationInputPanel" ctrl:Grid.Row="2" ctrl:Grid.Column="1" x:Uid="RegistrationInputPanel" Margin="0,24,0,0">
        <ctrl:TextBlock Name="RegistrationInputDescription" x:Uid="RegistrationInputDescription" Style="{StaticResource Label}" Text="{x:Static resources:Resources.ServerRegistrationControl_ManagementServerAddress}" />
        <ctrl:Grid>
          <ctrl:TextBox Name="RegistrationInputTextBox" Style="{StaticResource HttpInput}" Margin="0,2,0,0" ctrl:Validation.ErrorTemplate="{StaticResource errorTemplate}" mvvm:TextBoxBehavior.ValidateOnTextChanged="true" IsEnabled="{Binding UseRemoteManagementServer}">
            <ctrl:TextBox.Text>
              <Binding Path="ManagementServerAddress">
                <Binding.ValidationRules>
                  <local:UriValidator />
                </Binding.ValidationRules>
              </Binding>
            </ctrl:TextBox.Text>
          </ctrl:TextBox>
          <ToggleButton Margin="0,10,8,8" HorizontalAlignment="Right" Style="{StaticResource ToggleTextInputFieldButton}" IsChecked="{Binding UseRemoteManagementServer}" Command="{Binding UseRemoteManagementServerCommand}" Visibility="{Binding IsLocalManagementServer, Converter={con:BoolToVisibilityConverter TrueValue=Visible, FalseValue=Hidden}}" />
        </ctrl:Grid>
        <ctrl:TextBlock x:Uid="ErrorMessage" Text="{x:Static resources:Resources.ServerRegistrationControl_InvalidManagementServerAddress}" Style="{StaticResource ErrorLabel}" Margin="0,2,0,0" Visibility="{Binding ElementName=RegistrationInputTextBox, Path=(ctrl:Validation.HasError), Converter={con:BoolToVisibilityConverter TrueValue=Visible, FalseValue=Hidden}}" />
      </ctrl:StackPanel>
      <ctrl:StackPanel Name="RegistrationButtonPanel" ctrl:Grid.Row="3" ctrl:Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,8,0,0">
        <ctrl:Button Name="RegistrationButton" x:Uid="RegistrationButton" Style="{StaticResource SecondaryButton2}" Content="{x:Static resources:Resources.ServerRegistrationControl_Register}" Command="{Binding RegisterCommand}" IsEnabled="{Binding ElementName=RegistrationInputTextBox, Path=(ctrl:Validation.HasError), Converter={con:NegationConverter}}" />
      </ctrl:StackPanel>
    </ctrl:Grid>
  </AdornerDecorator>
</ctrl:UserControl>