<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="VideoOS.Diagnostics.Logging" type="VideoOS.Diagnostics.Logging.Configuration.ConfigurationSectionHandler, VideoOS.Utilities.Telemetry" />
  </configSections>
  <appSettings>
    <!-- The share name that contains XPCO configuration backup files. -->
    <!-- This folder is created and shared by the server service installer and is always accessed as '\\{machineName}\{shareName}'. -->
    <add key="VideoOS.XPCO.BackupRestore.BackupShareName" value="!_XPCOBackupFolder" />
  </appSettings>
  <VideoOS.Diagnostics.Logging>
    <Logger name="Server">
      <Appender type="File" level="info" filename="~/Logs/Server.log" archive="~/Logs/Archive" maxsize="10" />
    </Logger>
    <Logger name="RecorderCommManager">
      <Appender type="File" level="info" filename="~/Logs/RecorderCommManager.log" archive="~/Logs/Archive" maxsize="10" />
    </Logger>
    <Logger name="SecurityTokenHandler">
      <Appender type="File" level="info" filename="~/Logs/SecurityTokenHandler.log" archive="~/Logs/Archive" maxsize="10" />
    </Logger>
    <Logger name="RuleSystem">
      <Appender type="File" level="info" filename="~/Logs/RuleSystem.log" archive="~/Logs/Archive" maxsize="10" />
    </Logger>
    <Logger name="TaskManager">
      <Appender type="File" level="info" filename="~/Logs/TaskManager.log" archive="~/Logs/Archive" maxsize="10" />
    </Logger>
    <Logger name="NotificationManager">
      <Appender type="File" level="info" filename="~/Logs/NotificationManager.log" archive="~/Logs/Archive" maxsize="10" />
    </Logger>
    <Logger name="SQLLog">
      <Appender type="File" level="info" filename="~/Logs/SQLLog.log" archive="~/Logs/Archive" maxsize="10" />
    </Logger>
    <Logger name="Performance">
      <Appender type="File" level="info" filename="~/Logs/Performance.log" archive="~/Logs/Archive" maxsize="5" />
    </Logger>
    <Logger name="RecorderStatus">
      <Appender type="File" level="info" filename="~/Logs/RecorderStatus.log" archive="~/Logs/Archive" maxsize="5" />
    </Logger>
    <Logger name="WebApi">
      <Appender type="File" level="info" filename="~/Logs/WebApi.log" archive="~/Logs/Archive" maxsize="10" />
    </Logger>
    <Logger name="Licensing">
      <Appender type="File" level="info" filename="~/Logs/Licensing.log" archive="~/Logs/Archive" maxsize="10" />
    </Logger>
    <Logger name="LegacyLogClient">
      <Appender type="File" level="info" filename="~/Logs/LegacyLogClient.log" archive="~/Logs/Archive" maxsize="10" />
    </Logger>
  </VideoOS.Diagnostics.Logging>
  <system.serviceModel>
    <services>
      <service behaviorConfiguration="DefaultHttpServiceBehavior" name="VideoOS.Server.ServerWebService">
        <endpoint address="" binding="wsHttpBinding" bindingConfiguration="DefaultHttpBinding" name="HttpServerWebService" contract="VideoOS.Server.IServerWebService">
          <identity>
            <servicePrincipalName value="host/localhost" />
          </identity>
        </endpoint>
        <endpoint address="mex" binding="mexHttpBinding" name="HttpMetadataExchange" contract="IMetadataExchange" />
      </service>
    </services>
    <bindings>
      <wsHttpBinding>
        <binding name="DefaultHttpBinding" closeTimeout="00:10:00" openTimeout="00:10:00" sendTimeout="00:10:00" messageEncoding="Text" maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647">
          <readerQuotas maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647" />
        </binding>
      </wsHttpBinding>
    </bindings>
    <behaviors>
      <serviceBehaviors>
        <behavior name="DefaultHttpServiceBehavior">
          <serviceDebug includeExceptionDetailInFaults="true" />
          <serviceMetadata httpGetEnabled="true" />
          <serviceThrottling maxConcurrentCalls="1000" maxConcurrentSessions="1000" maxConcurrentInstances="1000" />
          <dataContractSerializer maxItemsInObjectGraph="2147483647" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
  </system.serviceModel>
  <runtime>
    <!-- 
				Information from http://blogs.msdn.com/clyon/archive/2004/09/08/226981.aspx
				"Remember, on a single proc-machine, it’s Workstation. On a multi-proc where throughput is important, use Server. If there's user interaction, choose Concurrent.
				Default is Workstation."
				
				Two garbage collectors exists: server and workstation.
				
				It is better to use the server GC on machines with - multiple CPUs - when throughput is important.
				On single CPU machines the workstation GC should be used in "concurrent-mode" (see gcConcurrent below).
				
				So gcServer should be enabled for the recorder if running on a machine with multiple CPUs.
				
				When gcServer is enabled, it will override the value set with gcConcurrent which is a setting that only
				affects the workstation GC.
				-->
    <gcServer enabled="true" />
    <!--
						gcConcurrent can only be used with the workstation GC (see also description for gcServer above).
						
						Disabling gcConcurrent is best suited for server applications where the workstation GC are being used 
						due to a single processor CPU. Multiprocessor machines and the use of gcServer is preferred for better 
						throughput (i.e. the recorder where gcServer is disabled - see above).
						
						gcConcurrent is enabled for the workstation garbage collector by default - so always disable it for this 
						server process, just in case that the workstation GC is used.
				-->
    <gcConcurrent enabled="false" />
    <!-- Make sure that we have consistent behavior whether .NET 4.5 is installed or not -->
    <ThrowUnobservedTaskExceptions enabled="true" />
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
