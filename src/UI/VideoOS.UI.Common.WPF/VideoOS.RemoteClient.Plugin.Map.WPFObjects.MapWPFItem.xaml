<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary x:Class="VideoOS.RemoteClient.Plugin.Map.WPFObjects.MapWPFItem" x:ClassModifier="internal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options" xmlns:wpfobjects="clr-namespace:VideoOS.RemoteClient.Plugin.Map.WPFObjects;assembly=VideoOS.UI.Common.WPF">
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" PresentationOptions:Freeze="true" Color="LightSteelBlue" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" PresentationOptions:Freeze="true" Color="LightSteelBlue" />
  <Style TargetType="{x:Type ListViewItem}">
    <Setter Property="Height" Value="23" />
    <Setter Property="FontFamily" Value="Microsoft Sans Serif" />
    <Style.Triggers>
      <Trigger Property="ListBoxItem.IsSelected" Value="True">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>