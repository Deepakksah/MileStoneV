<?xml version="1.0" encoding="utf-8"?>
<recorderconfig>
	<!-- Version is set by the installer -->
	<version></version>
	<recorder>
		<id>C9CEF804-E600-4b4b-B5F9-BE246BB49133</id>
		<displayname>Local test recording server</displayname>
		<driverspath>../../../../../Drivers</driverspath>
		<mipdriverspath>../../../../../MIPDrivers</mipdriverspath>
		<pluginspath>../../../../../Plugins</pluginspath>
		<ruleactionspath>../../../../../RuleActions</ruleactionspath>
		
		<!-- garbagecollectinterval instructs the service to run a garbage collection with the specified interval (in milliseconds). 0 = never -->
		<garbagecollectinterval>0</garbagecollectinterval>
		<memoryloginterval>600000</memoryloginterval>
		<unmanagedmemorypressure>300</unmanagedmemorypressure>
		
		<!--
		minWorkerThreads :
				Value set as minimum worker threads for the .NET thread pool.
				Type    : System.Int32
				Range   : 0 - 1000
				Default : 200
				If setting til value to 0 (zero) the .NET default will be used (nothing will be applied).

		minCompletionPortThreads : 
				Value set as minimum IO Completion port  threads for the .NET thread pool.
				Type    : System.Int32
				Range   : 0 - 1000
				Default : 0
				If setting til value to 0 (zero) the .NET default will be used (nothing will be applied).
		-->
		<threadpool minWorkerThreads="20" minCompletionPortThreads="0" />

		<!--
		maxDelay : Specifies the maximum time in millisconds to use when generating a random delay in the 
							 hardware startup procedure. Normally this should be 0 but some networks experience 
							 problems when initiating many simultanious connections which is done on recorder startup
							 where all hardware is started in parallel.
							 In such a case it could help to set this value to e.g. one or two seconds to avoid 
							 connection timeouts and thereby a 30 seconds delay due to the retry mechanism.
									Type    : System.Int32
									Range   : 0 - 10000
									Default : 0
		-->
		<hardwarestartup maxDelay="0" />
		
		<!--
		The shutdown procedure is initiated when the service is stopped or restarted either via the Service Control Manager or by a user or system initiated
		restart or shutdown.
		maxTimeToWait : 
			Specifies the maximum time in minutes to wait for the service to complete a gracefull 
			shutdown. When the maxTimeToWait interval has elapsed the service is forcefully closed.
				Type    : System.Int32
				Range   : 1 - Int32.MaxValue 
				Defalut : 60
		-->
		<shutdownProcedure maxTimeToWait="60" />
		<ClientRegistrationId/>
		<serverEncryption enabled="false" certificateHash=""/>

		<!--
		maxVideoStreamsPerProxy: 
			For interop drivers, specifies the maximum number of video streams allowed per proxy server. 
			New proxy server instances will be created dynamically until there are enough proxy servers to host all interop hardware devices.
				Type     : System.Int32
				Range    : 1 - Int32.MaxValue
				Default  : 100
		-->
		<proxyServerSplitting maxVideoStreamsPerProxy="100"/>
	</recorder>

	<server>
		<address>localhost</address>
		<webapiport>9000</webapiport>
		<authorizationserveraddress/>
		<logenabled>true</logenabled>
		<logbundleinterval>5000</logbundleinterval>
		<logbundlemaxcount>100</logbundlemaxcount>
		<configversioncheckinterval>3600000</configversioncheckinterval>
		<sendstatustoserverinterval>300000</sendstatustoserverinterval>
	</server>

	<webapi>
		<port>9001</port>
		<publicUri>localhost:9001</publicUri>
		<timeoutfraction>2</timeoutfraction>
	</webapi>

	<pipeline>
		<!--
			Specifies the maximum number of frames allowed in a gop.
			Type    : System.Int32
			Range   : 1 - 10000
			Default : 5000
		-->
		<gopframecountlimit>5000</gopframecountlimit>

		<!--
			Specifies the maximum size, in bytes, allowed for a gop.
			Type    : System.Int32
			Range   : 1048576 - 31457280 (1 MB - 30 MB)
			Default : 20*1024*1024
		-->
		<gopbytecountlimit>20971520</gopbytecountlimit>

		<!--
			Specifies the maximum allowed timespan for a gop.
			Type    : System.Int32
			Range   : 1000 - 600000 (1 sec - 10 minutes)
			Default : 300000 (5 minutes)
		-->
		<goptimespanlimit>300000</goptimespanlimit>

		<!--
			Specifies the timespan of audio frames to put into same gop.
			Type    : System.Int32
			Range   : 1 - 30000 (1 millisec - 30 seconds)
			Default : 1000 (1 second)
		-->
		<audiogoptimespan>1000</audiogoptimespan>

		<!--
			Specifies the timespan of metadata frames to put into same gop.
			Type    : System.Int32
			Range   : 1 - 30000 (1 millisec - 30 seconds)
			Default : 1000 (1 second)
		-->
		<metadatagoptimespan>1000</metadatagoptimespan>

		<!--
			Specifies audio burst delay
			Type    : System.Int32
			Range   : 0 - 100 (no delay - 100 milliseconds)
			Default : 5 (5 milliseconds)
		-->
		<audioburstdelay>5</audioburstdelay>

		<liveThread maxStackSizeKB="256" />
		<processingThread maxStackSizeKB="256" />

		<!--
			Specifies the maximun number of frames in the queue, both key- and nonkey-frames (H264 and MPEG limit primarily).
			Type    : System.Int32
			Range   : 20 - 200 (recomended limits)
			Default : 50
		-->
		<maxframesinqueue>50</maxframesinqueue>

		<!--
			Specifies the maximum size, in bytes, allowed in the queue.
			Type    : System.Int32
			Range   : 1048576 - 104857600 (1 MB - 100 MB, recomended limits)
			Default : 30*1024*1024
		-->
		<maxbytesinqueue>31457280</maxbytesinqueue>

		<!--
			Specifies the maximum time pipeline part 2 is allowed to be active.
			Type    : System.Int32
			Range   : 0 (no check), 30000 - 3600000 (30 sec - 60 min)
			Default : 600000 (10 min)
		-->
		<maxactivetimepipeline2>600000</maxactivetimepipeline2>
	
	</pipeline>

	<database>
		<database_server>
			<logging>
				<path/>
				<prefix>Database</prefix>
				<days_to_keep>30</days_to_keep>
				<max_size>10485760</max_size>
			</logging>
			<table_database>
				<path/>
				<pragmas>
					<!--Note: Pragma values may not be verified! Make sure you have entered valid pragma values-->
					<!--The following pragmas are only applied to new databases. Existing databases run with the pragmas
					when they were created.-->
					<!--For pragma reference visit: https://www.sqlite.org/pragma.html-->

					<!--For better performance we recommend setting page_size value to 65536 and auto_vacuum value to NONE-->
					<!--Database pragmas-->
					<!--Pragmas page_size and auto_vacuum are part of database pragmas which means these two are set during database creation only 
					and the rest of the pragmas are set per connection-->
					<pragma name="page_size" value ="65536"/>
					<pragma name="auto_vacuum" value ="NONE"/>

					<!--Connection pragmas-->
					<!--Synchronous and journal_mode pragmas are mandatory, application will not run if they are not present in the config.-->
					<!--Accepted journal_mode values are DELETE or TRUNCATE or PERSIST, application will not run if the values are different than these three.-->
					<pragma name="journal_mode" value ="TRUNCATE"/>
					<!--Accepted synchronous values are FULL Or EXTRA, application will not run if the values are different than these two.-->
					<pragma name="synchronous" value ="FULL"/>
				</pragmas>
			</table_database>
			<socket_communication>
				<port_number>5210</port_number>
				<authentication>
					<anonymous>
						<enable>false</enable>
					</anonymous>
					<token>
