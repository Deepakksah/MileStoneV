<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls" xmlns:converters="clr-namespace:VideoOS.Platform.UI.Converters" xmlns:ui="clr-namespace:VideoOS.Platform.UI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/VideoOS.Platform;component/UI/Controls/VideoOSBase.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Type controls:VideoOSCheckBoxLarge}" BasedOn="{StaticResource {x:Static controls:VideoOSBaseInternals.StyleKey}}" TargetType="{x:Type controls:VideoOSCheckBoxLarge}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:VideoOSCheckBoxLarge}">
          <BulletDecorator Background="#00FFFFFF" SnapsToDevicePixels="True">
            <BulletDecorator.Bullet>
              <Border Height="32" Width="32" CornerRadius="2" BorderThickness="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={converters:BoolToDoubleConverter TrueResult=0, FalseResult=2}}">
                <Border.BorderBrush>
                  <MultiBinding Converter="{x:Static controls:VideoOSCheckBoxBaseInternals.OutlineBrushConverter}">
                    <Binding Path="." RelativeSource="{RelativeSource Self}" />
                    <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="IsPressed" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
                  </MultiBinding>
                </Border.BorderBrush>
                <Border.Background>
                  <MultiBinding Converter="{x:Static controls:VideoOSCheckBoxBaseInternals.BackgroundBrushConverter}">
                    <Binding Path="." RelativeSource="{RelativeSource Self}" />
                    <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="IsPressed" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="IsChecked" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
                  </MultiBinding>
                </Border.Background>
                <controls:VideoOSIcon Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" IconSource="{controls:VideoOSIconBuiltInSource Checkmark}">
                  <controls:VideoOSIcon.AutoColorBrush>
                    <MultiBinding Converter="{x:Static controls:VideoOSCheckBoxBaseInternals.TickBrushConverter}">
                      <Binding Path="." RelativeSource="{RelativeSource Self}" />
                      <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                      <Binding Path="IsPressed" RelativeSource="{RelativeSource TemplatedParent}" />
                      <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                      <Binding Path="IsChecked" RelativeSource="{RelativeSource TemplatedParent}" />
                      <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
                    </MultiBinding>
                  </controls:VideoOSIcon.AutoColorBrush>
                </controls:VideoOSIcon>
              </Border>
            </BulletDecorator.Bullet>
            <controls:VideoOSTextBlockBodyMedium Text="{TemplateBinding ContentControl.Content}" Margin="8,0,0,0" Appearance="HighEmphasis" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MinLines="{TemplateBinding controls:VideoOSCheckBoxBase.MinLines}" MaxLines="{TemplateBinding controls:VideoOSCheckBoxBase.MaxLines}" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={converters:StringNullOrEmptyToVisibilityConverter NullOrEmptyResult=Collapsed, NotNullOrEmptyResult=Visible}}" />
          </BulletDecorator>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>