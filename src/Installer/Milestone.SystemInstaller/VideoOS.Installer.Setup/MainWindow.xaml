<Window x:Class="VideoOS.Installer.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Milestone XProtect VMS Products 2025 R3 System Installer"
        Width="600"
        Height="200"
        WindowStartupLocation="CenterScreen"
        Background="White"
        ShowInTaskbar="True"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize">
    <Grid Background="White">
        <StackPanel Orientation="Vertical" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Stretch" 
                    Margin="20">
            <!-- Status Text -->
            <TextBlock x:Name="StatusTextBlock"
                       Text="{Binding StatusProgressState, Mode=OneWay}"
                       FontSize="14"
                       Margin="0,0,0,10"
                       Foreground="#333333"
                       TextWrapping="Wrap"
                       MinHeight="40"/>

            <!-- Progress Bar -->
            <ProgressBar x:Name="ProgressBarControl"
                         Height="25"
                         Value="{Binding ProgressBarProgress, Mode=OneWay}"
                         Minimum="0"
                         Maximum="100"
                         Foreground="#0078D4"
                         Background="#E8E8E8"/>

            <!-- Progress Percentage Text -->
            <TextBlock x:Name="PercentageTextBlock"
                       Text="{Binding ProgressBarProgress}"
                       FontSize="12"
                       Margin="0,5,0,0"
                       Foreground="#666666"
                       TextAlignment="Right"/>
        </StackPanel>
    </Grid>
</Window>