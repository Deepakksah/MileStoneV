<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.UI.Common.WPF.SplitButton.ItemSelectionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mvvm="clr-namespace:VideoOS.UI.Common.WPF.Utils.MvvmHelpers" xmlns:splitbutton="clr-namespace:VideoOS.UI.Common.WPF.SplitButton">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="DefaultBackgroundBrush" PresentationOptions:Freeze="true" Color="Transparent" />
      <LinearGradientBrush x:Key="MouseOverBackgroundBrush" PresentationOptions:Freeze="true" EndPoint="0.5,1" StartPoint="0.5,0.0">
        <GradientStop Color="#FFD7EFF3" Offset="0" />
        <GradientStop Color="#FFAEDCEC" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="SelectedBackgroundBrush" PresentationOptions:Freeze="true" EndPoint="0.5,1" StartPoint="0.5,0.0">
        <GradientStop Color="#FFC7DFE3" Offset="0" />
        <GradientStop Color="#FF7EACBC" Offset="1" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="DefaultBorderBrush" PresentationOptions:Freeze="true" Color="Transparent" />
      <SolidColorBrush x:Key="MouseOverBorderBrush" PresentationOptions:Freeze="true" Color="#FFA2B2C1" />
      <SolidColorBrush x:Key="SelectedBorderBrush" PresentationOptions:Freeze="true" Color="#FF8292A1" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ListBox Name="_itemListBox" Background="#00FFFFFF" SelectionChanged="_itemListBox_SelectionChanged">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" PresentationOptions:Freeze="true" Color="Transparent" />
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <ItemsControl.ItemContainerStyle>
      <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      </Style>
    </ItemsControl.ItemContainerStyle>
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <Border Name="_itemBorder" BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Border}">
              <Setter Property="Background" Value="{StaticResource DefaultBackgroundBrush}" />
              <Setter Property="BorderBrush" Value="{StaticResource DefaultBorderBrush}" />
              <Style.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Background" Value="{StaticResource MouseOverBackgroundBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource MouseOverBorderBrush}" />
                </Trigger>
                <DataTrigger Value="True" Binding="{Binding Selected}">
                  <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource SelectedBorderBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <StackPanel Orientation="Horizontal" Margin="5">
            <Image Source="{mvvm:BindingResource ResourceKeyBinding={Binding Path=SplitButtonItem.ImageName}}" Visibility="{Binding Path=SplitButtonItem.ImageFromNameVisibility}" />
            <Image Source="{Binding Path=SplitButtonItem.ImageSource}" Visibility="{Binding Path=SplitButtonItem.ImageFromSourceVisibility}" />
            <Rectangle Width="5" />
            <TextBlock Text="{Binding Path=SplitButtonItem.Label}" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
          </StackPanel>
        </Border>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ListBox>
</UserControl>