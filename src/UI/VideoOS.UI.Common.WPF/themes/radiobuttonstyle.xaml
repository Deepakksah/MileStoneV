<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VideoOS.UI.Common.WPF.Controls">
  <Style x:Key="{x:Type controls:VideoOSRadioButton}" TargetType="{x:Type controls:VideoOSRadioButton}" BasedOn="{StaticResource {x:Type RadioButton}}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderBrush" Value="{DynamicResource VideoOSRadioButtonEnabledInactiveBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource VideoOSCommonForeground}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="controls:VideoOSRadioButton.BulletFillBrush" Value="{DynamicResource VideoOSRadioButtonEnabledActiveBrush}" />
    <Setter Property="FrameworkElement.FocusVisualStyle">
      <Setter.Value>
        <Style>
          <Setter Property="Control.Template">
            <Setter.Value>
              <ControlTemplate>
                <Rectangle Margin="-2" SnapsToDevicePixels="true" StrokeThickness="1" RadiusX="2" RadiusY="2" Stroke="{DynamicResource VideoOSFocusBorderBrush}" />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:VideoOSRadioButton}">
          <Grid Name="templateRoot" Background="#00FFFFFF" SnapsToDevicePixels="True" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Name="radioButtonBorder" CornerRadius="100" Margin="1,1,8,1" Height="16" Width="16" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}">
              <Ellipse Name="optionMark" Margin="2" Width="8" Height="8" Opacity="0" Fill="{TemplateBinding controls:VideoOSRadioButton.BulletFillBrush}" />
            </Border>
            <controls:VideoOSTextBlockBody1 x:Name="radioButtonText" Grid.Column="1" Focusable="False" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" Foreground="{TemplateBinding Control.Foreground}" Margin="{TemplateBinding Control.Padding}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Text="{TemplateBinding ContentControl.Content}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="HasContent" Value="false">
              <Setter TargetName="radioButtonText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="true">
              <Setter TargetName="optionMark" Property="UIElement.Opacity" Value="1" />
              <Setter Value="{DynamicResource VideoOSRadioButtonEnabledActiveBrush}" Property="BorderBrush" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="true">
              <Setter Value="{DynamicResource VideoOSRadioButtonHoverActiveBrush}" Property="BorderBrush" />
              <Setter Value="{DynamicResource VideoOSRadioButtonHoverActiveBrush}" Property="controls:VideoOSRadioButton.BulletFillBrush" />
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
              <Setter Value="{DynamicResource VideoOSRadioButtonPressedActiveBrush}" Property="BorderBrush" />
              <Setter Value="{DynamicResource VideoOSRadioButtonPressedActiveBrush}" Property="controls:VideoOSRadioButton.BulletFillBrush" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
              <Setter Value="{DynamicResource VideoOSRadioButtonDisabledActiveBrush}" Property="BorderBrush" />
              <Setter Value="{DynamicResource VideoOSRadioButtonDisabledForeground}" Property="Foreground" />
              <Setter Value="{DynamicResource VideoOSRadioButtonDisabledActiveBrush}" Property="controls:VideoOSRadioButton.BulletFillBrush" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="UIElement.IsMouseOver" Value="true" />
                <Condition Property="ToggleButton.IsChecked" Value="false" />
              </MultiTrigger.Conditions>
              <Setter Value="{DynamicResource VideoOSRadioButtonHoverInactiveBrush}" Property="BorderBrush" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsPressed" Value="true" />
                <Condition Property="ToggleButton.IsChecked" Value="false" />
              </MultiTrigger.Conditions>
              <Setter Value="{DynamicResource VideoOSRadioButtonPressedInactiveBrush}" Property="BorderBrush" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsEnabled" Value="false" />
                <Condition Property="ToggleButton.IsChecked" Value="false" />
              </MultiTrigger.Conditions>
              <Setter Value="{DynamicResource VideoOSRadioButtonDisabledInactiveBrush}" Property="BorderBrush" />
            </MultiTrigger>
            <Trigger Property="ToggleButton.IsChecked" Value="{x:Null}">
              <Setter TargetName="optionMark" Property="UIElement.Opacity" Value="0.56" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>