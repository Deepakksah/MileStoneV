<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="VideoOS.UI.Common.WPF.DisableAlarm.DisableWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Resources="clr-namespace:VideoOS.UI.Common.WPF.Resources" MinWidth="500" MinHeight="250" ShowInTaskbar="True" Title="{x:Static Resources:Strings.DisableAlarmsManageWindowTitle}" SizeToContent="WidthAndHeight" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen" xmlns:disablealarm="clr-namespace:VideoOS.UI.Common.WPF.DisableAlarm" DataContext="{Binding RelativeSource={RelativeSource Self}}" Closing="Window_Closing">
  <Grid>
    <ListView Name="_disableListView" ItemsSource="{Binding ObservableDisableCollection}" ContextMenuOpening="_disableListView_ContextMenuOpening" MouseDoubleClick="_disableListView_MouseDoubleClick" SelectionChanged="_disableListView_SelectionChanged">
      <ListView.View>
        <GridView>
          <GridViewColumn Width="100" DisplayMemberBinding="{Binding Time}">
            <GridViewColumn.Header>
              <GridViewColumnHeader HorizontalContentAlignment="Left" Content="{Binding StrResDisableTimeOut}" />
            </GridViewColumn.Header>
          </GridViewColumn>
          <GridViewColumn Width="200" DisplayMemberBinding="{Binding Events}">
            <GridViewColumn.Header>
              <GridViewColumnHeader HorizontalContentAlignment="Left" Content="{Binding StrResDisableEvents}" />
            </GridViewColumn.Header>
          </GridViewColumn>
          <GridViewColumn Width="200" DisplayMemberBinding="{Binding Source}">
            <GridViewColumn.Header>
              <GridViewColumnHeader HorizontalContentAlignment="Left" Content="{Binding StrResDisableSource}" />
            </GridViewColumn.Header>
          </GridViewColumn>
        </GridView>
      </ListView.View>
    </ListView>
  </Grid>
</Window>