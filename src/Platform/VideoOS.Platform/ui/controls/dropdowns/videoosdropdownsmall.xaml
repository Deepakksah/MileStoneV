<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls" xmlns:ui="clr-namespace:VideoOS.Platform.UI" xmlns:converters="clr-namespace:VideoOS.Platform.UI.Converters" xmlns:internal="clr-namespace:VideoOS.Platform.UI.Controls.DropDowns.Internal">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/VideoOS.Platform;component/UI/Controls/DropDowns/VideoOSDropDownBase.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Type controls:VideoOSDropDownSmall}" BasedOn="{StaticResource {x:Type controls:VideoOSDropDownBase}}" TargetType="{x:Type controls:VideoOSDropDownSmall}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:VideoOSDropDownSmall}">
          <Border CornerRadius="2" Height="24" BorderThickness="1" SnapsToDevicePixels="True">
            <Border.BorderBrush>
              <MultiBinding Converter="{x:Static controls:VideoOSDropDownBorderedBaseInternals.BorderBrushConverter}">
                <Binding Path="." RelativeSource="{RelativeSource Self}" />
                <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="IsOpen" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="IsFocused" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="State" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
              </MultiBinding>
            </Border.BorderBrush>
            <Border.Background>
              <MultiBinding Converter="{x:Static controls:VideoOSDropDownBaseInternals.BackgroundBrushConverter}">
                <Binding Path="." RelativeSource="{RelativeSource Self}" />
                <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="IsOpen" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
              </MultiBinding>
            </Border.Background>
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <controls:VideoOSIcon x:Name="_selectedItemIcon" Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" Margin="8,1,0,0" IconSource="{internal:SelectedItemIconSource}" AutoColorBrush="{Binding ElementName=_selectedItemText, Path=Foreground}" Visibility="{Binding Path=IconSource, RelativeSource={RelativeSource Self}, Converter={converters:NullToVisibilityConverter NullResult=Collapsed, NotNullResult=Visible}}" />
              <ContentControl Name="_customContent" Grid.Column="1" VerticalContentAlignment="Center" Margin="8,0,0,0" Content="{internal:SelectedItemCustomContentData}" ContentTemplate="{internal:SelectedItemContentTemplate}">
                <UIElement.Visibility>
                  <MultiBinding Converter="{x:Static controls:VideoOSDropDownBaseInternals.CustomContentVisibilityConverter}">
                    <Binding Path="SelectedItems" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="ItemContentTemplatePropertyName" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="ContentTemplate" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="CustomDisplayValue" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding>
                </UIElement.Visibility>
              </ContentControl>
              <controls:VideoOSTextBlockBodySmall x:Name="_selectedItemText" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" Text="{internal:SelectedItemData}" Visibility="{Binding ElementName=_customContent, Path=Visibility, Converter={converters:EnumToVisibilityConverter MatchValue={x:Static Visibility.Visible}, MatchedResult=Collapsed, NotMatchedResult=Visible}}">
                <controls:VideoOSTextBlockBodySmall.Appearance>
                  <MultiBinding Converter="{x:Static controls:VideoOSDropDownSmallInternals.SelectedItemTextAppearanceConverter}">
                    <Binding Path="SelectedItem" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="CustomDisplayValue" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding>
                </controls:VideoOSTextBlockBodySmall.Appearance>
              </controls:VideoOSTextBlockBodySmall>
              <controls:VideoOSIcon Grid.Column="2" Width="16" Height="16" Margin="8,0" VerticalAlignment="Center" AutoColorBrush="{Binding ElementName=_selectedItemText, Path=Foreground}" IconSource="{Binding Path=IsOpen, RelativeSource={RelativeSource TemplatedParent}, Converter={converters:BoolToVideoOSIconBuiltInSourceConverter TrueResult=Chevron_Up, FalseResult=Chevron_Down}}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>