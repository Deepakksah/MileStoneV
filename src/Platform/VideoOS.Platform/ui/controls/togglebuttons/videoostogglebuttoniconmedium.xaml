<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls" xmlns:ui="clr-namespace:VideoOS.Platform.UI" xmlns:converters="clr-namespace:VideoOS.Platform.UI.Converters">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/VideoOS.Platform;component/UI/Controls/VideoOSBase.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Type controls:VideoOSToggleButtonIconMedium}" BasedOn="{StaticResource {x:Static controls:VideoOSBaseInternals.StyleKey}}" TargetType="{x:Type controls:VideoOSToggleButtonIconMedium}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:VideoOSToggleButtonIconMedium}">
          <Border Name="_toggleButtonContent" Height="32" Width="32" CornerRadius="2" SnapsToDevicePixels="True" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" BorderThickness="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={converters:BoolToDoubleConverter TrueResult=2, FalseResult=0}}">
            <Border.BorderBrush>
              <MultiBinding Converter="{x:Static controls:VideoOSIconSourceBaseInternals.OutlineBrushConverter}">
                <Binding Path="." RelativeSource="{RelativeSource Self}" />
                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="IsPressed" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="IsChecked" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
              </MultiBinding>
            </Border.BorderBrush>
            <Border.Background>
              <MultiBinding Converter="{x:Static controls:VideoOSIconSourceBaseInternals.BackgroundBrushConverter}">
                <Binding Path="." RelativeSource="{RelativeSource Self}" />
                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="IsPressed" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="IsChecked" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
              </MultiBinding>
            </Border.Background>
            <controls:VideoOSIcon Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" IconSource="{TemplateBinding controls:VideoOSToggleButtonIconBase.IconSource}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>