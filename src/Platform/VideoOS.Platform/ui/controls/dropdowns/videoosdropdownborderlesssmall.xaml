<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls" xmlns:converters="clr-namespace:VideoOS.Platform.UI.Converters" xmlns:extensions="clr-namespace:VideoOS.Platform.UI.Extensions" xmlns:internal="clr-namespace:VideoOS.Platform.UI.Controls.DropDowns.Internal">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/VideoOS.Platform;component/UI/Controls/DropDowns/VideoOSDropDownBase.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Type controls:VideoOSDropDownBorderlessSmall}" BasedOn="{StaticResource {x:Type controls:VideoOSDropDownBase}}" TargetType="{x:Type controls:VideoOSDropDownBorderlessSmall}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:VideoOSDropDownBorderlessSmall}">
          <Grid Name="PART_TextAndChevron" VerticalAlignment="Center" HorizontalAlignment="Left" Background="#00FFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:VideoOSIcon x:Name="_selectedItemIcon" Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" Margin="0,1,0,0" IconSource="{internal:SelectedItemIconSource}" AutoColorBrush="{Binding ElementName=_selectedItemText, Path=Foreground}" Visibility="{Binding Path=IconSource, RelativeSource={RelativeSource Self}, Converter={converters:NullToVisibilityConverter NullResult=Collapsed, NotNullResult=Visible}}" />
            <Grid Column="1">
              <ContentControl Name="_customContent" VerticalContentAlignment="Center" Margin="{Binding ElementName=_selectedItemIcon, Path=IconSource, Converter={converters:NullToThicknessConverter NullResult=0,0,0,0, NotNullResult=8,0,0,0}}" Content="{internal:SelectedItemCustomContentData}" ContentTemplate="{internal:SelectedItemContentTemplate}" internal:VideoOSDropDownAttachedProperties.ContentForeground="{Binding ElementName=_selectedItemText, Path=Foreground}">
                <UIElement.Visibility>
                  <MultiBinding Converter="{x:Static controls:VideoOSDropDownBaseInternals.CustomContentVisibilityConverter}">
                    <Binding Path="SelectedItems" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="ItemContentTemplatePropertyName" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="ContentTemplate" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="CustomDisplayValue" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding>
                </UIElement.Visibility>
              </ContentControl>
              <controls:VideoOSTextBlockInteractiveSmall x:Name="_selectedItemText" VerticalAlignment="Center" Margin="{Binding ElementName=_selectedItemIcon, Path=IconSource, Converter={converters:NullToThicknessConverter NullResult=0,0,0,0, NotNullResult=8,0,0,0}}" Text="{internal:SelectedItemData}" Visibility="{Binding ElementName=_customContent, Path=Visibility, Converter={converters:EnumToVisibilityConverter MatchValue={x:Static Visibility.Visible}, MatchedResult=Collapsed, NotMatchedResult=Visible}}">
                <controls:VideoOSTextBlockInteractiveSmall.Appearance>
                  <MultiBinding Converter="{x:Static controls:VideoOSDropDownBorderlessSmallInternals.SelectedItemTextAppearanceConverter}">
                    <Binding Path="IsOpen" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding>
                </controls:VideoOSTextBlockInteractiveSmall.Appearance>
                <controls:VideoOSTextBlockInteractiveSmall.InteractiveState>
                  <MultiBinding Converter="{x:Static controls:VideoOSDropDownBorderlessSmallInternals.SelectedItemTextInteractiveStateConverter}">
                    <Binding Path="IsOpen" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="(extensions:DependencyObjectAttachedProperties.IsMouseLeftButtonDown)" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding>
                </controls:VideoOSTextBlockInteractiveSmall.InteractiveState>
              </controls:VideoOSTextBlockInteractiveSmall>
            </Grid>
            <controls:VideoOSIcon Grid.Column="2" Width="12" Height="12" Margin="8,0,0,0" VerticalAlignment="Center" AutoColorBrush="{Binding ElementName=_selectedItemText, Path=Foreground}" IconSource="{Binding Path=IsOpen, RelativeSource={RelativeSource TemplatedParent}, Converter={converters:BoolToVideoOSIconBuiltInSourceConverter TrueResult=Chevron_Up_12px, FalseResult=Chevron_Down_12px}}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>