<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="ScRtlImage" TargetType="{x:Type Image}">
    <Setter Property="UIElement.RenderTransformOrigin" Value="0.5,0.5" />
    <Style.Triggers>
      <DataTrigger Value="RightToLeft" Binding="{Binding FlowDirection, RelativeSource={RelativeSource Self}}">
        <Setter Property="RenderTransform">
          <Setter.Value>
            <ScaleTransform ScaleX="-1" />
          </Setter.Value>
        </Setter>
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>