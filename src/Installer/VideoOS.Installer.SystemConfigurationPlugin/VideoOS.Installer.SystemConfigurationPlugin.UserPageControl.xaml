<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.Installer.SystemConfigurationPlugin.UserPageControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resx="clr-namespace:VideoOS.Installer.SystemConfigurationPlugin.Properties" xmlns:local="clr-namespace:VideoOS.Installer.SystemConfigurationPlugin" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" x:Name="This">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../ResourceDictionary.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <local:DictionaryValueConverter x:Key="dictionaryValueConverter" />
      <local:SolidBorderBrushNullConverter x:Key="solidBorderBrushNullConverter" />
      <local:StringNullOrEmptyToVisibilityConverter x:Key="stringNullOrEmptyToVisibilityConverter" />
      <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="10pt" />
        <Setter Property="FontFamily" Value="Tahoma" />
        <Setter Property="Foreground" Value="#FF000000" />
      </Style>
      <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#FF000000" />
        <Setter Property="FontSize" Value="10pt" />
        <Setter Property="FontFamily" Value="Tahoma" />
      </Style>
      <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="#FF000000" />
        <Setter Property="FontSize" Value="12pt" />
        <Setter Property="FontFamily" Value="Tahoma" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="58, 40, 58, 0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="160" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock Name="LabelHeadLine" AutomationProperties.AutomationId="LabelHeadLine" Style="{StaticResource HeaderTextBlockStyle}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" TextWrapping="Wrap" Margin="0" Grid.Row="0" Text="{Binding LabelHeadline}" />
    <TextBlock Name="LabelInfo" AutomationProperties.AutomationId="LabelInfo" TextWrapping="Wrap" Grid.Row="2" Style="{StaticResource HeaderInfoTextBlockStyle}" Text="{Binding LabelInfo}" />
    <Border BorderThickness="1" BorderBrush="#5d5d5d" Grid.Row="4">
      <Grid Row="4" Background="#ebebeb">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="125" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="10" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="3" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="15" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="3" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="3" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Name="UserTypeLabel" Margin="10,0,5,0" FontWeight="Bold" Grid.Row="1" Text="{Binding UserTypeLabel}" />
        <ComboBox Name="UserTypeComboBox" Grid.Row="3" Margin="10,0,5,0" VerticalContentAlignment="Center" DisplayMemberPath="Value" SelectedValuePath="Key" Height="22" TabIndex="0" FontFamily="Tahoma" SelectedItem="{Binding SelectedUserType, Converter={StaticResource dictionaryValueConverter}}" ItemsSource="{Binding Path=UserTypeMapping}" SelectedIndex="{Binding SelectedUserTypeIndex, Mode=OneTime}">
          <behaviors:Interaction.Triggers xmlns:behaviors="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors">
            <behaviors:EventTrigger xmlns:behaviors="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors" behaviors:EventTrigger.EventName="SelectionChanged">
              <behaviors:InvokeCommandAction behaviors:InvokeCommandAction.Command="{Binding UserTypeSelectionChangedCommand}" behaviors:InvokeCommandAction.CommandParameter="{Binding ElementName=This}" />
            </behaviors:EventTrigger>
          </behaviors:Interaction.Triggers>
        </ComboBox>
        <TextBlock Name="PasswordLabel" Grid.Row="5" FontSize="10pt" Margin="10,0,5,0" FontWeight="Bold" Text="{Binding PasswordLabel}" />
        <PasswordBox Name="UserPasswordBox" Grid.Row="7" Margin="10,0,5,0" Height="22" Padding="3,0,3,0" VerticalAlignment="Center" VerticalContentAlignment="Center" FontFamily="Tahoma" TabIndex="3" IsEnabled="{Binding PasswordFieldsEnabled}" BorderBrush="{Binding PasswordBorderBrush, Converter={StaticResource solidBorderBrushNullConverter}}">
          <Interaction.Triggers xmlns="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors">
            <EventTrigger p13:EventTrigger.EventName="PasswordChanged" xmlns:p13="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors">
              <p13:InvokeCommandAction p13:InvokeCommandAction.Command="{Binding PasswordChangedCommand}" />
            </EventTrigger>
          </Interaction.Triggers>
        </PasswordBox>
        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="3" Margin="10,2,120,2" Grid.Row="9" Height="40" VerticalAlignment="Center" Visibility="{Binding ErrorMessage, Converter={StaticResource stringNullOrEmptyToVisibilityConverter}}">
          <Image Source="Resources/error_10x10.png" Height="10" Width="10" />
          <TextBlock Name="_errorMessage" Margin="2,0,0,0" FontSize="8pt" VerticalAlignment="Center" Width="350" TextWrapping="Wrap" Text="{Binding ErrorMessage}" Foreground="{Binding ErrorColor}" />
        </StackPanel>
        <TextBlock Name="UserNameLabel" Grid.Column="1" Grid.Row="1" Margin="5,0,5,0" FontWeight="Bold" Text="{Binding UserNameLabel}" />
        <local:UserNameTextBoxWithButton Grid.Column="1" Grid.Row="3" Margin="5,0,5,0" Height="22" IsTabStop="False" KeyboardNavigation.TabIndex="0" FontFamily="Tahoma" />
        <TextBlock Name="RepeatPasswordLabel" Grid.Column="1" Grid.Row="5" Grid.ColumnSpan="2" Margin="5,0,10,0" FontWeight="Bold" Text="{Binding RepeatPasswordLabel}" />
        <PasswordBox Name="UserPasswordRepeatBox" Grid.Column="1" Grid.Row="7" Margin="5,0,5,0" Height="22" Padding="3,0,3,0" VerticalContentAlignment="Center" FontFamily="Tahoma" TabIndex="4" IsEnabled="{Binding PasswordFieldsEnabled}" BorderBrush="{Binding PasswordRepeatBorderBrush, Converter={StaticResource solidBorderBrushNullConverter}}">
          <Interaction.Triggers xmlns="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors">
            <EventTrigger p13:EventTrigger.EventName="PasswordChanged" xmlns:p13="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors">
              <p13:InvokeCommandAction p13:InvokeCommandAction.Command="{Binding PasswordChangedCommand}" />
            </EventTrigger>
          </Interaction.Triggers>
        </PasswordBox>
        <TextBlock Name="RoleLabel" Grid.Column="2" Grid.Row="1" Margin="5,0,10,0" FontWeight="Bold" Text="{Binding RoleLabel}" />
        <ComboBox Name="roleComboBox" Grid.Column="2" Grid.Row="3" VerticalContentAlignment="Center" Margin="5,0,10,0" Height="22" TabIndex="2" FontFamily="Tahoma" ItemsSource="{Binding Roles}" SelectedValue="{Binding SelectedRole}" />
        <Button Name="AddButton" Grid.Row="9" Grid.Column="2" IsDefault="True" Margin="5,5,10,5" Height="22" Width="70" HorizontalAlignment="Right" TabIndex="5" FontSize="12" Content="{Binding AddButton}" Command="{Binding AddUserCommand}" CommandParameter="{Binding ElementName=This}" />
      </Grid>
    </Border>
    <Border BorderThickness="1 0 1 1" BorderBrush="#FF000000" Grid.Row="5" Background="#FFFFFFFF" Height="100" VerticalAlignment="Top" Visibility="{Binding IsUserAdded, Converter={StaticResource boolToVisConverter}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="25" />
          <RowDefinition Height="75" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30" />
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="190" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Name="AddedUserTypeLabel" Margin="0,5,0,0" Grid.Column="1" FontWeight="Bold" Text="{Binding AddedUserTypeLabel}" />
        <TextBlock Name="AddedUserNameLabel" Margin="0,5,0,0" Grid.Column="2" FontWeight="Bold" Text="{Binding AddedUserNameLabel}" />
        <TextBlock Name="AddedUserRoleLabel" Margin="0,5,0,0" Grid.Column="3" FontWeight="Bold" Text="{Binding AddedUserRoleLabel}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.Row="1" Grid.ColumnSpan="4">
          <ItemsControl Name="AddedUsers" Grid.Row="1" ItemsSource="{Binding AddedUsers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button Margin="5,0,0,0" Grid.Column="0" Height="20" Width="20" Command="{Binding ElementName=AddedUsers, Path=DataContext.RemoveUserCommand}" CommandParameter="{Binding}">
                    <Control.Template>
                      <ControlTemplate>
                        <Border Name="bg" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1">
                          <Image Source="Resources/Remove_11x11.png" Height="11" Width="11" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="UIElement.IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Border.Background" Value="#FFD3D1D1" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Control.Template>
                  </Button>
                  <TextBlock Margin="0,4,4,0" Grid.Column="1" TextWrapping="NoWrap" Text="{Binding UserTypeDisplayName}" />
                  <TextBlock Margin="0,4,4,0" Grid.Column="2" TextWrapping="NoWrap" TextTrimming="WordEllipsis" Text="{Binding UserName}" />
                  <TextBlock Margin="0,4,4,0" Grid.Column="3" TextWrapping="NoWrap" Text="{Binding RoleName}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>