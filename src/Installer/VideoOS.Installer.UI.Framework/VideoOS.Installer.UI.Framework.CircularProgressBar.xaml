<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.Installer.UI.Framework.CircularProgressBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:framework="clr-namespace:VideoOS.Installer.UI.Framework;assembly=VideoOS.Installer.UI.Framework" IsVisibleChanged="HandleIsVisibleChanged">
  <Control.Template>
    <ControlTemplate>
      <Grid Name="LayoutRoot" Background="#00FFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Canvas Name="indicator" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="Auto" Height="Auto" Loaded="HandleLoaded">
          <Ellipse Name="C0" Width="20" Height="20" Canvas.Left="0" Canvas.Top="0" Stretch="Fill" Opacity="1.0" Fill="{Binding Path=ItemsColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
          <Ellipse Name="C1" Width="20" Height="20" Canvas.Left="0" Canvas.Top="0" Stretch="Fill" Opacity="0.9" Fill="{Binding Path=ItemsColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
          <Ellipse Name="C2" Width="20" Height="20" Canvas.Left="0" Canvas.Top="0" Stretch="Fill" Opacity="0.8" Fill="{Binding Path=ItemsColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
          <Ellipse Name="C3" Width="20" Height="20" Canvas.Left="0" Canvas.Top="0" Stretch="Fill" Opacity="0.7" Fill="{Binding Path=ItemsColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
          <Ellipse Name="C4" Width="20" Height="20" Canvas.Left="0" Canvas.Top="0" Stretch="Fill" Opacity="0.6" Fill="{Binding Path=ItemsColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
          <Ellipse Name="C5" Width="20" Height="20" Canvas.Left="0" Canvas.Top="0" Stretch="Fill" Opacity="0.5" Fill="{Binding Path=ItemsColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
          <Ellipse Name="C6" Width="20" Height="20" Canvas.Left="0" Canvas.Top="0" Stretch="Fill" Opacity="0.4" Fill="{Binding Path=ItemsColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
          <Ellipse Name="C7" Width="20" Height="20" Canvas.Left="0" Canvas.Top="0" Stretch="Fill" Opacity="0.3" Fill="{Binding Path=ItemsColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
          <Ellipse Name="C8" Width="20" Height="20" Canvas.Left="0" Canvas.Top="0" Stretch="Fill" Opacity="0.2" Fill="{Binding Path=ItemsColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
          <Ellipse Name="C9" Width="20" Height="20" Canvas.Left="0" Canvas.Top="0" Stretch="Fill" Opacity="0.1" Fill="{Binding ElementName=ThisUserControl, Path=ItemsColor}" />
          <UIElement.RenderTransform>
            <TransformGroup>
              <ScaleTransform />
              <SkewTransform />
              <RotateTransform />
              <TranslateTransform />
            </TransformGroup>
          </UIElement.RenderTransform>
        </Canvas>
      </Grid>
    </ControlTemplate>
  </Control.Template>
</UserControl>