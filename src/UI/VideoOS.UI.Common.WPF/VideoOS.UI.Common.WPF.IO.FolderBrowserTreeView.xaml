<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.UI.Common.WPF.IO.FolderBrowserTreeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:VideoOS.UI.Common.WPF.IO" xmlns:WPFCommon="clr-namespace:VideoOS.UI.Common.WPF.LoadAndGrowTreeView">
  <Grid>
    <WPFCommon:LoadAndGrowTreeView x:Name="_lazyTreeFileStructure" ItemHasBeenExpandedSynchronousEvent="LazyTreeFileStructure_ItemHasBeenExpandedSynchronousEvent" SelectedItemChanged="TreeViewFileStructure_SelectedItemChanged" TextInput="LazyTreeFileStructure_TextInput" Grid.Row="1" TabIndex="4" Margin="0" Background="{Binding Path=Background, RelativeSource={RelativeSource AncestorType=local:FolderBrowserTreeView}}">
      <WPFCommon:LoadAndGrowTreeView.HeaderTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal" Margin="0,2.5,0,2.5" UseLayoutRounding="True">
            <Image Width="16" Height="16" Margin="3,0,3,0" Source="{Binding Path=(local:FolderBrowserTreeView.NodeImage)}" />
            <TextBlock HorizontalAlignment="Stretch" VerticalAlignment="Center" Text="{Binding Header}" />
          </StackPanel>
        </DataTemplate>
      </WPFCommon:LoadAndGrowTreeView.HeaderTemplate>
    </WPFCommon:LoadAndGrowTreeView>
  </Grid>
</UserControl>