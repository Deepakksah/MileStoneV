<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.UI.Common.WPF.CustomControls.OkCancelControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resources="clr-namespace:VideoOS.UI.Common.WPF.Resources" xmlns:customcontrols="clr-namespace:VideoOS.UI.Common.WPF.CustomControls">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="ButtonStyle">
        <Setter Property="FrameworkElement.Margin" Value="10,1,1,1" />
        <Setter Property="Control.Padding" Value="0" />
        <Setter Property="FrameworkElement.Height" Value="27" />
        <Setter Property="FrameworkElement.Width" Value="100" />
      </Style>
      <Style x:Key="OkCancelPanelStyle">
        <Setter Property="FrameworkElement.Margin" Value="0" />
      </Style>
      <Style x:Key="OkCancelWrapPanelStyle">
        <Setter Property="FrameworkElement.Margin" Value="10" />
        <Setter Property="FrameworkElement.MinHeight" Value="20" />
      </Style>
      <Style x:Key="OKButtonStyle" BasedOn="{StaticResource ButtonStyle}">
        <Setter Property="ButtonBase.Command" Value="{Binding Path=OkAction}" />
      </Style>
      <Style x:Key="CancelButtonStyle" BasedOn="{StaticResource ButtonStyle}">
        <Setter Property="ButtonBase.Command" Value="{Binding Path=CancelAction}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="Grid" Margin="0,10,0,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="1" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Canvas Grid.Row="0" Height="1" VerticalAlignment="Top" Background="{Binding ElementName=OkButton, Path=Background}" />
    <DockPanel Grid.Row="1" LastChildFill="False" Dock="Bottom" VerticalAlignment="Top" Style="{StaticResource OkCancelPanelStyle}">
      <DockPanel HorizontalAlignment="Right" FlowDirection="RightToLeft" Dock="Right" Style="{StaticResource OkCancelWrapPanelStyle}">
        <Button Name="OkButton" DockPanel.Dock="Right" Style="{StaticResource OKButtonStyle}" Content="{x:Static resources:Strings.OkButtonText}" IsEnabled="{Binding OkEnabled, Mode=TwoWay}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
        <Button Name="CancelButton" DockPanel.Dock="Right" Style="{StaticResource CancelButtonStyle}" Content="{x:Static resources:Strings.CancelButtonText}" IsEnabled="{Binding CancelEnabled, Mode=TwoWay}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
      </DockPanel>
    </DockPanel>
  </Grid>
</UserControl>