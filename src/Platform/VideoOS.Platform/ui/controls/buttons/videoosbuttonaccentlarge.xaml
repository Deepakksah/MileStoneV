<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls" xmlns:converters="clr-namespace:VideoOS.Platform.UI.Converters" xmlns:ui="clr-namespace:VideoOS.Platform.UI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/VideoOS.Platform;component/UI/Controls/VideoOSBase.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Type controls:VideoOSButtonAccentLarge}" BasedOn="{StaticResource {x:Static controls:VideoOSBaseInternals.StyleKey}}" TargetType="{x:Type controls:VideoOSButtonAccentLarge}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:VideoOSButtonAccentLarge}">
          <Border CornerRadius="2" Height="40" BorderThickness="0" VerticalAlignment="Top" SnapsToDevicePixels="True">
            <FrameworkElement.MinWidth>
              <MultiBinding Converter="{x:Static controls:VideoOSButtonBaseInternals.MinimumWidthConverter}">
                <Binding Path="MinWidth" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="MaxWidth" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Source="{x:Static controls:VideoOSButtonBaseInternals.ButtonLargeDesiredMinWidth}" />
                <Binding Source="{x:Static controls:VideoOSButtonBaseInternals.ButtonLargeIconOnlyDesiredMinWidth}" />
                <Binding Path="AvailableWidth" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding ElementName="_buttonText" Path="Text" />
                <Binding Path="IsChevronDownIconVisible" RelativeSource="{RelativeSource TemplatedParent}" />
              </MultiBinding>
            </FrameworkElement.MinWidth>
            <Border.Background>
              <MultiBinding Converter="{x:Static controls:VideoOSButtonAccentBaseInternals.BackgroundBrushConverter}">
                <Binding Path="." RelativeSource="{RelativeSource Self}" />
                <Binding Path="ForcePressedState" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="IsPressed" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
              </MultiBinding>
            </Border.Background>
            <BulletDecorator Name="PART_BulletDecorator" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="{Binding ElementName=_buttonText, Path=Text, Converter={converters:StringNullOrEmptyToThicknessConverter NotNullOrEmptyResult=16,0, NullOrEmptyResult=0}}">
              <BulletDecorator.Bullet>
                <controls:VideoOSIcon Width="24" Height="24" VerticalAlignment="Center" IconSource="{TemplateBinding controls:VideoOSButtonBase.IconSource}" Visibility="{TemplateBinding IconSource, Converter={converters:NullToVisibilityConverter NullResult=Collapsed, NotNullResult=Visible}}" AutoColorBrush="{Binding ElementName=_buttonText, Path=Foreground}" />
              </BulletDecorator.Bullet>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:VideoOSTextBlockInteractiveMedium x:Name="_buttonText" Grid.Column="0" Text="{TemplateBinding ContentControl.Content}" Appearance="HighEmphasis" VerticalAlignment="Center" Margin="{TemplateBinding IconSource, Converter={converters:NullToThicknessConverter NotNullResult=4,0,0,0, NullResult=0}}" Visibility="{Binding Text, ElementName=_buttonText, Converter={converters:StringNullOrEmptyToVisibilityConverter NullOrEmptyResult=Collapsed, NotNullOrEmptyResult=Visible}}">
                  <controls:VideoOSTextBlockInteractiveMedium.InteractiveState>
                    <MultiBinding Converter="{x:Static controls:VideoOSButtonBaseInternals.VideoOSTextBlockInteractiveMediumInteractiveStateConverter}">
                      <Binding Path="ForcePressedState" RelativeSource="{RelativeSource TemplatedParent}" />
                      <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                      <Binding Path="IsPressed" RelativeSource="{RelativeSource TemplatedParent}" />
                    </MultiBinding>
                  </controls:VideoOSTextBlockInteractiveMedium.InteractiveState>
                </controls:VideoOSTextBlockInteractiveMedium>
                <controls:VideoOSIcon Grid.Column="1" Width="16" Height="16" Margin="8,2,0,0" VerticalAlignment="Center" AutoColorBrush="{Binding ElementName=_buttonText, Path=Foreground}" Visibility="{TemplateBinding IsChevronDownIconVisible, Converter={converters:BoolToVisibilityConverter TrueResult=Visible, FalseResult=Collapsed}}" IconSource="{controls:VideoOSIconBuiltInSource Chevron_Down}" />
              </Grid>
            </BulletDecorator>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>