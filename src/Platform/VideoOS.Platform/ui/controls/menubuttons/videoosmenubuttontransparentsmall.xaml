<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls" xmlns:commands="clr-namespace:VideoOS.Platform.UI.Commands">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/VideoOS.Platform;component/UI/Controls/VideoOSBase.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Type controls:VideoOSMenuButtonTransparentSmall}" BasedOn="{StaticResource {x:Static controls:VideoOSBaseInternals.StyleKey}}" TargetType="{x:Type controls:VideoOSMenuButtonTransparentSmall}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:VideoOSMenuButtonTransparentSmall}">
          <controls:VideoOSButtonTransparentSmall IsChevronDownIconVisible="{TemplateBinding controls:VideoOSMenuButtonBase.IsMenuIndicatorIconVisible}" Focusable="{TemplateBinding UIElement.Focusable}" IconSource="{TemplateBinding controls:VideoOSMenuButtonBase.IconSource}" Content="{TemplateBinding controls:VideoOSMenuButtonBase.Content}" commands:EventsToCommandMapping.Events="Click" commands:EventsToCommandMapping.Command="{Binding OpenMenuCommand, RelativeSource={RelativeSource TemplatedParent}}">
            <UIElement.IsEnabled>
              <MultiBinding Converter="{x:Static controls:VideoOSMenuButtonBaseInternals.ContentIsEnabledConverter}">
                <Binding Path="Actions" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="MenuHeaderTemplate" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="MenuFooterTemplate" RelativeSource="{RelativeSource TemplatedParent}" />
              </MultiBinding>
            </UIElement.IsEnabled>
          </controls:VideoOSButtonTransparentSmall>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>