<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls" xmlns:ui="clr-namespace:VideoOS.Platform.UI" xmlns:converters="clr-namespace:VideoOS.Platform.UI.Converters">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/VideoOS.Platform;component/UI/Controls/VideoOSBase.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Type controls:VideoOSRadioButtonMedium}" BasedOn="{StaticResource {x:Static controls:VideoOSBaseInternals.StyleKey}}" TargetType="{x:Type controls:VideoOSRadioButtonMedium}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:VideoOSRadioButtonMedium}">
          <BulletDecorator Background="#00FFFFFF" SnapsToDevicePixels="True">
            <BulletDecorator.Bullet>
              <Border BorderThickness="1" Width="16" Height="16" CornerRadius="8" VerticalAlignment="Center">
                <Border.BorderBrush>
                  <MultiBinding Converter="{x:Static controls:VideoOSRadioButtonBaseInternals.OutlineBrushConverter}">
                    <Binding Path="." RelativeSource="{RelativeSource Self}" />
                    <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="IsPressed" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="IsChecked" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
                  </MultiBinding>
                </Border.BorderBrush>
                <Border BorderThickness="0" Height="8" Width="8" CornerRadius="4">
                  <Border.Background>
                    <MultiBinding Converter="{x:Static controls:VideoOSRadioButtonBaseInternals.DotBrushConverter}">
                      <Binding Path="." RelativeSource="{RelativeSource Self}" />
                      <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                      <Binding Path="IsPressed" RelativeSource="{RelativeSource TemplatedParent}" />
                      <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                      <Binding Path="IsChecked" RelativeSource="{RelativeSource TemplatedParent}" />
                      <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
                    </MultiBinding>
                  </Border.Background>
                </Border>
              </Border>
            </BulletDecorator.Bullet>
            <controls:VideoOSTextBlockBodyMedium Text="{TemplateBinding ContentControl.Content}" Margin="8,0,0,0" Appearance="HighEmphasis" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MinLines="{TemplateBinding controls:VideoOSRadioButtonBase.MinLines}" MaxLines="{TemplateBinding controls:VideoOSRadioButtonBase.MaxLines}" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={converters:StringNullOrEmptyToVisibilityConverter NullOrEmptyResult=Collapsed, NotNullOrEmptyResult=Visible}}" />
          </BulletDecorator>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>