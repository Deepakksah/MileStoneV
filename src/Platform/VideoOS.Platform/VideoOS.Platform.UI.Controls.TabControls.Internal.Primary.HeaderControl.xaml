<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.Platform.UI.Controls.TabControls.Internal.Primary.HeaderControl" x:ClassModifier="internal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:VideoOS.Platform.UI.Converters" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls" xmlns:ui="clr-namespace:VideoOS.Platform.UI" xmlns:primary="clr-namespace:VideoOS.Platform.UI.Controls.TabControls.Internal.Primary" x:Name="_root" Focusable="True" IsTabStop="{Binding Path=SelectedItem, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:VideoOSTabControlBase}, Converter={converters:NullToBoolConverter}}" KeyDown="HeaderControl_OnKeyDown">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="TabSeparatorTemplate">
        <Rectangle Width="1" Height="20">
          <Shape.Fill>
            <MultiBinding Converter="{converters:BoolToResourceConverter TrueResult={x:Static controls:VideoOSResourceKeysInternal.VideoOSTabControlHeaderTabSeparatorIdleBrush}, FalseResult={x:Static controls:VideoOSResourceKeysInternal.VideoOSTabControlHeaderTabSeparatorDisabledBrush}}">
              <Binding Path="." RelativeSource="{RelativeSource Self}" />
              <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
              <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
            </MultiBinding>
          </Shape.Fill>
        </Rectangle>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Canvas Name="_canvas">
    <ContentControl Name="_separatorBeforeFirstTab" ContentTemplate="{DynamicResource TabSeparatorTemplate}" />
    <ContentControl Name="_separatorAfterLastTab" ContentTemplate="{DynamicResource TabSeparatorTemplate}" />
    <primary:HeaderItemOverflowMenu x:Name="_headerItemOverflowMenu" Width="60" Visibility="Hidden" />
  </Canvas>
</UserControl>