<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.Installer.UI.Framework.LicenseUpdateStatusControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:framework="clr-namespace:VideoOS.Installer.UI.Framework">
  <Grid>
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <SolidColorBrush x:Key="InstructionForgroundBrush" Color="#FF3E6C8C" />
        <framework:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" IsReversed="False" UseHidden="True" />
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="30" />
      <RowDefinition Height="50" />
      <RowDefinition Height="*" />
      <RowDefinition Height="100" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="30" />
      <ColumnDefinition Width="360" />
    </Grid.ColumnDefinitions>
    <Image Name="imageSuccess" Source="/VideoOS.Installer.UI.Framework;component/Resources/Update_Success.png" Grid.Row="0" Grid.Column="0" Margin="4" Visibility="{Binding Path=IsSuccessIndicatorVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
    <framework:CircularProgressBar Speed="00:00:00.6" Grid.Column="0" Grid.Row="1" Height="30" Width="30" VerticalAlignment="Top" ItemsColor="{StaticResource InstructionForgroundBrush}" Visibility="{Binding Path=IsProgressIndicatorVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
    <Image Name="imageProcessW" Grid.Column="0" Grid.Row="1" Source="/VideoOS.Installer.UI.Framework;Component/Resources/Update_Warning.png" Margin="4" VerticalAlignment="Top" Visibility="{Binding Path=IsWarningIndicatorVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
    <Image Name="imageProcessA" Grid.Column="0" Grid.Row="1" Source="/VideoOS.Installer.UI.Framework;Component/Resources/Update_Success.png" Margin="4" VerticalAlignment="Top" Visibility="{Binding Path=IsProcessSuccessIndicatorVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
    <Image Name="imageWarning" Grid.Row="3" Grid.Column="0" Source="/VideoOS.Installer.UI.Framework;Component/Resources/Update_Warning.png" Margin="4" VerticalAlignment="Top" Visibility="{Binding Path=IsWarningIndicatorVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
    <Label Grid.Column="1" Grid.Row="0" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" VerticalAlignment="Center" FontSize="12" FontStyle="Normal" FontFamily="Arial">
      <ContentControl.Content>
        <AccessText TextWrapping="Wrap" Text="{Binding Path=AvailableLicenseMessage, UpdateSourceTrigger=PropertyChanged}" />
      </ContentControl.Content>
    </Label>
    <Label Grid.Column="1" Grid.Row="1" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="12" FontStyle="Normal" FontFamily="Arial">
      <ContentControl.Content>
        <AccessText TextWrapping="Wrap" Text="{Binding Path=UpgradeLicenseMessage, UpdateSourceTrigger=PropertyChanged}" />
      </ContentControl.Content>
    </Label>
    <Label Grid.Column="1" Grid.Row="3" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" FontSize="12" FontStyle="Normal" FontFamily="Arial" Visibility="{Binding Path=IsWarningIndicatorVisible, Converter={StaticResource BoolToVisibilityConverter}}">
      <ContentControl.Content>
        <AccessText TextWrapping="Wrap" Text="{Binding Path=WarningMessageText, UpdateSourceTrigger=PropertyChanged}" />
      </ContentControl.Content>
    </Label>
  </Grid>
</UserControl>