<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.Installer.DatabasePlugin.KeyManagementPasswordControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resx="clr-namespace:VideoOS.Installer.UI.Properties;assembly=VideoOS.Installer.UI" xmlns:conv="clr-namespace:VideoOS.UI.Common.WPF.Utils.Converters;assembly=VideoOS.UI.Common.WPF" xmlns:mvvm="clr-namespace:VideoOS.UI.Common.WPF.Utils.MvvmHelpers;assembly=VideoOS.UI.Common.WPF" AutomationProperties.AutomationId="KeyManagementPasswordControl" xmlns:databaseplugin="clr-namespace:VideoOS.Installer.DatabasePlugin;assembly=VideoOS.Installer.DatabasePlugin">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../ResourceDictionary.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="52,45,50,45">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Name="labelHeadLine" AutomationProperties.AutomationId="labelHeadLine" HorizontalAlignment="Stretch" TextWrapping="Wrap" Style="{StaticResource HeaderTextBlockStyle}" Text="{Binding HeaderText}" />
    <Grid Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="16" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Name="labelInfo" AutomationProperties.AutomationId="labelInfo" HorizontalAlignment="Stretch" TextWrapping="Wrap" Grid.Column="1" Grid.Row="0" Style="{StaticResource HeaderInfoTextBlockStyle}" Text="{Binding PageInfoText}" />
      <Grid Row="2">
        <UIElement.Visibility>
          <Binding>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ShowEnterExistingPassword</Ctor>
            <Binding.Converter>
              <conv:BoolToVisibilityConverter conv:BoolToVisibilityConverter.TrueValue="Collapsed" conv:BoolToVisibilityConverter.FalseValue="Visible" />
            </Binding.Converter>
          </Binding>
        </UIElement.Visibility>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image Name="warningIcon" SnapsToDevicePixels="True" VerticalAlignment="Top" Stretch="None" Margin="-13,0,0,0" Grid.Column="0" AutomationProperties.AutomationId="warningIcon">
          <Image.Source>
            <Binding Source="{x:Static resx:Resources.warning}">
              <Binding.Converter>
                <conv:BitmapConverter />
              </Binding.Converter>
            </Binding>
          </Image.Source>
          <UIElement.Opacity>
            <Binding>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">DoNotUsePassword</Ctor>
              <Binding.Converter>
                <conv:EnabledToOpacityConverter conv:EnabledToOpacityConverter.DisabledOpacityValue="1" conv:EnabledToOpacityConverter.EnabledOpacityValue="0.5" />
              </Binding.Converter>
            </Binding>
          </UIElement.Opacity>
        </Image>
        <TextBlock Name="labelWarning" AutomationProperties.AutomationId="labelWarning" Margin="-6,0,0,0" HorizontalAlignment="Stretch" TextWrapping="Wrap" Grid.Column="1" Style="{StaticResource HeaderInfoTextBlockStyle}" Text="{Binding PageInfoWarningText}">
          <UIElement.Opacity>
            <Binding>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">DoNotUsePassword</Ctor>
              <Binding.Converter>
                <conv:EnabledToOpacityConverter conv:EnabledToOpacityConverter.DisabledOpacityValue="1" conv:EnabledToOpacityConverter.EnabledOpacityValue="0.5" />
              </Binding.Converter>
            </Binding>
          </UIElement.Opacity>
        </TextBlock>
      </Grid>
    </Grid>
    <Grid Row="4" Width="289" HorizontalAlignment="Left" ShowGridLines="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="3" />
        <RowDefinition Height="Auto" />
        <RowDefinition>
          <RowDefinition.Height>
            <Binding>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ShowEnterExistingPassword</Ctor>
              <Binding.Converter>
                <conv:BoolConverterExtension conv:BoolConverterExtension.FalseValue="12" conv:BoolConverterExtension.TrueValue="0" />
              </Binding.Converter>
            </Binding>
          </RowDefinition.Height>
        </RowDefinition>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="3" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="12" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Name="PasswordHeader" Grid.Row="0" AutomationProperties.AutomationId="PasswordHeader" FontWeight="Bold" Margin="-2,0,0,0" Style="{StaticResource ControlTextBlockStyle}" Text="{Binding PasswordLabelText}">
        <UIElement.Opacity>
          <Binding>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">DoNotUsePassword</Ctor>
            <Binding.Converter>
              <conv:EnabledToOpacityConverter conv:EnabledToOpacityConverter.DisabledOpacityValue="1" conv:EnabledToOpacityConverter.EnabledOpacityValue="0.5" />
            </Binding.Converter>
          </Binding>
        </UIElement.Opacity>
      </TextBlock>
      <PasswordBox Name="PasswordTextbox" Grid.Row="2" Height="20px" Margin="-2,0,0,0" mvvm:PasswordHelper.Attach="True" AutomationProperties.AutomationId="PasswordTextbox" Style="{StaticResource ControlPasswordBoxStyle}" mvvm:PasswordHelper.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
        <UIElement.IsEnabled>
          <Binding>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">DoNotUsePassword</Ctor>
            <Binding.Converter>
              <conv:NegationConverterExtension />
            </Binding.Converter>
          </Binding>
        </UIElement.IsEnabled>
      </PasswordBox>
      <TextBlock Name="ConfirmPassword" Grid.Row="4" Margin="-2,-2,0,0" AutomationProperties.AutomationId="ConfirmPassword" FontWeight="Bold" Style="{StaticResource ControlTextBlockStyle}" Text="{Binding ConfirmPasswordLabelText}">
        <UIElement.Visibility>
          <Binding>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ShowEnterExistingPassword</Ctor>
            <Binding.Converter>
              <conv:BoolToVisibilityConverter conv:BoolToVisibilityConverter.TrueValue="Collapsed" conv:BoolToVisibilityConverter.FalseValue="Visible" />
            </Binding.Converter>
          </Binding>
        </UIElement.Visibility>
        <UIElement.Opacity>
          <Binding>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">DoNotUsePassword</Ctor>
            <Binding.Converter>
              <conv:EnabledToOpacityConverter conv:EnabledToOpacityConverter.DisabledOpacityValue="1" conv:EnabledToOpacityConverter.EnabledOpacityValue="0.5" />
            </Binding.Converter>
          </Binding>
        </UIElement.Opacity>
      </TextBlock>
      <PasswordBox Name="ConfirmPasswordTextbox" Grid.Row="6" Height="20px" Margin="-2,0,0,0" mvvm:PasswordHelper.Attach="True" AutomationProperties.AutomationId="ConfirmPasswordTextbox" Style="{StaticResource ControlPasswordBoxStyle}" mvvm:PasswordHelper.Password="{Binding RepeatedPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
        <UIElement.Visibility>
          <Binding>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ShowEnterExistingPassword</Ctor>
            <Binding.Converter>
              <conv:BoolToVisibilityConverter conv:BoolToVisibilityConverter.TrueValue="Collapsed" conv:BoolToVisibilityConverter.FalseValue="Visible" />
            </Binding.Converter>
          </Binding>
        </UIElement.Visibility>
        <UIElement.IsEnabled>
          <Binding>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">DoNotUsePassword</Ctor>
            <Binding.Converter>
              <conv:NegationConverterExtension />
            </Binding.Converter>
          </Binding>
        </UIElement.IsEnabled>
      </PasswordBox>
    </Grid>
    <CheckBox Grid.Row="8" Style="{StaticResource ControlCheckBoxStyle}" AutomationProperties.AutomationId="NoPasswordCheckBox" Margin="-3,0,0,0" IsChecked="{Binding DoNotUsePassword}">
      <TextBlock TextWrapping="Wrap" Text="{Binding DoNotUsePasswordText}" />
    </CheckBox>
  </Grid>
</UserControl>