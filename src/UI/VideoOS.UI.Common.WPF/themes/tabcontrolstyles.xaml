<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VideoOS.UI.Common.WPF.Controls" xmlns:internal="clr-namespace:VideoOS.UI.Common.WPF.Controls.Internal">
  <Style x:Key="VideoOSTabItemStyle" TargetType="{x:Type controls:VideoOSTabItemSub}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:VideoOSTabItemSub}">
          <Grid Visibility="{Binding Path=HeaderPanelVisibility, RelativeSource={RelativeSource AncestorType=controls:VideoOSTabControlSub}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="3" />
            </Grid.RowDefinitions>
            <controls:VideoOSTextBlockHeader2 x:Name="TabCaption" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{TemplateBinding HeaderedContentControl.Header}" />
            <Rectangle Name="Underline" Grid.Row="1" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=controls:VideoOSTabControlSub}}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="TabItem.IsSelected" Value="False">
              <Setter TargetName="TabCaption" Property="TextBlock.Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=controls:VideoOSTabControlSub}}" />
              <Setter TargetName="Underline" Property="Shape.Fill" Value="#00FFFFFF" />
            </Trigger>
            <Trigger Property="TabItem.IsSelected" Value="True">
              <Setter TargetName="TabCaption" Property="TextBlock.Foreground" Value="{Binding Path=ForegroundSelected, RelativeSource={RelativeSource AncestorType=controls:VideoOSTabControlSub}}" />
              <Setter TargetName="Underline" Property="Shape.Fill" Value="{Binding Path=ForegroundSelected, RelativeSource={RelativeSource AncestorType=controls:VideoOSTabControlSub}}" />
            </Trigger>
            <Trigger SourceName="TabCaption" Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="TabCaption" Property="TextBlock.Foreground" Value="{Binding Path=ForegroundHover, RelativeSource={RelativeSource AncestorType=controls:VideoOSTabControlSub}}" />
              <Setter TargetName="Underline" Property="Shape.Fill" Value="{Binding Path=ForegroundHover, RelativeSource={RelativeSource AncestorType=controls:VideoOSTabControlSub}}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsEnabled" Value="False" />
                <Condition Property="TabItem.IsSelected" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="TabCaption" Property="TextBlock.Foreground" Value="{Binding Path=ForegroundDisabled, RelativeSource={RelativeSource AncestorType=controls:VideoOSTabControlSub}}" />
              <Setter TargetName="Underline" Property="Shape.Fill" Value="#00FFFFFF" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsEnabled" Value="False" />
                <Condition Property="TabItem.IsSelected" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="TabCaption" Property="TextBlock.Foreground" Value="{Binding Path=ForegroundDisabledSelected, RelativeSource={RelativeSource AncestorType=controls:VideoOSTabControlSub}}" />
              <Setter TargetName="Underline" Property="Shape.Fill" Value="{Binding Path=ForegroundDisabledSelected, RelativeSource={RelativeSource AncestorType=controls:VideoOSTabControlSub}}" />
            </MultiTrigger>
            <Trigger Property="controls:VideoOSTabItemSub.IsPressed" Value="True">
              <Setter TargetName="TabCaption" Property="TextBlock.Foreground" Value="{Binding Path=ForegroundPressed, RelativeSource={RelativeSource AncestorType=controls:VideoOSTabControlSub}}" />
              <Setter TargetName="Underline" Property="Shape.Fill" Value="{Binding Path=ForegroundPressed, RelativeSource={RelativeSource AncestorType=controls:VideoOSTabControlSub}}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type controls:VideoOSTabControlSub}" TargetType="{x:Type controls:VideoOSTabControlSub}" BasedOn="{StaticResource {x:Type TabControl}}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource VideoOSTabControlSubForegroundBrush}" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource VideoOSTabItemStyle}" />
    <Setter Property="controls:VideoOSTabControlSub.ForegroundHover" Value="{DynamicResource VideoOSTabControlSubForegroundHoverBrush}" />
    <Setter Property="controls:VideoOSTabControlSub.ForegroundPressed" Value="{DynamicResource VideoOSTabControlSubForegroundPressedBrush}" />
    <Setter Property="controls:VideoOSTabControlSub.ForegroundSelected" Value="{DynamicResource VideoOSTabControlSubForegroundSelectedBrush}" />
    <Setter Property="controls:VideoOSTabControlSub.ForegroundDisabled" Value="{DynamicResource VideoOSTabControlSubForegroundDisabledBrush}" />
    <Setter Property="controls:VideoOSTabControlSub.ForegroundDisabledSelected" Value="{DynamicResource VideoOSTabControlSubForegroundDisabledSelectedBrush}" />
    <Setter Property="controls:VideoOSTabControlSub.ContentHolderBackgroundDisabled" Value="{DynamicResource VideoOSTabControlSubContentHolderBackgroundDisabledBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:VideoOSTabControlSub}">
          <Grid Name="templateRoot" ClipToBounds="true" KeyboardNavigation.TabNavigation="Local">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Name="ColumnDefinition0" />
              <ColumnDefinition Name="ColumnDefinition1" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Name="RowDefinition0" Height="Auto" />
              <RowDefinition Name="RowDefinition1" Height="*" />
            </Grid.RowDefinitions>
            <internal:VideoOSHorizontalPanel x:Name="headerPanel" MinChildWidth="30" Spacing="8" Background="#00FFFFFF" Grid.Column="0" IsItemsHost="True" Grid.Row="0" KeyboardNavigation.TabIndex="1" ZIndex="1" />
            <Border Name="contentPanel" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" Grid.Column="0" KeyboardNavigation.DirectionalNavigation="Contained" Grid.Row="1" KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Local">
              <ContentPresenter Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="{TemplateBinding FrameworkElement.Margin}" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="TabControl.TabStripPlacement" Value="Bottom">
              <Setter TargetName="headerPanel" Property="Grid.Row" Value="1" />
              <Setter TargetName="contentPanel" Property="Grid.Row" Value="0" />
              <Setter TargetName="RowDefinition0" Property="RowDefinition.Height" Value="*" />
              <Setter TargetName="RowDefinition1" Property="RowDefinition.Height" Value="Auto" />
              <Setter TargetName="headerPanel" Property="Margin" Value="2,0,2,2" />
            </Trigger>
            <Trigger Property="TabControl.TabStripPlacement" Value="Left">
              <Setter TargetName="headerPanel" Property="Grid.Row" Value="0" />
              <Setter TargetName="contentPanel" Property="Grid.Row" Value="0" />
              <Setter TargetName="headerPanel" Property="Grid.Column" Value="0" />
              <Setter TargetName="contentPanel" Property="Grid.Column" Value="1" />
              <Setter TargetName="ColumnDefinition0" Property="ColumnDefinition.Width" Value="Auto" />
              <Setter TargetName="ColumnDefinition1" Property="ColumnDefinition.Width" Value="*" />
              <Setter TargetName="RowDefinition0" Property="RowDefinition.Height" Value="*" />
              <Setter TargetName="RowDefinition1" Property="RowDefinition.Height" Value="0" />
              <Setter TargetName="headerPanel" Property="Margin" Value="2,2,0,2" />
            </Trigger>
            <Trigger Property="TabControl.TabStripPlacement" Value="Right">
              <Setter TargetName="headerPanel" Property="Grid.Row" Value="0" />
              <Setter TargetName="contentPanel" Property="Grid.Row" Value="0" />
              <Setter TargetName="headerPanel" Property="Grid.Column" Value="1" />
              <Setter TargetName="contentPanel" Property="Grid.Column" Value="0" />
              <Setter TargetName="ColumnDefinition0" Property="ColumnDefinition.Width" Value="*" />
              <Setter TargetName="ColumnDefinition1" Property="ColumnDefinition.Width" Value="Auto" />
              <Setter TargetName="RowDefinition0" Property="RowDefinition.Height" Value="*" />
              <Setter TargetName="RowDefinition1" Property="RowDefinition.Height" Value="0" />
              <Setter TargetName="headerPanel" Property="Margin" Value="0,2,2,2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="PART_SelectedContentHost" Property="Visibility" Value="Hidden" />
              <Setter TargetName="contentPanel" Property="Border.Background" Value="{Binding Path=ContentHolderBackgroundDisabled, RelativeSource={RelativeSource AncestorType=controls:VideoOSTabControlSub}}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>