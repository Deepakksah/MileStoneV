<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.ServerConfigurator.CertificateConfigurator.UI.ServerConfiguratorControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:VideoOS.ServerConfigurator.CertificateConfigurator.UI" xmlns:wpf="clr-namespace:VideoOS.UI.Common.WPF.Utils.Converters;assembly=VideoOS.UI.Common.WPF" xmlns:resources="clr-namespace:VideoOS.ServerConfigurator.CertificateConfigurator.UI.Properties">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="StyleDictionary.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Border BorderThickness="0,1,0,0" BorderBrush="#e0e3ed">
      <TabControl Name="TabControl" IsEnabled="{Binding ElementName=TabControl, Path=SelectedItem.DataContext.IsBusy, Converter={wpf:NegationConverter}}" SelectedIndex="{Binding SelectedTabIndex}">
        <TabItem DataContext="{Binding Path=ServerEncryptionViewModel}" Visibility="{Binding Path=Visibility}">
          <HeaderedContentControl.Header>
            <TextBlock x:Uid="TextBlock_1" Text="{x:Static resources:Resources.ServerConfiguratorControl_Encryption}" TextWrapping="Wrap" />
          </HeaderedContentControl.Header>
          <ContentControl.Content>
            <local:ServerEncryptionControl VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
          </ContentControl.Content>
        </TabItem>
        <TabItem DataContext="{Binding Path=ServerRegistrationViewModel}">
          <HeaderedContentControl.Header>
            <TextBlock x:Uid="TextBlock_2" Text="{x:Static resources:Resources.ServerConfiguratorControl_RegisteringServers}" TextWrapping="Wrap" />
          </HeaderedContentControl.Header>
          <ContentControl.Content>
            <local:ServerRegistrationControl VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
          </ContentControl.Content>
        </TabItem>
        <TabItem DataContext="{Binding Path=SettingsViewModel}">
          <HeaderedContentControl.Header>
            <TextBlock x:Uid="TextBlock_0" Text="{x:Static resources:Resources.ServerConfiguratorControl_LanguageSelection}" TextWrapping="Wrap" />
          </HeaderedContentControl.Header>
          <ContentControl.Content>
            <local:SettingControl VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
          </ContentControl.Content>
        </TabItem>
      </TabControl>
    </Border>
    <local:WaitCurtain Cursor="Wait" Visibility="{Binding ElementName=TabControl, Path=SelectedItem.DataContext.IsBusy, Converter={wpf:BoolToVisibilityConverter TrueValue=Visible, FalseValue=Hidden}}" />
    <local:ApplyPopup Visibility="{Binding ElementName=TabControl, Path=SelectedItem.DataContext.MessageBoxViewModel.Response.IsCompleted, Converter={wpf:BoolToVisibilityConverter TrueValue=Hidden, FalseValue=Visible}}" DataContext="{Binding ElementName=TabControl, Path=SelectedItem.DataContext.MessageBoxViewModel}" />
  </Grid>
</UserControl>