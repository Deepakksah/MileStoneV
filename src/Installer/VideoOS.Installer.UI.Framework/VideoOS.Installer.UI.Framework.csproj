<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>VideoOS.Installer.UI.Framework</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net472</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="resources\update_warning.png" />
    <None Remove="resources\update_success.png" />
    <EmbeddedResource Include="resources\update_warning.png" LogicalName="resources/update_warning.png" />
    <EmbeddedResource Include="resources\update_success.png" LogicalName="resources/update_success.png" />
  </ItemGroup>
  <ItemGroup>
    
    
    <Reference Include="System.ServiceProcess" />
    
    <Reference Include="System.Core" />
    <Reference Include="WindowsBase" />
    <Reference Include="WindowsFormsIntegration" />
    <Reference Include="PresentationCore" />
    <Reference Include="Microsoft.Web.Administration" />
    
    <Reference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  
  <ItemGroup>
    <ProjectReference Include="..\VideoOS.Installer.StartIIS7\VideoOS.Installer.StartIIS7.csproj" />
    <ProjectReference Include="..\VideoOS.Installer.Logging\VideoOS.Installer.Logging.csproj" />
    <ProjectReference Include="..\VideoOS.Installer.Common\VideoOS.Installer.Common.csproj" />
    <ProjectReference Include="..\VideoOS.Installer.Interfaces\VideoOS.Installer.Interfaces.csproj" />
    <ProjectReference Include="..\VideoOS.Installer.UI\VideoOS.Installer.UI.csproj" />
    <ProjectReference Include="..\VideoOS.Installer.Common.Utilities\VideoOS.Installer.Common.Utilities.csproj" />
    <ProjectReference Include="..\VideoOS.Installer.Core\VideoOS.Installer.Core.csproj" />
  </ItemGroup>
</Project>