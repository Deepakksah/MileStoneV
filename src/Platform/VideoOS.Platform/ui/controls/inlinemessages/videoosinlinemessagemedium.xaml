<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls" xmlns:ui="clr-namespace:VideoOS.Platform.UI" xmlns:converters="clr-namespace:VideoOS.Platform.UI.Converters" xmlns:commands="clr-namespace:VideoOS.Platform.UI.Commands">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/VideoOS.Platform;component/UI/Controls/VideoOSBase.xaml" />
    <ResourceDictionary Source="pack://application:,,,/VideoOS.Platform;component/UI/Controls/InlineMessages/VideoOSInlineMessageBase.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Type controls:VideoOSInlineMessageMedium}" BasedOn="{StaticResource {x:Static controls:VideoOSBaseInternals.StyleKey}}" TargetType="{x:Type controls:VideoOSInlineMessageMedium}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:VideoOSInlineMessageMedium}">
          <BulletDecorator Background="#00FFFFFF" SnapsToDevicePixels="True">
            <BulletDecorator.Bullet>
              <ContentControl IsTabStop="False" Visibility="{TemplateBinding Content, Converter={converters:StringNullOrEmptyToVisibilityConverter NotNullOrEmptyResult=Visible, NullOrEmptyResult=Collapsed}}">
                <controls:VideoOSIcon Width="16" Height="16" Margin="0,0,8,0" IconSource="{TemplateBinding Appearance, Converter={x:Static controls:VideoOSInlineMessageBaseInternals.InlineMessageIconSourceConverter}}" />
              </ContentControl>
            </BulletDecorator.Bullet>
            <controls:VideoOSTextBlockBodyMedium x:Name="PART_MessageTextBlock" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MinLines="{TemplateBinding controls:VideoOSInlineMessageBase.MinLines}" MaxLines="{TemplateBinding controls:VideoOSInlineMessageBase.MaxLines}">
              <controls:VideoOSTextBlockBodyMedium.Appearance>
                <MultiBinding Converter="{x:Static controls:VideoOSInlineMessageMediumInternals.InlineMessageTextAppearanceConverter}">
                  <Binding Path="Appearance" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Path="AttenuateMessageText" RelativeSource="{RelativeSource TemplatedParent}" />
                </MultiBinding>
              </controls:VideoOSTextBlockBodyMedium.Appearance>
              <TextBlock.Foreground>
                <MultiBinding Converter="{x:Static controls:VideoOSInlineMessageBaseInternals.InlineMessageMediumEllipsisForegroundConverter}">
                  <Binding Path="." RelativeSource="{RelativeSource Self}" />
                  <Binding ElementName="PART_MessageTextBlock" Path="." />
                  <Binding ElementName="_messageTextRun" Path="Text" />
                  <Binding Path="LinkText" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding ElementName="PART_MessageTextBlock" Path="IsEnabled" />
                  <Binding ElementName="PART_MessageTextBlock" Path="ActualWidth" />
                  <Binding ElementName="PART_MessageTextBlock" Path="ActualHeight" />
                  <Binding Path="AttenuateMessageText" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
                </MultiBinding>
              </TextBlock.Foreground>
              <Run Name="_messageTextRun" Text="{TemplateBinding ContentControl.Content}">
                <TextElement.Foreground>
                  <MultiBinding Converter="{x:Static controls:VideoOSTextBlockBodyMediumInternals.TextBrushConverter}">
                    <Binding Path="." RelativeSource="{RelativeSource Self}" />
                    <Binding ElementName="PART_MessageTextBlock" Path="Appearance" />
                    <Binding ElementName="PART_MessageTextBlock" Path="IsEnabled" />
                    <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
                  </MultiBinding>
                </TextElement.Foreground>
              </Run> <Run Text="{TemplateBinding controls:VideoOSInlineMessageBase.LinkText}" commands:EventsToCommandMapping.Events="VideoOS.Platform.UI.Extensions.DependencyObjectAttachedProperties.MouseLeftButtonClick" Style="{StaticResource {x:Static controls:VideoOSInlineMessageBaseInternals.VideoOSTextBlockInteractiveMediumLinkLabelStyleKey}}" commands:EventsToCommandMapping.Command="{Binding LinkTextClickCommand, RelativeSource={RelativeSource TemplatedParent}}" /></controls:VideoOSTextBlockBodyMedium>
          </BulletDecorator>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>