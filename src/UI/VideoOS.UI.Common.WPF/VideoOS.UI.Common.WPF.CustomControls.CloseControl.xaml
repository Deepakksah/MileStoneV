<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.UI.Common.WPF.CustomControls.CloseControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resources="clr-namespace:VideoOS.UI.Common.WPF.Resources" Height="60" xmlns:customcontrols="clr-namespace:VideoOS.UI.Common.WPF.CustomControls">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="ButtonStyle">
        <Setter Property="FrameworkElement.Margin" Value="10,1,1,1" />
        <Setter Property="Control.Padding" Value="4" />
        <Setter Property="FrameworkElement.MinHeight" Value="20" />
        <Setter Property="FrameworkElement.MinWidth" Value="100" />
      </Style>
      <Style x:Key="ClosePanelStyle">
        <Setter Property="FrameworkElement.Margin" Value="0" />
      </Style>
      <Style x:Key="CloseWrapPanelStyle">
        <Setter Property="FrameworkElement.Margin" Value="10" />
        <Setter Property="FrameworkElement.MinHeight" Value="20" />
      </Style>
      <Style x:Key="CloseButtonStyle" BasedOn="{StaticResource ButtonStyle}">
        <Setter Property="ButtonBase.Command" Value="{Binding Path=CloseAction}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="Grid" Margin="0,10,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="1" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Canvas Grid.Row="0" Height="1" VerticalAlignment="Top" Background="{Binding ElementName=CloseButton, Path=Background}" />
    <DockPanel Grid.Row="1" LastChildFill="False" Dock="Bottom" VerticalAlignment="Top" Style="{StaticResource ClosePanelStyle}">
      <DockPanel HorizontalAlignment="Right" FlowDirection="RightToLeft" Dock="Right" Style="{StaticResource CloseWrapPanelStyle}">
        <Button Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource CloseButtonStyle}" Content="{x:Static resources:Strings.CloseButtonText}" IsEnabled="{Binding OkEnabled, Mode=TwoWay}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
      </DockPanel>
    </DockPanel>
  </Grid>
</UserControl>