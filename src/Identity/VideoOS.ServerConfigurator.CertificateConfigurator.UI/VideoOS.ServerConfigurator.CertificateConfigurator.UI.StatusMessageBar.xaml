<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.ServerConfigurator.CertificateConfigurator.UI.StatusMessageBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:con="clr-namespace:VideoOS.UI.Common.WPF.Utils.Converters;assembly=VideoOS.UI.Common.WPF" xmlns:ui="clr-namespace:VideoOS.ServerConfigurator.CertificateConfigurator.UI;assembly=VideoOS.ServerConfigurator.CertificateConfigurator.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary Source="StyleDictionary.xaml" />
  </FrameworkElement.Resources>
  <StackPanel>
    <Grid Visibility="{Binding ErrorMessage, Converter={con:EmptyStringConverter ValueIfEmpty=Collapsed, ValueIfNotEmpty=Visible}}">
      <ContentControl IsTabStop="False" ContentTemplate="{StaticResource ErrorMessageTemplate}" AutomationProperties.AutomationId="ErrorMessageContent" Content="{Binding ErrorMessage}" />
      <Button HorizontalAlignment="Right" Margin="0,0,16,0" Style="{StaticResource StatusMessageCloseButton}" AutomationProperties.AutomationId="ClearErrorMessageButton" Command="{Binding ClearErrorMessage}" />
    </Grid>
    <Grid Visibility="{Binding WarningMessage, Converter={con:EmptyStringConverter ValueIfEmpty=Collapsed, ValueIfNotEmpty=Visible}}">
      <ContentControl IsTabStop="False" ContentTemplate="{StaticResource WarningMessageTemplate}" AutomationProperties.AutomationId="WarningMessageContent" Content="{Binding WarningMessage}" />
      <Button HorizontalAlignment="Right" Margin="0,0,16,0" Style="{StaticResource StatusMessageCloseButton}" AutomationProperties.AutomationId="ClearWarningMessageButton" Command="{Binding ClearWarningMessage}" />
    </Grid>
    <Grid Visibility="{Binding SuccessMessage, Converter={con:EmptyStringConverter ValueIfEmpty=Collapsed, ValueIfNotEmpty=Visible}}">
      <ContentControl IsTabStop="False" ContentTemplate="{StaticResource SuccessMessageTemplate}" AutomationProperties.AutomationId="SuccessMessageContent" Content="{Binding SuccessMessage}" />
      <Button HorizontalAlignment="Right" Margin="0,0,16,0" Style="{StaticResource StatusMessageCloseButton}" AutomationProperties.AutomationId="ClearSuccessMessageButton" Command="{Binding ClearSuccessMessage}" />
    </Grid>
  </StackPanel>
</UserControl>