<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.Platform.UI.Controls.TabControls.Internal.Primary.HeaderItemControl" x:ClassModifier="internal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VideoOS.Platform.UI.Controls.TabControls.Internal.Primary" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls" xmlns:ui="clr-namespace:VideoOS.Platform.UI" xmlns:converters="clr-namespace:VideoOS.Platform.UI.Converters" xmlns:internal="clr-namespace:VideoOS.Platform.UI.Controls.TabControls.Internal" xmlns:extensions="clr-namespace:VideoOS.Platform.UI.Extensions" x:Name="_root" extensions:UIElementExtensions.DragInitiated="HeaderItemControl_OnDragInitiated" Height="48" extensions:DependencyObjectAttachedProperties.IsMouseLeftButtonDownAware="True" Focusable="True" IsEnabled="{internal:ItemIsEnabled}" ToolTip="{internal:ItemToolTip}" extensions:UIElementExtensions.IsDragInitiatedAware="{internal:ItemIsDraggable}" AutomationProperties.AutomationId="{internal:ItemAutomationId}">
  <Control.IsTabStop>
    <MultiBinding Converter="{x:Static local:HeaderItemControl.IsTabStopConverter}">
      <Binding />
      <Binding Path="SelectedItem" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type local:HeaderControl}}" />
    </MultiBinding>
  </Control.IsTabStop>
  <Grid>
    <Grid Name="_contentGrid" SizeChanged="ContentGrid_OnSizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition>
          <ColumnDefinition.Width>
            <MultiBinding Converter="{x:Static local:HeaderItemControl.ContentGridMarginLeft}">
              <Binding ElementName="_root" Path="HeaderContentPadding" />
            </MultiBinding>
          </ColumnDefinition.Width>
        </ColumnDefinition>
        <ColumnDefinition Width="*" />
        <ColumnDefinition>
          <ColumnDefinition.Width>
            <MultiBinding Converter="{x:Static local:HeaderItemControl.ContentGridMarginRight}">
              <Binding ElementName="_root" Path="HeaderContentPadding" />
              <Binding ElementName="_actionList" Path="Actions" />
            </MultiBinding>
          </ColumnDefinition.Width>
        </ColumnDefinition>
      </Grid.ColumnDefinitions>
      <ContentControl Name="_iconTextAndAlertGridSizeDummyElement" Grid.Column="1" IsTabStop="False" />
      <Grid Name="_iconTextAndAlertGrid" Column="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition>
            <ColumnDefinition.Width>
              <MultiBinding Converter="{x:Static local:HeaderItemControl.IconTextSpacingConverter}">
                <Binding ElementName="_iconIcon" Path="Visibility" />
                <Binding ElementName="_textTextBlock" Path="Visibility" />
                <Binding ElementName="_alertBadge" Path="Visibility" />
              </MultiBinding>
            </ColumnDefinition.Width>
          </ColumnDefinition>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition>
            <ColumnDefinition.Width>
              <MultiBinding Converter="{x:Static local:HeaderItemControl.TextAlertSpacingConverter}">
                <Binding ElementName="_textTextBlock" Path="Visibility" />
                <Binding ElementName="_alertBadge" Path="Visibility" />
              </MultiBinding>
            </ColumnDefinition.Width>
          </ColumnDefinition>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <controls:VideoOSIcon x:Name="_iconIcon" Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" IconSource="{local:ItemIconSource}" Visibility="{local:ItemIconVisibility}" />
        <controls:VideoOSTextBlockH2 x:Name="_textTextBlock" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Stretch" Text="{internal:ItemText}" Visibility="{local:ItemTextVisibility}">
          <FrameworkElement.MaxWidth>
            <MultiBinding Converter="{x:Static local:HeaderItemControl.TextMaxWidthConverter}">
              <Binding Path="ItemSizeMode" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type local:HeaderControl}}" />
              <Binding ElementName="_iconTextAndAlertGridSizeDummyElement" Path="ActualWidth" />
              <Binding ElementName="_iconIcon" Path="Visibility" />
              <Binding ElementName="_iconIcon" Path="ActualWidth" />
              <Binding ElementName="_alertBadge" Path="Visibility" />
              <Binding ElementName="_alertBadge" Path="ActualWidth" />
            </MultiBinding>
          </FrameworkElement.MaxWidth>
        </controls:VideoOSTextBlockH2>
        <controls:VideoOSBadgeExtraSmall x:Name="_alertBadge" Grid.Column="4" VerticalAlignment="Center" Tag="{local:ItemAlert}" Visibility="{Binding Path=Tag, RelativeSource={RelativeSource Self}, Converter={converters:NullToVisibilityConverter NullResult=Collapsed, NotNullResult=Visible}}" Count="{Binding Path=Tag.Count, RelativeSource={RelativeSource Self}}" MaxDisplayCount="{Binding Path=Tag.MaxDisplayCount, RelativeSource={RelativeSource Self}}" ToolTip="{Binding Path=Tag.ToolTip, RelativeSource={RelativeSource Self}}" />
      </Grid>
      <controls:VideoOSActionListHorizontalSmall x:Name="_actionList" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Actions="{local:ItemActions}">
        <UIElement.Visibility>
          <MultiBinding Converter="{x:Static local:HeaderItemControl.ActionListVisibilityConverter}">
            <Binding Path="Actions" RelativeSource="{RelativeSource Self}" />
            <Binding />
            <Binding Path="SelectedItem" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type local:HeaderControl}}" />
            <Binding Path="IsOpen" RelativeSource="{RelativeSource Self}" />
            <Binding ElementName="_root" Path="IsMouseOver" />
          </MultiBinding>
        </UIElement.Visibility>
      </controls:VideoOSActionListHorizontalSmall>
    </Grid>
    <Rectangle Height="4" VerticalAlignment="Bottom">
      <Shape.Fill>
        <MultiBinding Converter="{x:Static local:HeaderItemControl.SelectedIndicatorFillConverter}">
          <Binding Path="." RelativeSource="{RelativeSource Self}" />
          <Binding />
          <Binding Path="SelectedItem" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type local:HeaderControl}}" />
          <Binding Path="IsEnabled" ElementName="_root" />
          <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
        </MultiBinding>
      </Shape.Fill>
    </Rectangle>
  </Grid>
  <Control.Background>
    <MultiBinding Converter="{x:Static local:HeaderItemControl.BackgroundConverter}">
      <Binding Path="." RelativeSource="{RelativeSource Self}" />
      <Binding />
      <Binding Path="SelectedItem" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type local:HeaderControl}}" />
      <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
      <Binding Path="IsMouseOver" RelativeSource="{RelativeSource Self}" />
      <Binding Path="IsOpen" ElementName="_actionList" />
      <Binding Path="(extensions:DependencyObjectAttachedProperties.IsMouseLeftButtonDown)" RelativeSource="{RelativeSource Self}" />
      <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
    </MultiBinding>
  </Control.Background>
</UserControl>