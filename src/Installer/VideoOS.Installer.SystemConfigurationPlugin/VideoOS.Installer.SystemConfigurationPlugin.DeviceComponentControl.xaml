<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VideoOS.Installer.SystemConfigurationPlugin.DeviceComponentControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" xmlns:resx="clr-namespace:VideoOS.Installer.SystemConfigurationPlugin.Properties" xmlns:local="clr-namespace:VideoOS.Installer.SystemConfigurationPlugin" x:Name="componentControl">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../ResourceDictionary.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <local:EnabledTextConverter x:Key="enabledTextConverter" />
      <Style x:Key="GridStyle" TargetType="{x:Type Grid}">
        <Style.Resources>
          <ResourceDictionary>
            <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
              <Setter Property="Visibility" Value="Hidden" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="True" Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" />
                    <Condition Value="True" Binding="{Binding Path=Editable, ElementName=componentControl}" />
                  </MultiDataTrigger.Conditions>
                  <MultiDataTrigger.Setters>
                    <Setter Property="Visibility" Value="Visible" />
                  </MultiDataTrigger.Setters>
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </ResourceDictionary>
        </Style.Resources>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="controlGrid" Height="26px" Style="{StaticResource GridStyle}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <ToggleButton Height="14" Style="{StaticResource ToggleSwitch}" Background="#FF808080" BorderBrush="#FF808080" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsThreeState="False" IsChecked="{Binding Enabled}" />
    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="5,0,10,0" Text="{Binding Enabled, Converter={StaticResource enabledTextConverter}}" />
    <local:EditableTextBoxControl Grid.Column="2" Height="26px" VerticalAlignment="Center" Editable="False" />
  </Grid>
</UserControl>