<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls" xmlns:ui="clr-namespace:VideoOS.Platform.UI" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/VideoOS.Platform;component/UI/Controls/TextBlocks/VideoOSTextBlockBase.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Type controls:VideoOSTextBlockInteractiveExtraSmall}" BasedOn="{StaticResource {x:Type controls:VideoOSTextBlockBase}}" TargetType="{x:Type controls:VideoOSTextBlockInteractiveExtraSmall}">
    <Setter Property="FontSize" Value="{x:Static controls:VideoOSTextBlockInteractiveExtraSmallInternals.FontSize}" />
    <Setter Property="FontWeight" Value="{x:Static controls:VideoOSTextBlockInteractiveExtraSmallInternals.FontWeight}" />
    <Setter Property="FontFamily" Value="{x:Static controls:VideoOSTextBlockInteractiveExtraSmallInternals.FontFamily}" />
    <Setter Property="FontStyle" Value="{x:Static controls:VideoOSTextBlockInteractiveExtraSmallInternals.FontStyle}" />
    <Setter Property="FontStretch" Value="{x:Static controls:VideoOSTextBlockInteractiveExtraSmallInternals.FontStretch}" />
    <Setter Property="Foreground">
      <Setter.Value>
        <MultiBinding Converter="{x:Static controls:VideoOSTextBlockInteractiveExtraSmallInternals.TextBrushConverter}">
          <Binding Path="." RelativeSource="{RelativeSource Self}" />
          <Binding Path="Appearance" RelativeSource="{RelativeSource Self}" />
          <Binding Path="InteractiveState" RelativeSource="{RelativeSource Self}" />
          <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
          <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
        </MultiBinding>
      </Setter.Value>
    </Setter>
    <Setter Property="UIElement.Opacity">
      <Setter.Value>
        <MultiBinding Converter="{x:Static controls:VideoOSTextBlockInteractiveExtraSmallInternals.OpacityConverter}">
          <Binding Path="." RelativeSource="{RelativeSource Self}" />
          <Binding Path="Appearance" RelativeSource="{RelativeSource Self}" />
          <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
          <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
        </MultiBinding>
      </Setter.Value>
    </Setter>
    <Setter Property="TextDecorations" Value="{Binding Path=Appearance, Converter={x:Static controls:VideoOSTextBlockInteractiveExtraSmallInternals.TextDecorationsConverter}, RelativeSource={RelativeSource Self}}" />
  </Style>
</ResourceDictionary>