<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls" xmlns:extensions="clr-namespace:VideoOS.Platform.UI.Extensions" xmlns:ui="clr-namespace:VideoOS.Platform.UI" xmlns:converters="clr-namespace:VideoOS.Platform.UI.Converters">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/VideoOS.Platform;component/UI/Controls/Sliders/VideoOSSliderBase.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Static controls:VideoOSSliderHorizontal+VideoOSSliderHorizontalInternals.ThumbStyleShuttleKey}" TargetType="{x:Type Thumb}">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Canvas.Left" Value="-7" />
    <Setter Property="Canvas.Top" Value="-2" />
    <Setter Property="extensions:DependencyObjectAttachedProperties.IsMouseLeftButtonDownAware" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Rectangle StrokeThickness="1" Width="6" Height="18" RadiusX="3" RadiusY="3">
            <UIElement.Effect>
              <MultiBinding Converter="{x:Static controls:VideoOSSliderBaseInternals.ThumbDropShadowEffectConverter}">
                <Binding Path="." RelativeSource="{RelativeSource Self}" />
                <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
              </MultiBinding>
            </UIElement.Effect>
            <UIElement.Opacity>
              <MultiBinding Converter="{converters:BoolToResourceConverter TrueResult={x:Static controls:VideoOSResourceKeysInternal.VideoOSSliderThumbEnabledOpacity}, FalseResult={x:Static controls:VideoOSResourceKeysInternal.VideoOSSliderThumbDisabledOpacity}}">
                <Binding Path="." RelativeSource="{RelativeSource Self}" />
                <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
              </MultiBinding>
            </UIElement.Opacity>
            <Shape.Stroke>
              <MultiBinding Converter="{x:Static controls:VideoOSSliderBaseInternals.ThumbOutlineBrushConverter}">
                <Binding Path="." RelativeSource="{RelativeSource Self}" />
                <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="(extensions:DependencyObjectAttachedProperties.IsMouseLeftButtonDown)" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
              </MultiBinding>
            </Shape.Stroke>
            <Shape.Fill>
              <MultiBinding Converter="{x:Static controls:VideoOSSliderBaseInternals.ThumbFillBrushConverter}">
                <Binding Path="." RelativeSource="{RelativeSource Self}" />
                <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="(extensions:DependencyObjectAttachedProperties.IsMouseLeftButtonDown)" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
              </MultiBinding>
            </Shape.Fill>
          </Rectangle>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type controls:VideoOSSliderHorizontal}" BasedOn="{StaticResource {x:Type controls:VideoOSSliderBase}}" TargetType="{x:Type controls:VideoOSSliderHorizontal}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:VideoOSSliderHorizontal}">
          <Grid Height="18" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Background="#00FFFFFF" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition>
                <ColumnDefinition.Width>
                  <MultiBinding Converter="{x:Static controls:VideoOSSliderBaseInternals.FillColumnWidthConverter}">
                    <Binding Path="AreTrackAndThumbVisible" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="HorizontalContentAlignment" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Source="{x:Static HorizontalAlignment.Left}" />
                  </MultiBinding>
                </ColumnDefinition.Width>
              </ColumnDefinition>
              <ColumnDefinition Name="PART_LeftLabelColumnDefinition" Width="Auto" MinWidth="{TemplateBinding LabelsMinWidth, Converter={x:Static controls:VideoOSSliderBaseInternals.LabelColumnMinWidthConverter}}" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="{TemplateBinding AreTrackAndThumbVisible, Converter={x:Static controls:VideoOSSliderBaseInternals.TrackAndThumbColumnWidthConverter}}" MinWidth="{TemplateBinding AreTrackAndThumbVisible, Converter={converters:BoolToDoubleConverter TrueResult=32, FalseResult=0}}" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Name="PART_RightLabelColumnDefinition" Width="Auto" MinWidth="{TemplateBinding LabelsMinWidth, Converter={x:Static controls:VideoOSSliderBaseInternals.LabelColumnMinWidthConverter}}" />
              <ColumnDefinition>
                <ColumnDefinition.Width>
                  <MultiBinding Converter="{x:Static controls:VideoOSSliderBaseInternals.FillColumnWidthConverter}">
                    <Binding Path="AreTrackAndThumbVisible" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="HorizontalContentAlignment" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Source="{x:Static HorizontalAlignment.Right}" />
                  </MultiBinding>
                </ColumnDefinition.Width>
              </ColumnDefinition>
            </Grid.ColumnDefinitions>
            <controls:VideoOSTextBlockLabel Grid.Column="1" Style="{StaticResource {x:Static controls:VideoOSSliderBaseInternals.LabelMinimumStyleKey}}" MaxWidth="{Binding ElementName=PART_LeftLabelColumnDefinition, Path=MaxWidth, Converter={x:Static controls:VideoOSSliderBaseInternals.LabelMaxWidthConverter}}" />
            <controls:VideoOSButtonTransparentExtraSmall Grid.Column="2" Style="{StaticResource {x:Static controls:VideoOSSliderBaseInternals.DecreaseButtonStyleKey}}" />
            <Grid Name="PART_Track" Column="3" ToolTip="{TemplateBinding controls:VideoOSSliderBase.TrackAndThumbToolTip}" Style="{StaticResource {x:Static controls:VideoOSSliderBaseInternals.TrackStyleKey}}" Visibility="{TemplateBinding AreTrackAndThumbVisible, Converter={converters:BoolToVisibilityConverter TrueResult=Visible, FalseResult=Collapsed}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Name="PART_TrackLeftColumnDefinition" />
                <ColumnDefinition Width="0" />
                <ColumnDefinition Name="PART_TrackRightColumnDefinition" />
              </Grid.ColumnDefinitions>
              <Grid Name="PART_TrackLeft" Column="0" Background="#00FFFFFF">
                <Rectangle Style="{StaticResource {x:Static controls:VideoOSSliderBaseInternals.IncludedTrackStyleKey}}" />
              </Grid>
              <Grid Name="PART_TrackRight" Column="2" Background="#00FFFFFF">
                <Rectangle Style="{StaticResource {x:Static controls:VideoOSSliderBaseInternals.ExcludedTrackStyleKey}}" />
              </Grid>
              <Canvas Grid.Column="1">
                <Thumb Name="PART_Thumb">
                  <FrameworkElement.Style>
                    <MultiBinding Converter="{x:Static controls:VideoOSSliderHorizontalInternals.ThumbStyleConverter}">
                      <Binding Path="ThumbAppearance" RelativeSource="{RelativeSource TemplatedParent}" />
                      <Binding Source="{StaticResource {x:Static controls:VideoOSSliderBaseInternals.ThumbStyleDefaultKey}}" />
                      <Binding Source="{StaticResource {x:Static controls:VideoOSSliderHorizontalInternals.ThumbStyleShuttleKey}}" />
                    </MultiBinding>
                  </FrameworkElement.Style>
                </Thumb>
              </Canvas>
            </Grid>
            <controls:VideoOSButtonTransparentExtraSmall Grid.Column="4" Style="{StaticResource {x:Static controls:VideoOSSliderBaseInternals.IncreaseButtonStyleKey}}" />
            <controls:VideoOSTextBlockLabel Grid.Column="5" Style="{StaticResource {x:Static controls:VideoOSSliderBaseInternals.LabelMaximumStyleKey}}" MaxWidth="{Binding ElementName=PART_RightLabelColumnDefinition, Path=MaxWidth, Converter={x:Static controls:VideoOSSliderBaseInternals.LabelMaxWidthConverter}}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>