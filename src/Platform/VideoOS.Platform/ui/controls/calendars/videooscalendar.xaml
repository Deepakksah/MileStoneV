<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls" xmlns:converters="clr-namespace:VideoOS.Platform.UI.Converters" xmlns:ui="clr-namespace:VideoOS.Platform.UI" xmlns:resources="clr-namespace:VideoOS.Platform.UI.Resources" xmlns:extensions="clr-namespace:VideoOS.Platform.UI.Extensions" xmlns:commands="clr-namespace:VideoOS.Platform.UI.Commands">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/VideoOS.Platform;component/UI/Controls/VideoOSBase.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Type controls:VideoOSCalendar}" BasedOn="{StaticResource {x:Static controls:VideoOSBaseInternals.StyleKey}}" TargetType="{x:Type controls:VideoOSCalendar}">
    <Setter Property="Calendar.CalendarButtonStyle">
      <Setter.Value>
        <Style TargetType="{x:Type CalendarButton}" BasedOn="{StaticResource {x:Type CalendarButton}}">
          <Setter Property="Background" Value="#00FFFFFF" />
          <Setter Property="FrameworkElement.Cursor" Value="Hand" />
          <Setter Property="Width" Value="64" />
          <Setter Property="extensions:DependencyObjectAttachedProperties.IsMouseLeftButtonDownAware" Value="True" />
          <Setter Property="commands:EventsToCommandMapping.Events" Value="KeyDown" />
          <Setter Property="commands:EventsToCommandMapping.Command" Value="{Binding Path=CalendarButtonKeyDownCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:VideoOSCalendar}}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type CalendarButton}">
                <Border CornerRadius="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="28">
                  <Border.Background>
                    <MultiBinding Converter="{x:Static controls:VideoOSCalendarInternals.CalendarMonthYearItemButtonBackgroundBrushConverter}">
                      <Binding Path="." RelativeSource="{RelativeSource Self}" />
                      <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                      <Binding Path="(extensions:DependencyObjectAttachedProperties.IsMouseLeftButtonDown)" RelativeSource="{RelativeSource TemplatedParent}" />
                      <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                      <Binding Path="DataContext" RelativeSource="{RelativeSource TemplatedParent}" />
                      <Binding Path="SelectedDates" RelativeSource="{RelativeSource FindAncestor, AncestorType=controls:VideoOSCalendar}" />
                      <Binding Path="DisplayMode" RelativeSource="{RelativeSource FindAncestor, AncestorType=controls:VideoOSCalendar}" />
                      <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
                    </MultiBinding>
                  </Border.Background>
                  <controls:VideoOSTextBlockBodyMedium Text="{TemplateBinding ContentControl.Content}" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" Appearance="{TemplateBinding IsInactive, Converter={converters:BoolToEnumConverter TrueResult={x:Static controls:Appearances.LowEmphasis}, FalseResult={x:Static controls:Appearances.HighEmphasis}}}" />
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="Calendar.CalendarDayButtonStyle">
      <Setter.Value>
        <Style TargetType="{x:Type CalendarDayButton}" BasedOn="{StaticResource {x:Type CalendarDayButton}}">
          <Setter Property="Background" Value="#00FFFFFF" />
          <Setter Property="FrameworkElement.Cursor" Value="Hand" />
          <Setter Property="Width" Value="28" />
          <Setter Property="Height" Value="28" />
          <Setter Property="Margin" Value="2" />
          <Setter Property="extensions:DependencyObjectAttachedProperties.IsMouseLeftButtonDownAware" Value="True" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                <Grid>
                  <Border Name="_border" CornerRadius="2">
                    <Border.Background>
                      <MultiBinding Converter="{x:Static controls:VideoOSCalendarInternals.CalendarDayItemButtonBackgroundBrushConverter}">
                        <Binding Path="." RelativeSource="{RelativeSource Self}" />
                        <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="(extensions:DependencyObjectAttachedProperties.IsMouseLeftButtonDown)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="IsHighlighted" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="IsSelected" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
                      </MultiBinding>
                    </Border.Background>
                    <controls:VideoOSTextBlockBodyMedium Text="{TemplateBinding ContentControl.Content}" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" Appearance="{TemplateBinding IsInactive, Converter={converters:BoolToEnumConverter TrueResult={x:Static controls:Appearances.LowEmphasis}, FalseResult={x:Static controls:Appearances.HighEmphasis}}}" />
                  </Border>
                  <Border BorderThickness="1" CornerRadius="2" Visibility="{TemplateBinding IsToday, Converter={converters:BoolToVisibilityConverter TrueResult=Visible, FalseResult=Collapsed}}">
                    <Border.BorderBrush>
                      <MultiBinding Converter="{x:Static controls:VideoOSCalendarInternals.CalendarTodayDayItemButtonBorderBrushConverter}">
                        <Binding Path="." RelativeSource="{RelativeSource Self}" />
                        <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="(extensions:DependencyObjectAttachedProperties.IsMouseLeftButtonDown)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
                      </MultiBinding>
                    </Border.BorderBrush>
                  </Border>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:VideoOSCalendar}">
          <FrameworkTemplate.Resources>
            <ResourceDictionary>
              <ControlTemplate x:Key="CalendarItemTemplate" TargetType="{x:Type CalendarItem}">
                <Grid Name="PART_Root">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0">
                    <controls:VideoOSButtonTransparentSmall x:Name="PART_MonthHeaderButton" Focusable="False" VerticalAlignment="Center" HorizontalAlignment="Left" Cursor="Hand" MaxWidth="74" CommandParameter="{x:Static CalendarMode.Year}" Visibility="{Binding Path=DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:VideoOSCalendar}, Converter={converters:EnumToVisibilityConverter MatchValue={x:Static CalendarMode.Month}, MatchedResult=Visible, NotMatchedResult=Collapsed}}" Command="{Binding Path=ToggleDayMonthViewCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:VideoOSCalendar}}">
                      <ContentControl.Content>
                        <MultiBinding Converter="{x:Static controls:VideoOSCalendarInternals.HeaderButtonContentConverter}">
                          <Binding Path="DisplayDate" RelativeSource="{RelativeSource FindAncestor, AncestorType=controls:VideoOSCalendar}" />
                          <Binding Path="Language" RelativeSource="{RelativeSource FindAncestor, AncestorType=controls:VideoOSCalendar}" />
                          <Binding Path="." RelativeSource="{RelativeSource FindAncestor, AncestorType=controls:VideoOSCalendar}" />
                          <Binding Source="MMM" />
                        </MultiBinding>
                      </ContentControl.Content>
                    </controls:VideoOSButtonTransparentSmall>
                    <controls:VideoOSButtonTransparentSmall x:Name="PART_YearHeaderButton" Focusable="False" VerticalAlignment="Center" HorizontalAlignment="Left" Cursor="Hand" Margin="2,0,0,0" MaxWidth="48" CommandParameter="{x:Static CalendarMode.Decade}" Visibility="{Binding Path=DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:VideoOSCalendar}, Converter={converters:EnumToVisibilityConverter MatchValue={x:Static CalendarMode.Month}, MatchedResult=Visible, NotMatchedResult=Collapsed}}" Command="{Binding Path=ToggleDayMonthViewCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:VideoOSCalendar}}">
                      <ContentControl.Content>
                        <MultiBinding Converter="{x:Static controls:VideoOSCalendarInternals.HeaderButtonContentConverter}">
                          <Binding Path="DisplayDate" RelativeSource="{RelativeSource FindAncestor, AncestorType=controls:VideoOSCalendar}" />
                          <Binding Path="Language" RelativeSource="{RelativeSource FindAncestor, AncestorType=controls:VideoOSCalendar}" />
                          <Binding Path="." RelativeSource="{RelativeSource FindAncestor, AncestorType=controls:VideoOSCalendar}" />
                          <Binding Source="yyyy" />
                        </MultiBinding>
                      </ContentControl.Content>
                    </controls:VideoOSButtonTransparentSmall>
                    <controls:VideoOSButtonTransparentSmall x:Name="PART_HeaderButton" Visibility="{Binding Path=DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:VideoOSCalendar}, Converter={converters:EnumToVisibilityConverter MatchValue={x:Static CalendarMode.Month}, MatchedResult=Collapsed, NotMatchedResult=Visible}}" />
                  </StackPanel>
                  <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                    <controls:VideoOSButtonTransparentSmall x:Name="PART_PreviousButton" Content="" Focusable="False" VerticalAlignment="Center" Margin="0,0,2,0" IconSource="{controls:VideoOSIconBuiltInSource Chevron_Left, RtlIcon=Chevron_Right}" />
                    <controls:VideoOSButtonTransparentSmall x:Name="PART_TodayButton" Focusable="False" VerticalAlignment="Center" Cursor="Hand" MaxWidth="72" Content="{x:Static resources:Strings.VideoOSCalendar_ButtonToday}" Command="{Binding Path=SelectTodayCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:VideoOSCalendar}}" />
                    <controls:VideoOSButtonTransparentSmall x:Name="PART_NextButton" Content="" Focusable="False" VerticalAlignment="Center" Margin="2,0,0,0" IconSource="{controls:VideoOSIconBuiltInSource Chevron_Right, RtlIcon=Chevron_Left}" />
                  </StackPanel>
                  <Grid Name="PART_MonthView" Row="2" Column="0" ColumnSpan="3" Visibility="Hidden">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                  </Grid>
                  <Grid Name="PART_YearView" Row="2" Column="0" ColumnSpan="3" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                  </Grid>
                </Grid>
                <ControlTemplate.Triggers>
                  <DataTrigger Value="Month" Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}">
                    <Setter TargetName="PART_MonthView" Property="Visibility" Value="Visible" />
                    <Setter TargetName="PART_YearView" Property="Visibility" Value="Hidden" />
                  </DataTrigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </ResourceDictionary>
          </FrameworkTemplate.Resources>
          <Grid Name="PART_Root" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" DataContext="{x:Null}">
            <Border CornerRadius="2" Padding="{TemplateBinding IsBorderVisible, Converter={converters:BoolToThicknessConverter TrueResult=6,3,6,3, FalseResult=0}}" BorderThickness="{TemplateBinding IsBorderVisible, Converter={converters:BoolToThicknessConverter TrueResult=1, FalseResult=0}}" MinWidth="{TemplateBinding IsBorderVisible, Converter={converters:BoolToDoubleConverter TrueResult=239, FalseResult=224}}" MinHeight="{TemplateBinding IsBorderVisible, Converter={converters:BoolToDoubleConverter TrueResult=239, FalseResult=230}}">
              <Border.BorderBrush>
                <MultiBinding Converter="{converters:BoolToResourceConverter TrueResult={x:Static controls:VideoOSResourceKeysInternal.VideoOSCalendarBorderIdleBrush}, FalseResult={x:Static controls:VideoOSResourceKeysInternal.VideoOSCalendarBorderDisabledBrush}}">
                  <Binding Path="." RelativeSource="{RelativeSource Self}" />
                  <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
                  <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
                </MultiBinding>
              </Border.BorderBrush>
              <CalendarItem Name="PART_CalendarItem" Template="{DynamicResource CalendarItemTemplate}" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>