<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="VideoOS.UI.Common.WPF.DisableAlarm.DisableSetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:VideoOS.UI.Common.WPF.Utils.TimePicker" xmlns:Resources="clr-namespace:VideoOS.UI.Common.WPF.Resources" AutomationProperties.AutomationId="DisableSetupWindow" MinHeight="420" MinWidth="321" MaxWidth="321" ShowInTaskbar="True" SizeToContent="WidthAndHeight" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}" xmlns:disablealarm="clr-namespace:VideoOS.UI.Common.WPF.DisableAlarm" Closing="Window_Closing">
  <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition Height="35" />
    </Grid.RowDefinitions>
    <Grid Margin="12,12,12,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <RadioButton Name="disableForRadioButton" Content="{x:Static Resources:Strings.DisableAlarmsFor}" Grid.Row="0" Margin="0,4,0,0" Checked="disableForRadioButton_Checked" Unchecked="disableForRadioButton_Unchecked" />
      <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="19,8,0,8">
        <TextBox Name="disableForTextBox" Width="125" PreviewTextInput="disableForTextBox_PreviewTextInput" TextChanged="disableForTextBox_TextChanged" />
        <ComboBox Name="disableForComboBox" Width="125" SelectedIndex="0" Margin="5,0,0,0">
          <ComboBoxItem Content="{x:Static Resources:Strings.DisableAlarmsComboBoxItemMinutes}" />
          <ComboBoxItem Content="{x:Static Resources:Strings.DisableAlarmsComboBoxItemHours}" />
          <ComboBoxItem Content="{x:Static Resources:Strings.DisableAlarmsComboBoxItemDays}" />
        </ComboBox>
      </StackPanel>
      <RadioButton Content="{x:Static Resources:Strings.DisableAlarmsUntil}" Grid.Row="2" />
      <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="19,8,0,8">
        <local:TimePickerTime x:Name="disableUntilTimePickerTime" TimeChanged="disableUntilTimePickerTime_TimeChanged" Width="125" />
        <DatePicker Name="disableUntilDatePicker" Width="125" SelectedDateFormat="Long" VerticalAlignment="Stretch" Margin="5,0,0,0" SelectedDateChanged="disableUntilDatePicker_SelectedDateChanged" />
      </StackPanel>
      <TextBlock Text="{x:Static Resources:Strings.DisableAlarmsComment}" Margin="0,0,0,8" VerticalAlignment="Center" Grid.Row="4" />
      <TextBox Name="disableCommentTextBox" Height="82" HorizontalAlignment="Stretch" Margin="0,0,0,12" AcceptsReturn="True" TextWrapping="Wrap" Grid.Row="5" VerticalScrollBarVisibility="Auto" />
      <TextBlock AutomationProperties.AutomationId="DisableAllNewAlarmsDescriptionText" Text="{x:Static Resources:Strings.AllNewAlarmsTriggeredBy}" Margin="4,0,4,12" VerticalAlignment="Center" TextWrapping="Wrap" Grid.Row="6" />
      <Expander AutomationProperties.AutomationId="DisableAlarmsExpanderHeader" IsExpanded="True" Header="{x:Static Resources:Strings.DisableAlarmsExpanderHeader}" Grid.Row="7">
        <ListBox Name="alarmTypeListBox" MinHeight="114" MinWidth="275" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
      </Expander>
    </Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="1">
      <Button Name="okButton" Content="{x:Static Resources:Strings.DisableAlarmsOKButton}" Width="75" IsDefault="True" Click="okButton_Click" />
      <Button Name="cancelButton" Content="{x:Static Resources:Strings.DisableAlarmsCancelButton}" Width="75" IsCancel="True" Margin="12,0,12,0" />
    </StackPanel>
  </Grid>
</Window>