<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls" xmlns:ui="clr-namespace:VideoOS.Platform.UI" xmlns:converters="clr-namespace:VideoOS.Platform.UI.Converters">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/VideoOS.Platform;component/UI/Controls/PasswordBoxes/VideoOSPasswordBoxBase.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Type controls:VideoOSPasswordBoxSmall}" BasedOn="{StaticResource {x:Type controls:VideoOSPasswordBoxBase}}" TargetType="{x:Type controls:VideoOSPasswordBoxSmall}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:VideoOSPasswordBoxSmall}">
          <PasswordBox Name="PART_PasswordBox" MaxLength="{TemplateBinding controls:VideoOSPasswordBoxBase.MaxLength}" HorizontalContentAlignment="{TemplateBinding Control.HorizontalContentAlignment}" CaretBrush="{Binding Foreground, RelativeSource={RelativeSource Self}}" Style="{x:Null}">
            <Control.Foreground>
              <MultiBinding Converter="{x:Static controls:VideoOSPasswordBoxSmallInternals.TextBrushConverter}">
                <Binding Path="." RelativeSource="{RelativeSource Self}" />
                <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
                <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
              </MultiBinding>
            </Control.Foreground>
            <Control.Template>
              <ControlTemplate TargetType="{x:Type PasswordBox}">
                <Border CornerRadius="2" MinHeight="24" BorderThickness="1" SnapsToDevicePixels="True">
                  <Border.BorderBrush>
                    <MultiBinding Converter="{x:Static controls:VideoOSPasswordBoxBaseInternals.OutlineBrushConverter}">
                      <Binding Path="." RelativeSource="{RelativeSource Self}" />
                      <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                      <Binding Path="IsFocused" RelativeSource="{RelativeSource TemplatedParent}" />
                      <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                      <Binding Path="State" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type controls:VideoOSPasswordBoxBase}}" />
                      <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
                    </MultiBinding>
                  </Border.BorderBrush>
                  <Border.Background>
                    <MultiBinding Converter="{x:Static controls:VideoOSPasswordBoxBaseInternals.BackgroundBrushConverter}">
                      <Binding Path="." RelativeSource="{RelativeSource Self}" />
                      <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                      <Binding Path="IsFocused" RelativeSource="{RelativeSource TemplatedParent}" />
                      <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                      <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
                    </MultiBinding>
                  </Border.Background>
                  <Grid Margin="{Binding ElementName=PART_ContentHost, Path=ComputedVerticalScrollBarVisibility, Converter={converters:EnumToThicknessConverter MatchValue={x:Static Visibility.Visible}, MatchedResult=8,0,0,0, NotMatchedResult=12,0}}">
                    <controls:VideoOSScrollViewer x:Name="PART_ContentHost" HorizontalAlignment="Stretch" VerticalAlignment="Center" controls:VideoOSStyleScrollBar.IsContentBorderVisible="False">
                      <FrameworkElement.Tag>
                        <MultiBinding Converter="{converters:BoolToResourceConverter TrueResult={x:Static controls:VideoOSResourceKeysInternal.VideoOSTextBlockOpacityEnabled}, FalseResult={x:Static controls:VideoOSResourceKeysInternal.VideoOSTextBlockOpacityDisabled}}">
                          <Binding Path="." RelativeSource="{RelativeSource Self}" />
                          <Binding Path="IsEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                          <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
                        </MultiBinding>
                      </FrameworkElement.Tag>
                    </controls:VideoOSScrollViewer>
                    <controls:VideoOSTextBlockBodySmall Appearance="LowEmphasis" Cursor="IBeam" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" Margin="2,0,0,0" VerticalAlignment="Center" Text="{Binding Path=PlaceholderText, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:VideoOSPasswordBoxBase}}}" Visibility="{Binding Path=SecurePassword.Length, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:VideoOSPasswordBoxBase}}, Converter={converters:IntToVisibilityConverter MinMatchValue=0, MaxMatchValue=0, MatchedResult=Visible, NotMatchedResult=Collapsed}}" />
                  </Grid>
                </Border>
              </ControlTemplate>
            </Control.Template>
          </PasswordBox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>