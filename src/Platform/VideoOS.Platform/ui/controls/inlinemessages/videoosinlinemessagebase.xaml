<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VideoOS.Platform.UI.Controls" xmlns:ui="clr-namespace:VideoOS.Platform.UI" xmlns:extensions="clr-namespace:VideoOS.Platform.UI.Extensions">
  <Style x:Key="{x:Static controls:VideoOSInlineMessageBase+VideoOSInlineMessageBaseInternals.VideoOSTextBlockInteractiveMediumLinkLabelStyleKey}" TargetType="{x:Type Run}">
    <Setter Property="FontSize" Value="{x:Static controls:VideoOSTextBlockInteractiveMediumInternals.FontSize}" />
    <Setter Property="FontWeight" Value="{x:Static controls:VideoOSTextBlockInteractiveMediumInternals.FontWeight}" />
    <Setter Property="FrameworkContentElement.Cursor" Value="Hand" />
    <Setter Property="Inline.TextDecorations" Value="Underline" />
    <Setter Property="Foreground">
      <Setter.Value>
        <MultiBinding Converter="{x:Static controls:VideoOSInlineMessageBaseInternals.InlineMessageMediumLinkTextForegroundConverter}">
          <Binding Path="." RelativeSource="{RelativeSource Self}" />
          <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
          <Binding Path="IsMouseOver" RelativeSource="{RelativeSource Self}" />
          <Binding Path="(extensions:DependencyObjectAttachedProperties.IsMouseLeftButtonDown)" RelativeSource="{RelativeSource Self}" />
          <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
        </MultiBinding>
      </Setter.Value>
    </Setter>
    <Setter Property="extensions:DependencyObjectAttachedProperties.IsMouseLeftButtonDownAware" Value="True" />
  </Style>
  <Style x:Key="{x:Static controls:VideoOSInlineMessageBase+VideoOSInlineMessageBaseInternals.VideoOSTextBlockInteractiveSmallLinkLabelStyleKey}" TargetType="{x:Type Run}">
    <Setter Property="FontSize" Value="{x:Static controls:VideoOSTextBlockInteractiveSmallInternals.FontSize}" />
    <Setter Property="FontWeight" Value="{x:Static controls:VideoOSTextBlockInteractiveSmallInternals.FontWeight}" />
    <Setter Property="FrameworkContentElement.Cursor" Value="Hand" />
    <Setter Property="Inline.TextDecorations" Value="Underline" />
    <Setter Property="Foreground">
      <Setter.Value>
        <MultiBinding Converter="{x:Static controls:VideoOSInlineMessageBaseInternals.InlineMessageSmallLinkTextForegroundConverter}">
          <Binding Path="." RelativeSource="{RelativeSource Self}" />
          <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
          <Binding Path="IsMouseOver" RelativeSource="{RelativeSource Self}" />
          <Binding Path="(extensions:DependencyObjectAttachedProperties.IsMouseLeftButtonDown)" RelativeSource="{RelativeSource Self}" />
          <Binding Source="{x:Static ui:ThemeManager.Instance}" Path="SelectedTheme" />
        </MultiBinding>
      </Setter.Value>
    </Setter>
    <Setter Property="extensions:DependencyObjectAttachedProperties.IsMouseLeftButtonDownAware" Value="True" />
  </Style>
</ResourceDictionary>